<div
  class="fixed bottom-4 left-4 right-4 z-50 mx-auto max-w-xl rounded-2xl border border-[var(--es-border)] bg-white p-4 shadow-[var(--es-shadow)] sm:left-auto"
  role="dialog"
  aria-label="Consentimento de cookies"
  data-cookie-consent
>
  <p class="text-sm text-[var(--es-muted)]">
    Usamos cookies essenciais e, com seu consentimento, cookies de medição e publicidade.
  </p>
  <p class="mt-2 hidden text-xs text-[var(--es-muted)]" data-cookie-preferences>
    Essenciais: sempre ativos. Medição e publicidade: opcionais. Você pode recusar sem perder acesso às vagas.
  </p>
  <p class="mt-2 hidden text-xs font-semibold text-[var(--danger)]" role="alert" data-cookie-error>
    Não foi possível salvar sua preferência. Tente novamente.
  </p>
  <div class="mt-3 flex flex-wrap gap-2">
    <button type="button" class="es-btn es-btn-primary text-sm" data-cookie-choice="yes">Aceitar</button>
    <button type="button" class="es-btn es-btn-secondary text-sm" data-cookie-choice="no">Recusar</button>
    <button type="button" class="es-btn es-btn-secondary text-sm" aria-expanded="false" data-cookie-preferences-toggle>
      Preferências
    </button>
  </div>
</div>

<script>
  const initializeCookieConsent = () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-cookie-consent]")) {
      const choices = root.querySelectorAll<HTMLButtonElement>("[data-cookie-choice]");
      const preferences = root.querySelector<HTMLElement>("[data-cookie-preferences]");
      const preferencesToggle = root.querySelector<HTMLButtonElement>("[data-cookie-preferences-toggle]");
      const error = root.querySelector<HTMLElement>("[data-cookie-error]");

      preferencesToggle?.addEventListener("click", () => {
        if (!preferences) return;
        const expanded = preferencesToggle.getAttribute("aria-expanded") === "true";
        preferencesToggle.setAttribute("aria-expanded", String(!expanded));
        preferences.classList.toggle("hidden", expanded);
      });

      for (const button of choices) {
        button.addEventListener("click", async () => {
          for (const choice of choices) choice.disabled = true;
          error?.classList.add("hidden");
          try {
            const response = await fetch("/api/consent", {
              method: "POST",
              headers: { "Content-Type": "application/json", Accept: "application/json" },
              body: JSON.stringify({ choice: button.dataset.cookieChoice }),
              credentials: "same-origin"
            });
            if (!response.ok) throw new Error("Falha ao salvar preferência");
            root.remove();
            window.location.reload();
          } catch {
            for (const choice of choices) choice.disabled = false;
            error?.classList.remove("hidden");
          }
        });
      }
    }
  };

  const requestIdle = (window as Partial<Window>).requestIdleCallback;
  if (requestIdle) requestIdle.call(window, initializeCookieConsent);
  else globalThis.setTimeout(initializeCookieConsent, 1);
</script>
