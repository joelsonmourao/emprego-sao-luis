---
import type { BrandAssetKey } from "../lib/brand/constants";
import { getBrandIdentity } from "../lib/brand/identity-service";

interface Props {
  assetKey: BrandAssetKey;
  variant?: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: "lazy" | "eager";
  picture?: boolean;
}

const {
  assetKey,
  variant,
  alt,
  class: className = "h-10 w-auto object-contain",
  width,
  height,
  loading = "lazy",
  picture = false
} = Astro.props;

const identity = await getBrandIdentity();
const asset = identity.assets[assetKey];
const resolvedAlt = alt ?? asset?.altText ?? identity.logoAlt;
const url = asset?.url ?? `/brand/logo-horizontal.webp`;
const webp = variant && asset?.variants[variant] ? asset.variants[variant] : (asset?.variants.medium ?? url);
const png = asset?.variants["medium-png"] ?? asset?.originalUrl ?? url;
const isWebp = webp.endsWith(".webp") || webp.includes("image/webp");
---
{picture && isWebp ? (
  <picture>
    <source srcset={webp} type="image/webp" />
    <img src={png} alt={resolvedAlt} class={className} width={width} height={height} loading={loading} />
  </picture>
) : (
  <img src={url} alt={resolvedAlt} class={className} width={width} height={height} loading={loading} />
)}
