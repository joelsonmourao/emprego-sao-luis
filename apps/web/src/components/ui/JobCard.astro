---
import { formatRelativeDate, formatSalary, formatWorkplace } from "../../lib/job-presenter";
import { BRAND_ASSETS } from "../../lib/brand-assets";

interface Props {
  title: string;
  slug: string;
  company: string;
  city: string;
  state: string;
  workplace: string;
  contract?: string | null;
  neighborhood?: string | null;
  salaryVisible?: boolean;
  salaryMin?: string | null;
  salaryMax?: string | null;
  salaryCurrency?: string;
  salaryPeriod?: string | null;
  publishedAt?: Date | null;
  featured?: boolean;
  sponsored?: boolean;
  logoUrl?: string | null;
  compact?: boolean;
}

const {
  title,
  slug,
  company,
  city,
  state,
  workplace,
  contract,
  neighborhood,
  salaryVisible = false,
  salaryMin,
  salaryMax,
  salaryCurrency = "BRL",
  salaryPeriod,
  publishedAt,
  featured = false,
  sponsored = false,
  logoUrl,
  compact = false
} = Astro.props;

const salary = formatSalary({
  salaryVisible,
  salaryMin: salaryMin ?? null,
  salaryMax: salaryMax ?? null,
  salaryCurrency,
  salaryPeriod: salaryPeriod ?? null
});
const location = [city, state].filter(Boolean).join(" - ");
const avatar = logoUrl?.trim() || BRAND_ASSETS.iconWebp;
---
<article
  class={`group flex h-full flex-col rounded-2xl border border-[#E6E6E6] bg-white p-5 shadow-[0_1px_2px_rgba(16,24,40,0.04)] transition hover:border-[#CFCFCF] hover:shadow-[0_8px_24px_rgba(16,24,40,0.08)] ${compact ? "" : "sm:p-6"}`}
>
  <div class="flex items-start gap-4">
    <img
      src={avatar}
      alt=""
      class="h-12 w-12 shrink-0 rounded-xl border border-[#EEE] bg-white object-contain p-1.5"
      width="48"
      height="48"
      loading="lazy"
    />
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        {featured && <span class="rounded-full bg-[#F3F4F6] px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-[#374151]">Destaque</span>}
        {sponsored && <span class="rounded-full bg-[#FEF3C7] px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-[#92400E]">Patrocinada</span>}
      </div>
      <h3 class="mt-1 text-lg font-bold leading-snug text-[#111827] sm:text-[1.15rem]">
        <a class="hover:text-[var(--brand-primary)]" href={`/vagas/${slug}`}>{title}</a>
      </h3>
      <p class="mt-1 text-sm font-medium text-[#4B5563]">{company}</p>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold text-[#4B5563]">
    {location && <span class="rounded-lg bg-[#F5F5F5] px-2.5 py-1">{location}</span>}
    {neighborhood && <span class="rounded-lg bg-[#F5F5F5] px-2.5 py-1">{neighborhood}</span>}
    <span class="rounded-lg bg-[#F5F5F5] px-2.5 py-1">{formatWorkplace(workplace)}</span>
    {contract && <span class="rounded-lg bg-[#F5F5F5] px-2.5 py-1">{contract}</span>}
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[#6B7280]">
    {salary && <span class="font-bold text-[#15803D]">{salary}</span>}
    {publishedAt && <span>{formatRelativeDate(publishedAt)}</span>}
  </div>

  <div class="mt-auto pt-5">
    <a
      class="inline-flex w-full items-center justify-center rounded-xl border border-[#D1D5DB] bg-white px-4 py-2.5 text-sm font-bold text-[#111827] transition group-hover:border-[var(--brand-primary)] group-hover:text-[var(--brand-primary)]"
      href={`/vagas/${slug}`}
    >
      Ver vaga
    </a>
  </div>
</article>
