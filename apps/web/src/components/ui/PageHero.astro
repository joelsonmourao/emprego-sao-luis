---
interface Props {
  kicker?: string;
  title: string;
  description?: string;
  pattern?: boolean;
  home?: boolean;
}
const { kicker, title, description, pattern = true, home = false } = Astro.props;
---
<section class={`es-section ${pattern ? "hero-pattern" : "bg-[var(--es-cream-dark)]"} ${home ? "es-home-hero" : ""}`}>
  <div class="es-container">
    <div class={pattern ? "text-white" : ""}>
      {kicker && <p class={`es-kicker ${pattern ? "text-white/80" : ""}`}>{kicker}</p>}
      <h1 class="font-display mt-3 max-w-4xl text-4xl font-black leading-tight sm:text-5xl lg:text-6xl">{title}</h1>
      {description && <p class={`mt-4 max-w-2xl text-lg ${pattern ? "text-white/85" : "text-[var(--es-muted)]"}`}>{description}</p>}
    </div>
    <slot />
  </div>
</section>
