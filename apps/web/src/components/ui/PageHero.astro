---
interface Props {
  kicker?: string;
  title: string;
  description?: string;
  pattern?: boolean;
}
const { kicker, title, description, pattern = true } = Astro.props;
---
<section class={`es-section ${pattern ? "hero-pattern text-white" : "bg-[var(--es-cream-dark)]"}`}>
  <div class="es-container">
    {kicker && <p class="es-kicker text-white/80">{kicker}</p>}
    <h1 class="font-display mt-3 max-w-4xl text-4xl font-black leading-tight sm:text-5xl lg:text-6xl">{title}</h1>
    {description && <p class={`mt-4 max-w-2xl text-lg ${pattern ? "text-white/85" : "text-[var(--es-muted)]"}`}>{description}</p>}
    <slot />
  </div>
</section>
