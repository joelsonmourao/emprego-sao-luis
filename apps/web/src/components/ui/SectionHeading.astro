---
interface Props { kicker?: string; title: string; description?: string; actionHref?: string; actionLabel?: string }
const { kicker, title, description, actionHref, actionLabel } = Astro.props;
---
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    {kicker && <p class="es-kicker">{kicker}</p>}
    <h2 class="font-display mt-3 text-[clamp(1.85rem,3vw,2.65rem)] font-black leading-tight tracking-tight text-[var(--es-ink)]">{title}</h2>
    {description && <p class="mt-3 max-w-2xl leading-relaxed text-[var(--es-muted)]">{description}</p>}
  </div>
  {actionHref && actionLabel && <a class="es-btn es-btn-secondary" href={actionHref}>{actionLabel}</a>}
</div>
