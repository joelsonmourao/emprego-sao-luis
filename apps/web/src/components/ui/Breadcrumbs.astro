---
interface Crumb { name: string; url?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav class="text-sm text-[var(--es-muted)]" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span aria-hidden="true">/</span>}
        {item.url ? <a class="hover:text-[var(--brand-primary)]" href={item.url}>{item.name}</a> : <span aria-current="page" class="font-semibold text-[var(--es-ink)]">{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>
