---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  title?: string;
}

const {
  title = "Quadro de vagas temporariamente pausado — Empregos São Luís"
} = Astro.props;

const links = [
  ["Blog", "/blog"],
  ["Notícias", "/noticias"],
  ["Sobre", "/sobre"],
  ["Redação", "/redacao"],
  ["Contato", "/contato"]
] as const;
---
<BaseLayout
  title={title}
  description="O quadro público de vagas está temporariamente pausado. Continue acompanhando notícias, guias e conteúdos institucionais do Empregos São Luís."
  noindex={true}
>
  <section class="es-section">
    <div class="es-container max-w-3xl">
      <p class="es-kicker">Portal editorial</p>
      <h1 class="font-display mt-3 text-4xl font-black sm:text-5xl">Quadro de vagas temporariamente pausado</h1>
      <p class="mt-4 text-lg text-[var(--es-muted)]">
        A área pública de vagas, empresas, cidades e alertas está pausada neste momento.
        O portal segue ativo com conteúdos editoriais e informações institucionais.
      </p>
      <p class="mt-3 text-[var(--text-secondary)]">
        Não há redirecionamento automático: você pode navegar pelos links abaixo enquanto
        a listagem de vagas permanece indisponível.
      </p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {links.map(([label, href]) => (
          <li>
            <a class="es-btn es-btn-secondary w-full justify-center" href={href}>{label}</a>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-sm text-[var(--es-muted)]">
        Dúvidas ou sugestões? Escreva pela página de <a class="font-semibold text-[var(--brand-primary)] underline" href="/contato">contato</a>.
      </p>
    </div>
  </section>
</BaseLayout>
