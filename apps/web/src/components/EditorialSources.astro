---
interface Props {
  citations: readonly string[];
}

const { citations } = Astro.props;
const sources = [...new Set(citations)].flatMap((value) => {
  try {
    const url = new URL(value);
    if (url.protocol !== "https:") return [];
    return [{
      url: url.toString(),
      host: url.hostname.replace(/^www\./, "")
    }];
  } catch {
    return [];
  }
});
---

{sources.length > 0 && (
  <aside class="mt-10 rounded-2xl border border-[var(--brand-border)] bg-[var(--brand-surface)] p-5" aria-labelledby="editorial-sources-title">
    <h2 id="editorial-sources-title" class="font-display text-xl font-black">Referências externas citadas</h2>
    <p class="mt-2 text-sm text-[var(--es-muted)]">
      Estes links aparecem no conteúdo como apoio à verificação. Consulte a página original para conferir data, escopo e eventuais atualizações.
    </p>
    <ol class="mt-4 space-y-2 text-sm">
      {sources.map((source, index) => (
        <li>
          <a class="underline break-all" href={source.url} target="_blank" rel="noopener noreferrer">
            {index + 1}. {source.host}
          </a>
        </li>
      ))}
    </ol>
  </aside>
)}
