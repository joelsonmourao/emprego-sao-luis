---
import type { VisualIdentity } from "../lib/visual-identity";

interface Props { identity: VisualIdentity }
const { identity } = Astro.props;
const year = new Date().getFullYear();
const groups = [
  {
    title: "Portal",
    links: [["Vagas", "/vagas"], ["Empresas", "/empresas"], ["Categorias", "/categorias"], ["Notícias", "/noticias"], ["Alertas", "/alertas"]]
  },
  {
    title: "Institucional",
    links: [["Quem somos", "/quem-somos"], ["Contato", "/contato"], ["Anunciar vaga", "/anunciar-vaga"], ["Área para empresas", "/area-empresas"]]
  },
  {
    title: "Legal",
    links: [["Privacidade", "/privacidade"], ["Cookies", "/cookies"], ["Termos", "/termos"], ["LGPD", "/lgpd"], ["Segurança", "/seguranca-candidatos"]]
  }
] as const;
---
<footer class="border-t border-[var(--es-border)] bg-[var(--es-green)] text-white/90">
  <div class="es-container grid gap-10 py-12 md:grid-cols-[1.3fr_repeat(3,1fr)]">
    <div>
      <p class="font-display text-xl font-black text-white">{identity.siteName}</p>
      <p class="mt-3 max-w-sm text-sm leading-6 text-white/75">{identity.tagline}</p>
      <a class="es-btn es-btn-primary mt-5 text-sm" href="/alertas">Criar alerta gratuito</a>
    </div>
    {groups.map((group) => (
      <div>
        <p class="text-sm font-bold uppercase tracking-wide text-white/60">{group.title}</p>
        <nav class="mt-3 grid gap-2" aria-label={group.title}>
          {group.links.map(([label, href]) => <a class="text-sm hover:text-white" href={href}>{label}</a>)}
        </nav>
      </div>
    ))}
  </div>
  <div class="border-t border-white/10">
    <div class="es-container flex flex-wrap items-center justify-between gap-3 py-4 text-xs text-white/60">
      <p>© {year} {identity.siteName}</p>
      <p>Vagas verificadas · Candidatura sem cadastro obrigatório</p>
    </div>
  </div>
</footer>
