---
import BrandLogo from "./BrandLogo.astro";
import { BRAND_ASSETS } from "../lib/brand-assets";
import { BRAND_ASSET_KEYS } from "../lib/brand/constants";
import type { VisualIdentity } from "../lib/visual-identity";

interface Props { identity: VisualIdentity }
const { identity } = Astro.props;
---
<footer class="border-t border-[var(--brand-border)] bg-[var(--brand-secondary)] text-white">
  <div class="es-container grid gap-8 py-12 md:grid-cols-3">
    <div>
      <BrandLogo assetKey={BRAND_ASSET_KEYS.LOGO_DARK} class="h-10 w-auto max-w-[11rem]" width={176} height={40} />
      <p class="mt-4 text-sm text-white/70">{identity.tagline}</p>
    </div>
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-white/50">Portal</p>
      <ul class="mt-3 grid gap-2 text-sm">
        <li><a class="hover:text-[var(--brand-accent-warm)]" href="/vagas">Vagas</a></li>
        <li><a class="hover:text-[var(--brand-accent-warm)]" href="/empresas">Empresas</a></li>
        <li><a class="hover:text-[var(--brand-accent-warm)]" href="/publicar-vaga">Publicar vaga</a></li>
        <li><a class="hover:text-[var(--brand-accent-warm)]" href="/empresa/login">Área da empresa</a></li>
        <li><a class="hover:text-[var(--brand-accent-warm)]" href="/instagram" data-track="instagram_footer_click">Instagram</a></li>
      </ul>
    </div>
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-white/50">Institucional</p>
      <ul class="mt-3 grid gap-2 text-sm">
        <li><a class="hover:text-[var(--brand-accent-warm)]" href="/sobre">Sobre</a></li>
        <li><a class="hover:text-[var(--brand-accent-warm)]" href="/contato">Contato</a></li>
        <li><a class="hover:text-[var(--brand-accent-warm)]" href="/privacidade">Privacidade</a></li>
        <li><a class="hover:text-[var(--brand-accent-warm)] text-white/60" href="/admin/login">Administração</a></li>
      </ul>
      <p class="mt-6 text-xs text-white/50">© {new Date().getFullYear()} {identity.siteName || BRAND_ASSETS.siteName}</p>
    </div>
  </div>
</footer>
