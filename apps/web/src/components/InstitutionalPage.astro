---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "./ui/Breadcrumbs.astro";
import { getInstitutionalPage } from "../lib/site-pages";

interface Props {
  slug: Parameters<typeof getInstitutionalPage>[0];
  showContactForm?: boolean;
}

const { slug, showContactForm = slug === "contato" } = Astro.props;
const page = await getInstitutionalPage(slug);
const sent = Astro.url.searchParams.get("sent") === "1";
const error = Astro.url.searchParams.get("error");
---
<BaseLayout title={page.seoTitle} description={page.metaDescription} canonical={page.canonicalPath} breadcrumbs={[{ name: page.title, url: page.canonicalPath }]}>
  <section class="es-section">
    <div class="es-container max-w-4xl">
      <Breadcrumbs items={[{ name: "Início", url: "/" }, { name: page.title }]} />
      <p class="es-kicker mt-6">Institucional</p>
      <h1 class="font-display mt-2 text-4xl font-black sm:text-5xl">{page.title}</h1>
      <div class="es-prose mt-8 rounded-3xl border border-[var(--es-border)] bg-white p-6 sm:p-8" set:html={page.contentHtml} />
      {showContactForm && (
        <section class="es-card mt-8 p-6 sm:p-8">
          <h2 class="font-display text-2xl font-black">Envie sua mensagem</h2>
          {sent && <p class="mt-3 rounded-xl border border-green-200 bg-green-50 p-3 text-green-900">Mensagem registrada. Responderemos quando possível.</p>}
          {error && <p class="mt-3 rounded-xl border border-red-200 bg-red-50 p-3 text-red-900">{error}</p>}
          <form class="mt-5 grid gap-4" method="post" action="/api/contato">
            <label class="grid gap-1 text-sm font-semibold">Nome<input class="rounded-xl border border-[var(--es-border)] px-3 py-2.5" name="name" required maxlength="120" /></label>
            <label class="grid gap-1 text-sm font-semibold">E-mail<input class="rounded-xl border border-[var(--es-border)] px-3 py-2.5" type="email" name="email" required maxlength="180" /></label>
            <label class="grid gap-1 text-sm font-semibold">Assunto<input class="rounded-xl border border-[var(--es-border)] px-3 py-2.5" name="subject" required maxlength="160" /></label>
            <label class="grid gap-1 text-sm font-semibold">Mensagem<textarea class="min-h-32 rounded-xl border border-[var(--es-border)] px-3 py-2.5" name="message" required maxlength="4000"></textarea></label>
            <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="consent" value="1" required /><span>Autorizo o tratamento dos dados para responder este contato, conforme a política de privacidade.</span></label>
            <button class="es-btn es-btn-primary" type="submit">Enviar</button>
          </form>
        </section>
      )}
    </div>
  </section>
</BaseLayout>
