---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Empregos São Luís — Vagas no Maranhão">
  <section class="mx-auto max-w-6xl px-4 py-20">
    <p class="font-bold uppercase tracking-wide text-red-700">Empregos São Luís</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-black sm:text-6xl">Oportunidades verificadas perto de você</h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-700">Nova plataforma em construção segura e paralela ao portal atual.</p>
    <a class="mt-8 inline-flex rounded-xl bg-red-700 px-5 py-3 font-bold text-white" href="/vagas">Ver vagas</a>
  </section>
</BaseLayout>
