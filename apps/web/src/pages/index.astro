---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import JobCard from "../components/ui/JobCard.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import InstagramFollow from "../components/InstagramFollow.astro";
import { categories, cities, companies, createPublicDatabase, jobs, states } from "@es/db";
import { and, count, desc, eq, gt, gte, lt, sql } from "drizzle-orm";
import { articlePublicPath, listPublishedArticles } from "../lib/articles";
import { listAutoEditorialArticles, findAutoEditorialArticle } from "../lib/auto-editorial";
import { isEditorialReviewPending } from "../data/editorial-review-pending";
import { getEditorialContentOverride } from "../data/editorial-content-overrides";
import { getNewsEditorialOverride } from "../data/news-editorial-content-overrides";
import { getEditorialPortalMode } from "../lib/portal-modes";
import { getVisualIdentity } from "../lib/visual-identity";

type JobRow = {
  id: string; title: string; slug: string; code: string; company: string; city: string; state: string;
  workplace: string; contract: string; publishedAt: Date | null; featured: boolean; sponsored: boolean;
  logoUrl: string | null; salaryVisible: boolean; salaryMin: string | null; salaryMax: string | null;
  salaryCurrency: string; salaryPeriod: string | null;
};

const portal = await getEditorialPortalMode();
const portalEditorial = portal.enabled;

let recent: JobRow[] = [];
let featured: JobRow[] = [];
let categoryRows: Array<{ name: string; slug: string; total: number }> = [];
let cityRows: Array<{ name: string; slug: string; state: string; total: number }> = [];
let companyRows: Array<{ name: string; slug: string; total: number; logoUrl: string | null }> = [];
let categoryOptions: Array<{ name: string; slug: string }> = [];
let publishedToday = 0;

const identity = await getVisualIdentity();

if (!portalEditorial && process.env.DATABASE_URL) {
  const connection = createPublicDatabase(process.env.DATABASE_URL);
  try {
    const active = and(eq(jobs.publicationStatus, "PUBLISHED"), gt(jobs.expiresAt, new Date()));
    const fields = {
      id: jobs.id, title: jobs.normalizedTitle, slug: jobs.slug, code: jobs.publicCode,
      company: sql<string>`case when ${jobs.confidentialCompany} then 'Empresa confidencial' else coalesce(${companies.publicName}, ${companies.name}) end`,
      city: cities.name, state: states.code, workplace: jobs.workplaceType, contract: jobs.employmentType,
      publishedAt: jobs.publishedAt, featured: jobs.featured, sponsored: jobs.sponsored,
      logoUrl: sql<string | null>`case when ${jobs.confidentialCompany} then null else ${companies.logoUrl} end`,
      salaryVisible: jobs.salaryVisible, salaryMin: jobs.salaryMin, salaryMax: jobs.salaryMax,
      salaryCurrency: jobs.salaryCurrency, salaryPeriod: jobs.salaryPeriod
    };
    const todayStart = sql<Date>`date_trunc('day', now() at time zone 'America/Sao_Paulo') at time zone 'America/Sao_Paulo'`;
    const todayEnd = sql<Date>`${todayStart} + interval '1 day'`;
    const [todayRow] = await connection.db
      .select({ total: count(jobs.id) })
      .from(jobs)
      .where(and(active, gte(jobs.publishedAt, todayStart), lt(jobs.publishedAt, todayEnd)));
    publishedToday = Number(todayRow?.total ?? 0);

    [recent, featured, categoryRows, cityRows, companyRows, categoryOptions] = await Promise.all([
      connection.db.select(fields).from(jobs).innerJoin(companies, eq(jobs.companyId, companies.id)).innerJoin(cities, eq(jobs.cityId, cities.id)).innerJoin(states, eq(jobs.stateId, states.id)).where(active).orderBy(desc(jobs.publishedAt)).limit(9),
      connection.db.select(fields).from(jobs).innerJoin(companies, eq(jobs.companyId, companies.id)).innerJoin(cities, eq(jobs.cityId, cities.id)).innerJoin(states, eq(jobs.stateId, states.id)).where(and(active, eq(jobs.featured, true))).orderBy(desc(jobs.publishedAt)).limit(6),
      connection.db.select({ name: categories.name, slug: categories.slug, total: count(jobs.id) }).from(categories).innerJoin(jobs, eq(jobs.categoryId, categories.id)).where(active).groupBy(categories.id).orderBy(desc(count(jobs.id))).limit(8),
      connection.db.select({ name: cities.name, slug: cities.slug, state: states.code, total: count(jobs.id) }).from(cities).innerJoin(states, eq(cities.stateId, states.id)).innerJoin(jobs, eq(jobs.cityId, cities.id)).where(active).groupBy(cities.id, states.code).orderBy(desc(count(jobs.id))).limit(8),
      connection.db.select({ name: sql<string>`coalesce(${companies.publicName}, ${companies.name})`, slug: companies.slug, total: count(jobs.id), logoUrl: companies.logoUrl }).from(companies).innerJoin(jobs, eq(jobs.companyId, companies.id)).where(and(active, eq(jobs.confidentialCompany, false))).groupBy(companies.id).orderBy(desc(count(jobs.id))).limit(6),
      connection.db.select({ name: categories.name, slug: categories.slug }).from(categories).where(eq(categories.active, true)).orderBy(categories.name).limit(30)
    ]);
  } finally {
    await connection.close();
  }
}

// Não esconder notícias só porque os últimos artigos publicados são guias.
// Consultas independentes, em paralelo, trazem até quatro itens reais de cada tipo.
const [newsArticles, publishedGuides] = await Promise.all([
  listPublishedArticles(6, undefined, "NEWS"),
  listPublishedArticles(24, undefined, ["GUIDE", "DATA_REPORT"])
]);
const autoGuides = listAutoEditorialArticles(4)
  .map((item) => findAutoEditorialArticle(item.slug))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
const blogArticles = [...autoGuides, ...publishedGuides.filter((item) =>
  !autoGuides.some((auto) => auto.article.slug === item.article.slug)
)].filter((item) =>
  !isEditorialReviewPending(item.article.type, item.article.slug) ||
  Boolean(getEditorialContentOverride(item.article.slug))
).sort((a,b) => (b.article.publishedAt?.getTime() || 0) - (a.article.publishedAt?.getTime() || 0)).slice(0,4);
const verifiedNewsArticles = newsArticles.filter((item) =>
  !isEditorialReviewPending("NEWS", item.article.slug) ||
  Boolean(getNewsEditorialOverride(item.article.slug))
).slice(0,4);
const displayFeatured = featured.length ? featured : recent.slice(0, 3);
const quickFilters = [
  ["Vagas SLZ", "/vagas-slz"],
  ["São Luís", "/vagas/cidade/sao-luis"],
  ["Presencial", "/vagas?modalidade=presencial"],
  ["Remoto", "/vagas?modalidade=remoto"],
  ["Auxiliar", "/vagas?q=auxiliar"],
  ["Vendedor", "/vagas?q=vendedor"]
];
const steps = [
  ["Busque", "Pesquise por cargo, cidade, categoria ou modalidade."],
  ["Compare", "Veja empresa, local, contrato e fonte da vaga."],
  ["Candidate-se", "Acesse o link oficial sem cadastro obrigatório."]
];
const homeTitle = portalEditorial
  ? "Empregos São Luís — Notícias, guias e redação"
  : "Empregos São Luís — Vagas SLZ e empregos em São Luís";
const homeDescription = portalEditorial
  ? "Portal editorial do Empregos São Luís com notícias do mercado de trabalho, guias para candidatos e informações institucionais em São Luís e no Maranhão."
  : "Vagas SLZ e empregos SLZ em São Luís e no Maranhão. Encontre oportunidades atualizadas na capital maranhense.";
---
<BaseLayout title={homeTitle} description={homeDescription}>
  {portalEditorial ? (
    <>
      <section class="es-magazine-cover" aria-labelledby="editorial-hero-title">
        <div class="es-container">
          <div class="es-magazine-edition">
            <span class="es-magazine-edition-tag"><span aria-hidden="true">●</span> EMPREGOS SÃO LUÍS</span>
            <span>Carreira • Informação • Maranhão</span>
            <a href="/redacao">Compromisso editorial <span aria-hidden="true">↗</span></a>
          </div>
          <div class="es-magazine-cover-grid">
            <div class="es-magazine-intro">
              <p class="es-magazine-overline">UM PORTAL PARA IR MAIS LONGE</p>
              <h1 id="editorial-hero-title" class="font-display es-magazine-headline">
                Sua carreira merece <em>boas histórias.</em> E boas decisões.
              </h1>
              <p class="es-magazine-standfirst">Notícias, orientações práticas e ferramentas para quem busca oportunidades e quer se preparar melhor em São Luís e no Maranhão.</p>
              <div class="es-magazine-actions">
                <a class="es-magazine-action-main" href="/blog">Explorar guias <span aria-hidden="true">↗</span></a>
                <a class="es-magazine-action-text" href="/noticias">Ler notícias <span aria-hidden="true">→</span></a>
              </div>
              <div class="es-magazine-quicklinks" aria-label="Assuntos em destaque">
                <span>Comece por:</span>
                <a href="/blog?tema=curriculo">Currículo</a>
                <a href="/blog?tema=entrevista">Entrevistas</a>
                <a href="/blog?tema=primeiro-emprego">Primeiro emprego</a>
              </div>
            </div>
            <div class="es-magazine-cover-art">
              {blogArticles[0]?.article.coverImageUrl ? (
                <a class="es-magazine-cover-image" href={articlePublicPath(blogArticles[0].article.type, blogArticles[0].article.slug)}>
                  <img src={blogArticles[0].article.coverImageUrl} alt={blogArticles[0].article.coverImageAlt ?? blogArticles[0].article.title} width="880" height="660" loading="eager" decoding="async" fetchpriority="high" />
                  <span class="es-magazine-image-caption">
                    <span class="es-magazine-image-eyebrow">LEITURA EM DESTAQUE</span>
                    <strong class="font-display">{blogArticles[0].article.title}</strong>
                    <span>Explorar conteúdo <span aria-hidden="true">↗</span></span>
                  </span>
                </a>
              ) : (
                <div class="es-magazine-cover-fallback">
                  <span>ES / Editorial</span>
                  <strong class="font-display">Informação que abre caminhos.</strong>
                  <a href="/blog">Descubra nossos guias <span aria-hidden="true">↗</span></a>
                </div>
              )}
              <div class="es-magazine-cover-counter">
                <span class="es-magazine-counter-mark">ES.</span>
                <span>Informação local.<strong>Decisões melhores.</strong></span>
              </div>
            </div>
          </div>
          <div class="es-magazine-bottom-line">
            <span>CONTEÚDO DE CARREIRA, SEM PROMESSAS FÁCEIS</span>
            <span class="es-magazine-bottom-rule"></span>
            <a href="/sobre">Conheça o portal <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      {verifiedNewsArticles.length > 0 && (
        <section class="es-magazine-news es-section" aria-labelledby="magazine-news-heading">
          <div class="es-container">
            <div class="es-magazine-section-header">
              <div>
                <p class="es-magazine-section-kicker">01 / REDAÇÃO</p>
                <h2 id="magazine-news-heading" class="font-display">No radar <em>do trabalho.</em></h2>
                <p>Notícias e explicações sobre o mercado e o dia a dia profissional.</p>
              </div>
              <a class="es-magazine-all-link" href="/noticias">Todas as notícias <span aria-hidden="true">↗</span></a>
            </div>
            <div class="es-magazine-news-grid">
              <article class="es-magazine-news-feature">
                <a href={articlePublicPath(verifiedNewsArticles[0].article.type, verifiedNewsArticles[0].article.slug)}>
                  {verifiedNewsArticles[0].article.coverImageUrl ? (
                    <img src={verifiedNewsArticles[0].article.coverImageUrl} alt={verifiedNewsArticles[0].article.coverImageAlt ?? verifiedNewsArticles[0].article.title} width="850" height="510" loading="lazy" decoding="async" />
                  ) : <div class="es-magazine-news-placeholder" aria-hidden="true">ES / NOTÍCIAS</div>}
                  <div class="es-magazine-news-feature-content">
                    <p>NOTÍCIA EM DESTAQUE</p>
                    <h3 class="font-display">{verifiedNewsArticles[0].article.title}</h3>
                    {verifiedNewsArticles[0].article.excerpt && <span>{verifiedNewsArticles[0].article.excerpt}</span>}
                    <strong>Leia a matéria <span aria-hidden="true">↗</span></strong>
                  </div>
                </a>
              </article>
              <div class="es-magazine-news-list">
                {verifiedNewsArticles.slice(1).map(({ article }, index) => (
                  <article class="es-magazine-news-row">
                    <a href={articlePublicPath(article.type, article.slug)}>
                      <span class="es-magazine-news-order">0{index + 2}</span>
                      <span class="es-magazine-news-row-copy">
                        <span>REDAÇÃO / NOTÍCIAS</span>
                        <strong class="font-display">{article.title}</strong>
                        {article.excerpt && <small>{article.excerpt}</small>}
                      </span>
                      <span class="es-magazine-row-arrow" aria-hidden="true">↗</span>
                    </a>
                  </article>
                ))}
                <a class="es-magazine-news-extra" href="/redacao">
                  <span>Como verificamos as informações</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>
        </section>
      )}

      <section class="es-magazine-toolband" aria-labelledby="magazine-tool-heading">
        <div class="es-container es-magazine-toolband-grid">
          <div class="es-magazine-toolband-intro">
            <p>02 / FERRAMENTA GRATUITA</p>
            <h2 id="magazine-tool-heading" class="font-display">A próxima candidatura começa com <em>organização.</em></h2>
          </div>
          <div class="es-magazine-toolband-action">
            <p>Registre vagas, datas e etapas do processo seletivo. Baixe uma planilha CSV sem cadastro e sem enviar seus dados ao portal.</p>
            <a href="/ferramentas/controle-candidaturas">Organizar candidaturas <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <div class="es-container py-5"><AdSlot slot="home-top" pageType="home" /></div>

      {blogArticles.length > 0 && (
        <section class="es-magazine-guides es-section" aria-labelledby="magazine-guides-heading">
          <div class="es-container">
            <div class="es-magazine-section-header">
              <div>
                <p class="es-magazine-section-kicker">03 / CONHECIMENTO PRÁTICO</p>
                <h2 id="magazine-guides-heading" class="font-display">Leituras para <em>avançar.</em></h2>
                <p>Escolha um tema e coloque as orientações em prática.</p>
              </div>
              <a class="es-magazine-all-link" href="/blog">Biblioteca de guias <span aria-hidden="true">↗</span></a>
            </div>
            <div class="es-magazine-guides-grid">
              <article class="es-magazine-guide-lead">
                <a href={articlePublicPath(blogArticles[0].article.type, blogArticles[0].article.slug)}>
                  {blogArticles[0].article.coverImageUrl && <img src={blogArticles[0].article.coverImageUrl} alt={blogArticles[0].article.coverImageAlt ?? blogArticles[0].article.title} width="800" height="500" loading="lazy" decoding="async" />}
                  <div>
                    <span class="es-magazine-guide-type">GUIA EM DESTAQUE</span>
                    <h3 class="font-display">{blogArticles[0].article.title}</h3>
                    {blogArticles[0].article.excerpt && <p>{blogArticles[0].article.excerpt}</p>}
                    <strong>Ler o guia <span aria-hidden="true">↗</span></strong>
                  </div>
                </a>
              </article>
              <div class="es-magazine-guides-side">
                {blogArticles.slice(1).map(({ article }, index) => (
                  <article class="es-magazine-guide-small">
                    <a href={articlePublicPath(article.type, article.slug)}>
                      {article.coverImageUrl ? <img src={article.coverImageUrl} alt={article.coverImageAlt ?? article.title} width="168" height="138" loading="lazy" decoding="async" /> : <div class="es-magazine-guide-placeholder" aria-hidden="true">ES</div>}
                      <div>
                        <span>LEITURA 0{index + 2}</span>
                        <h3 class="font-display">{article.title}</h3>
                        <strong>Ver conteúdo <span aria-hidden="true">↗</span></strong>
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </section>
      )}

      <section class="es-magazine-categories es-section" aria-labelledby="magazine-categories-heading">
        <div class="es-container">
          <div class="es-magazine-section-header">
            <div>
              <p class="es-magazine-section-kicker">04 / ASSUNTOS</p>
              <h2 id="magazine-categories-heading" class="font-display">Seu caminho, <em>seu assunto.</em></h2>
              <p>Acesse diretamente os temas que fazem sentido para o seu momento.</p>
            </div>
          </div>
          <div class="es-magazine-topic-grid">
            <a href="/blog?tema=mercado"><span>01</span><strong class="font-display">Mercado de trabalho</strong><small>Entenda o cenário profissional</small><span aria-hidden="true">↗</span></a>
            <a href="/blog?tema=curriculo"><span>02</span><strong class="font-display">Currículo</strong><small>Organize suas experiências</small><span aria-hidden="true">↗</span></a>
            <a href="/blog?tema=entrevista"><span>03</span><strong class="font-display">Entrevistas</strong><small>Prepare seus exemplos</small><span aria-hidden="true">↗</span></a>
            <a href="/blog?tema=primeiro-emprego"><span>04</span><strong class="font-display">Primeiro emprego</strong><small>Comece com segurança</small><span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="es-magazine-resource es-section" aria-labelledby="magazine-resource-heading">
        <div class="es-container es-magazine-resource-grid">
          <div>
            <p class="es-magazine-section-kicker">05 / SERVIÇO PÚBLICO</p>
            <h2 id="magazine-resource-heading" class="font-display">Buscando vagas pelo SINE no Maranhão?</h2>
            <p>Veja como consultar os canais oficiais, conferir o atendimento e organizar sua documentação antes da candidatura.</p>
            <a href="/guias/emprego-sine-maranhao">Acessar guia completo <span aria-hidden="true">↗</span></a>
          </div>
          <aside class="es-magazine-resource-aside">
            <span>CONFIANÇA IMPORTA</span>
            <strong class="font-display">Informação útil. Fonte identificada. Sem promessas de contratação.</strong>
            <a href="/seguranca-candidatos">Segurança do candidato <span aria-hidden="true">↗</span></a>
          </aside>
        </div>
      </section>

      <section class="es-magazine-about" aria-label="Conheça o portal">
        <div class="es-container es-magazine-about-inner">
          <p><strong>Mais do que manchetes.</strong> Uma redação comprometida com orientação clara e verificável.</p>
          <nav aria-label="Informações sobre o portal">
            <a href="/sobre">Quem somos</a>
            <a href="/redacao">Nossa redação</a>
            <a href="/politica-fontes">Nossas fontes</a>
          </nav>
        </div>
      </section>
      <InstagramFollow />
    </>
  ) : (
    <>
  <PageHero
    kicker={identity.siteName}
    title="Encontre oportunidades em São Luís e no Maranhão"
    description="Busque vagas por cargo, cidade e modalidade, explore notícias e encontre orientações confiáveis para sua carreira."
    home
  >
    <form class="hero-search-panel mt-8 rounded-3xl border p-4 shadow-2xl sm:p-5" action="/vagas" method="get" role="search">
      <div class="grid gap-3 lg:grid-cols-4">
        <label class="grid gap-1 text-sm font-semibold lg:col-span-2">
          <span>Cargo ou palavra-chave</span>
          <input class="rounded-xl border border-[var(--es-border)] px-4 py-3" name="q" placeholder="Ex.: auxiliar administrativo" />
        </label>
        <label class="grid gap-1 text-sm font-semibold">
          <span>Cidade</span>
          <input class="rounded-xl border border-[var(--es-border)] px-4 py-3" name="cidade" placeholder="Ex.: São Luís" />
        </label>
        <label class="grid gap-1 text-sm font-semibold">
          <span>Modalidade</span>
          <select class="rounded-xl border border-[var(--es-border)] px-4 py-3" name="modalidade">
            <option value="">Qualquer</option>
            <option value="presencial">Presencial</option>
            <option value="hibrido">Híbrido</option>
            <option value="remoto">Remoto</option>
          </select>
        </label>
        <label class="grid gap-1 text-sm font-semibold lg:col-span-2">
          <span>Categoria</span>
          <select class="rounded-xl border border-[var(--es-border)] px-4 py-3" name="categoria">
            <option value="">Todas</option>
            {categoryOptions.map((item) => <option value={item.slug}>{item.name}</option>)}
          </select>
        </label>
        <div class="flex items-end lg:col-span-2">
          <button class="es-btn es-btn-primary w-full py-3.5 text-base" type="submit">Buscar vagas</button>
        </div>
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="hero-search-meta text-xs font-bold uppercase tracking-wide">Populares:</span>
        {quickFilters.map(([label, href]) => <a class="chip hover:border-[var(--brand-primary)] hover:text-[var(--brand-primary)]" href={href}>{label}</a>)}
      </div>
    </form>
    {publishedToday > 0 && (
      <p class="mt-4 text-sm font-semibold text-white/90" aria-live="polite">
        <strong>{publishedToday}</strong> {publishedToday === 1 ? "vaga publicada hoje" : "vagas publicadas hoje"}
      </p>
    )}
  </PageHero>

  <div class="es-container py-6"><AdSlot slot="home-top" pageType="home" /></div>

  <section class="es-section pt-0">
    <div class="es-container">
      <SectionHeading kicker="Oportunidades" title={featured.length ? "Vagas em destaque" : "Vagas mais recentes"} actionHref="/vagas" actionLabel="Ver todas" />
      {displayFeatured.length ? (
        <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {displayFeatured.map((job) => <JobCard {...job} />)}
        </div>
      ) : (
        <div class="mt-8">
          <EmptyState title="Novas vagas em breve" description="Ainda não há vagas publicadas agora, mas você pode criar um alerta gratuito e explorar categorias e cidades abaixo." actionHref="/alertas" actionLabel="Criar alerta" secondaryHref="/vagas" secondaryLabel="Explorar busca" />
        </div>
      )}
    </div>
  </section>

  {recent.length > displayFeatured.length && (
    <section class="es-section bg-white">
      <div class="es-container">
        <SectionHeading title="Publicadas recentemente" />
        <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {recent.filter((job) => !displayFeatured.some((item) => item.id === job.id)).slice(0, 6).map((job) => <JobCard {...job} compact />)}
        </div>
      </div>
    </section>
  )}

  {newsArticles.length > 0 && (
    <section class="es-section">
      <div class="es-container">
        <SectionHeading kicker="Notícias" title="Atualizações do mercado de trabalho" actionHref="/noticias" actionLabel="Ver notícias" />
        <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {newsArticles.map(({ article }) => (
            <article class="es-card p-5">
              <p class="text-xs font-bold text-[var(--brand-primary)]">Notícia</p>
              <h3 class="font-display mt-1 text-lg font-black">
                <a href={articlePublicPath(article.type, article.slug)}>{article.title}</a>
              </h3>
              {article.excerpt && <p class="mt-2 text-sm text-[var(--es-muted)] line-clamp-3">{article.excerpt}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {blogArticles.length > 0 && (
    <section class="es-section bg-white">
      <div class="es-container">
        <SectionHeading kicker="Blog" title="Guias para se candidatar melhor" actionHref="/blog" actionLabel="Ver blog" />
        <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {blogArticles.map(({ article }) => (
            <article class="es-card p-5">
              <p class="text-xs font-bold text-[var(--brand-primary)]">{article.type === "DATA_REPORT" ? "Relatório" : "Guia"}</p>
              <h3 class="font-display mt-1 text-lg font-black">
                <a href={articlePublicPath(article.type, article.slug)}>{article.title}</a>
              </h3>
              {article.excerpt && <p class="mt-2 text-sm text-[var(--es-muted)] line-clamp-3">{article.excerpt}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="es-container"><AdSlot slot="home-between-sections" pageType="home" /></div>

  <section class="es-section bg-[var(--es-cream-dark)]">
    <div class="es-container grid gap-10 lg:grid-cols-2">
      {categoryRows.length > 0 && (
        <div>
          <SectionHeading kicker="Áreas" title="Categorias mais procuradas" />
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {categoryRows.map((item) => (
              <a class="es-card block p-4 hover:border-[var(--brand-primary)]" href={`/vagas/categoria/${item.slug}`}>
                <span class="font-display font-black">{item.name}</span>
                <span class="mt-1 block text-sm text-[var(--es-muted)]">{item.total} vaga(s)</span>
              </a>
            ))}
          </div>
        </div>
      )}
      {cityRows.length > 0 && (
        <div>
          <SectionHeading kicker="Local" title="Vagas por cidade" />
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {cityRows.map((item) => (
              <a class="es-card block p-4 hover:border-[var(--brand-primary)]" href={`/vagas/cidade/${item.slug}`}>
                <span class="font-display font-black">{item.name}/{item.state}</span>
                <span class="mt-1 block text-sm text-[var(--es-muted)]">{item.total} vaga(s)</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  {companyRows.length > 0 && (
    <section class="es-section">
      <div class="es-container">
        <SectionHeading kicker="Empresas" title="Empresas com vagas abertas" actionHref="/empresas" actionLabel="Ver todas" />
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {companyRows.map((company) => (
            <a class="es-card flex items-center gap-4 p-5" href={`/empresas/${company.slug}`}>
              {company.logoUrl ? <img src={company.logoUrl} alt="" class="h-12 w-12 rounded-xl border object-contain p-1" width="48" height="48" loading="lazy" /> : <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--es-cream-dark)] font-black text-[var(--brand-primary)]">{company.name.slice(0, 1)}</div>}
              <div>
                <p class="font-display font-black">{company.name}</p>
                <p class="text-sm text-[var(--es-muted)]">{company.total} vaga(s)</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="es-section bg-white">
    <div class="es-container">
      <SectionHeading kicker="Como funciona" title="Simples para quem busca emprego" description="Sem cobrança do candidato e com fonte identificada em cada publicação." />
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {steps.map(([title, text], index) => (
          <article class="es-card p-6">
            <p class="text-sm font-black text-[var(--brand-primary)]">0{index + 1}</p>
            <h3 class="font-display mt-2 text-xl font-black">{title}</h3>
            <p class="mt-2 text-sm text-[var(--es-muted)]">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <InstagramFollow />

  <section class="hero-pattern es-section text-white">
    <div class="es-container flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <p class="es-kicker text-white/70">Alertas</p>
        <h2 class="font-display mt-2 text-3xl font-black sm:text-4xl">Receba vagas compatíveis com você</h2>
        <p class="mt-3 max-w-xl text-white/80">Escolha cidade, área e frequência. Gratuito e cancelável a qualquer momento.</p>
      </div>
      <a class="es-btn bg-white text-[var(--brand-primary)] hover:bg-[var(--brand-background)]" href="/alertas">Criar alerta gratuito</a>
    </div>
  </section>

  <section class="es-section">
    <div class="es-container grid gap-5 lg:grid-cols-2">
      <article class="es-card p-6 sm:p-8">
        <p class="es-kicker">Empresas</p>
        <h2 class="font-display mt-2 text-2xl font-black">Divulgue vagas com transparência</h2>
        <p class="mt-3 text-[var(--text-secondary)]">Alcance candidatos locais com fonte identificada e página dedicada da empresa.</p>
        <a class="es-btn es-btn-primary mt-5" href="/publicar-vaga">Publicar vaga</a>
      </article>
      <article class="es-card p-6 sm:p-8">
        <p class="es-kicker">Segurança</p>
        <h2 class="font-display mt-2 text-2xl font-black">Candidatura segura</h2>
        <p class="mt-3 text-[var(--es-muted)]">Desconfie de cobranças e links suspeitos. Veja orientações para se proteger.</p>
        <a class="es-btn es-btn-secondary mt-5" href="/seguranca-candidatos">Ler orientações</a>
      </article>
    </div>
  </section>
    </>
  )}
</BaseLayout>
