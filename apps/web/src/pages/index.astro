---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import JobCard from "../components/ui/JobCard.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import InstagramFollow from "../components/InstagramFollow.astro";
import { categories, cities, companies, createDatabase, jobs, states } from "@es/db";
import { and, count, desc, eq, gt, sql } from "drizzle-orm";
import { articlePublicPath, listPublishedArticles } from "../lib/articles";
import { getVisualIdentity } from "../lib/visual-identity";
import { getAdsenseReviewMode } from "../lib/adsense-review-mode";
import { getEditorialAuditReport } from "../lib/editorial-audit";

type JobRow = {
  id: string; title: string; slug: string; code: string; company: string; city: string; state: string;
  workplace: string; contract: string; publishedAt: Date | null; featured: boolean; sponsored: boolean;
  logoUrl: string | null; salaryVisible: boolean; salaryMin: string | null; salaryMax: string | null;
  salaryCurrency: string; salaryPeriod: string | null;
};

let recent: JobRow[] = [];
let featured: JobRow[] = [];
let categoryRows: Array<{ name: string; slug: string; total: number }> = [];
let cityRows: Array<{ name: string; slug: string; state: string; total: number }> = [];
let companyRows: Array<{ name: string; slug: string; total: number; logoUrl: string | null }> = [];
let categoryOptions: Array<{ name: string; slug: string }> = [];

const identity = await getVisualIdentity();
const reviewMode = await getAdsenseReviewMode();

if (process.env.DATABASE_URL && !reviewMode.enabled) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    const active = and(eq(jobs.publicationStatus, "PUBLISHED"), gt(jobs.expiresAt, new Date()));
    const fields = {
      id: jobs.id, title: jobs.normalizedTitle, slug: jobs.slug, code: jobs.publicCode,
      company: sql<string>`case when ${jobs.confidentialCompany} then 'Empresa confidencial' else coalesce(${companies.publicName}, ${companies.name}) end`,
      city: cities.name, state: states.code, workplace: jobs.workplaceType, contract: jobs.employmentType,
      publishedAt: jobs.publishedAt, featured: jobs.featured, sponsored: jobs.sponsored,
      logoUrl: sql<string | null>`case when ${jobs.confidentialCompany} then null else ${companies.logoUrl} end`,
      salaryVisible: jobs.salaryVisible, salaryMin: jobs.salaryMin, salaryMax: jobs.salaryMax,
      salaryCurrency: jobs.salaryCurrency, salaryPeriod: jobs.salaryPeriod
    };
    [recent, featured, categoryRows, cityRows, companyRows, categoryOptions] = await Promise.all([
      connection.db.select(fields).from(jobs).innerJoin(companies, eq(jobs.companyId, companies.id)).innerJoin(cities, eq(jobs.cityId, cities.id)).innerJoin(states, eq(jobs.stateId, states.id)).where(active).orderBy(desc(jobs.publishedAt)).limit(9),
      connection.db.select(fields).from(jobs).innerJoin(companies, eq(jobs.companyId, companies.id)).innerJoin(cities, eq(jobs.cityId, cities.id)).innerJoin(states, eq(jobs.stateId, states.id)).where(and(active, eq(jobs.featured, true))).orderBy(desc(jobs.publishedAt)).limit(6),
      connection.db.select({ name: categories.name, slug: categories.slug, total: count(jobs.id) }).from(categories).innerJoin(jobs, eq(jobs.categoryId, categories.id)).where(active).groupBy(categories.id).orderBy(desc(count(jobs.id))).limit(8),
      connection.db.select({ name: cities.name, slug: cities.slug, state: states.code, total: count(jobs.id) }).from(cities).innerJoin(states, eq(cities.stateId, states.id)).innerJoin(jobs, eq(jobs.cityId, cities.id)).where(active).groupBy(cities.id, states.code).orderBy(desc(count(jobs.id))).limit(8),
      connection.db.select({ name: sql<string>`coalesce(${companies.publicName}, ${companies.name})`, slug: companies.slug, total: count(jobs.id), logoUrl: companies.logoUrl }).from(companies).innerJoin(jobs, eq(jobs.companyId, companies.id)).where(and(active, eq(jobs.confidentialCompany, false))).groupBy(companies.id).orderBy(desc(count(jobs.id))).limit(6),
      connection.db.select({ name: categories.name, slug: categories.slug }).from(categories).where(eq(categories.active, true)).orderBy(categories.name).limit(30)
    ]);
  } finally {
    await connection.close();
  }
}

const allArticles = await listPublishedArticles(reviewMode.enabled ? 16 : 8);
const reviewNoindexIds = reviewMode.enabled
  ? new Set((await getEditorialAuditReport()).assessments.filter((item) => ["NOINDEX", "REVISAR MANUALMENTE"].includes(item.classification)).map((item) => item.article.id))
  : new Set<string>();
const articles = allArticles.filter((item) => !reviewNoindexIds.has(item.article.id));
const newsArticles = articles.filter((item) => item.article.type === "NEWS").slice(0, 4);
const blogArticles = articles.filter((item) => item.article.type !== "NEWS").slice(0, 4);
const displayFeatured = featured.length ? featured : recent.slice(0, 3);
const quickFilters = [
  ["Vagas SLZ", "/vagas-slz"],
  ["São Luís", "/vagas/cidade/sao-luis"],
  ["Presencial", "/vagas?modalidade=presencial"],
  ["Remoto", "/vagas?modalidade=remoto"],
  ["Auxiliar", "/vagas?q=auxiliar"],
  ["Vendedor", "/vagas?q=vendedor"]
];
const steps = [
  ["Busque", "Pesquise por cargo, cidade, categoria ou modalidade."],
  ["Compare", "Veja empresa, local, contrato e fonte da vaga."],
  ["Candidate-se", "Acesse o link oficial sem cadastro obrigatório."]
];
const editorialTopics = [
  ["Mercado de Trabalho", "Mudanças, dados e movimentos que afetam quem trabalha em São Luís e no Maranhão."],
  ["Currículo", "Orientações para apresentar experiência e competências com clareza, sem fórmulas enganosas."],
  ["Entrevistas", "Preparação prática para processos seletivos presenciais e remotos."],
  ["Primeiro Emprego", "Caminhos para quem busca a primeira oportunidade e ainda está construindo experiência."],
  ["Direitos", "Explicações com referência a fontes oficiais quando o tema depende de regra ou legislação."],
  ["Profissões", "Contexto sobre atividades, requisitos e possibilidades de carreira na região."],
  ["Salários", "Leitura responsável de faixas e períodos, sem transformar estimativas em promessa."],
  ["Empresas", "Informações para avaliar organizações, fontes e canais de candidatura."],
  ["Segurança contra Golpes", "Sinais de cobrança indevida, perfis falsos e pedidos suspeitos de dados."]
];
const homeTitle = reviewMode.enabled ? "Emprego, carreira e mercado de trabalho em São Luís" : "Empregos São Luís — Vagas SLZ e empregos em São Luís";
const homeDescription = reviewMode.enabled
  ? "Notícias e guias gratuitos sobre emprego, carreira e mercado de trabalho em São Luís e no Maranhão."
  : "Vagas SLZ e empregos SLZ em São Luís e no Maranhão. Encontre oportunidades atualizadas na capital maranhense.";
---
<BaseLayout title={homeTitle} description={homeDescription}>
  {reviewMode.enabled ? (
    <>
      <PageHero
        kicker={identity.siteName}
        title="Informação local para encontrar trabalho com segurança"
        description="Notícias, guias práticos e orientações verificáveis sobre emprego em São Luís e no Maranhão. O acesso é gratuito para candidatos."
      >
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="es-btn bg-white text-[var(--brand-primary)]" href="/blog">Ler guias</a>
          <a class="es-btn border border-white/60 text-white" href="/noticias">Ver notícias</a>
          <a class="es-btn border border-white/60 text-white" href="/seguranca-candidatos">Candidatura segura</a>
        </div>
      </PageHero>

      {newsArticles.length > 0 && (
        <section class="es-section bg-white">
          <div class="es-container">
            <SectionHeading kicker="Notícias" title="Mercado de trabalho local" description="Atualizações publicadas com autoria, data e fontes para ajudar o leitor a entender o contexto local." actionHref="/noticias" actionLabel="Ver notícias" />
            <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
              {newsArticles.map(({ article }) => <article class="es-card p-5"><p class="text-xs font-bold text-[var(--brand-primary)]">Notícia</p><h2 class="font-display mt-1 text-lg font-black"><a href={articlePublicPath(article.type, article.slug)}>{article.title}</a></h2>{article.excerpt && <p class="mt-2 line-clamp-3 text-sm text-[var(--es-muted)]">{article.excerpt}</p>}</article>)}
            </div>
          </div>
        </section>
      )}

      {blogArticles.length > 0 && (
        <section class="es-section">
          <div class="es-container">
            <SectionHeading kicker="Orientação" title="Guias para a busca de emprego" description="Conteúdo prático para currículo, entrevista, direitos, carreira e candidatura sem cobrança do candidato." actionHref="/blog" actionLabel="Ver todos os guias" />
            <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
              {blogArticles.map(({ article }) => <article class="es-card p-5"><p class="text-xs font-bold text-[var(--brand-primary)]">{article.type === 'DATA_REPORT' ? 'Relatório' : 'Guia'}</p><h2 class="font-display mt-1 text-lg font-black"><a href={articlePublicPath(article.type, article.slug)}>{article.title}</a></h2>{article.excerpt && <p class="mt-2 line-clamp-3 text-sm text-[var(--es-muted)]">{article.excerpt}</p>}</article>)}
            </div>
          </div>
        </section>
      )}

      <section class="es-section bg-white">
        <div class="es-container">
          <SectionHeading kicker="Biblioteca editorial" title="Temas para procurar emprego e desenvolver a carreira" description="A redação organiza conteúdos por necessidades reais do candidato, com contexto local quando ele é relevante." actionHref="/blog" actionLabel="Explorar conteúdos" />
          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {editorialTopics.map(([title, description]) => <article class="es-card p-5"><h2 class="font-display text-xl font-black">{title}</h2><p class="mt-2 text-sm text-[var(--es-muted)]">{description}</p></article>)}
          </div>
        </div>
      </section>

      <section class="es-section bg-[var(--es-cream-dark)]">
        <div class="es-container grid gap-5 md:grid-cols-3">
          <article class="es-card p-6"><p class="es-kicker">Transparência</p><h2 class="font-display mt-2 text-xl font-black">Como produzimos conteúdo</h2><p class="mt-2 text-sm text-[var(--es-muted)]">Conheça nossos critérios de seleção, fontes, revisão e correção.</p><a class="mt-4 inline-block font-bold underline" href="/politica-editorial">Política editorial</a></article>
          <article class="es-card p-6"><p class="es-kicker">Segurança</p><h2 class="font-display mt-2 text-xl font-black">Evite golpes em vagas</h2><p class="mt-2 text-sm text-[var(--es-muted)]">Nunca pague para se candidatar e confira o canal oficial antes de enviar dados.</p><a class="mt-4 inline-block font-bold underline" href="/seguranca-candidatos">Ler orientações</a></article>
          <article class="es-card p-6"><p class="es-kicker">Oportunidades</p><h2 class="font-display mt-2 text-xl font-black">Procurar vagas gratuitamente</h2><p class="mt-2 text-sm text-[var(--es-muted)]">A área de vagas continua acessível; durante a revisão ela fica temporariamente fora dos mecanismos de busca.</p><a class="mt-4 inline-block font-bold underline" href="/vagas">Explorar vagas</a></article>
        </div>
      </section>
    </>
  ) : (
    <>
  <PageHero
    kicker={identity.siteName}
    title="Vagas SLZ em São Luís — seu próximo emprego na capital"
    description={homeDescription}
  >
    <form class="hero-search-panel mt-8 rounded-3xl border p-4 shadow-2xl sm:p-5" action="/vagas" method="get" role="search">
      <div class="grid gap-3 lg:grid-cols-4">
        <label class="grid gap-1 text-sm font-semibold lg:col-span-2">
          <span>Cargo ou palavra-chave</span>
          <input class="rounded-xl border border-[var(--es-border)] px-4 py-3" name="q" placeholder="Ex.: auxiliar administrativo" />
        </label>
        <label class="grid gap-1 text-sm font-semibold">
          <span>Cidade</span>
          <input class="rounded-xl border border-[var(--es-border)] px-4 py-3" name="cidade" placeholder="Ex.: São Luís" />
        </label>
        <label class="grid gap-1 text-sm font-semibold">
          <span>Modalidade</span>
          <select class="rounded-xl border border-[var(--es-border)] px-4 py-3" name="modalidade">
            <option value="">Qualquer</option>
            <option value="presencial">Presencial</option>
            <option value="hibrido">Híbrido</option>
            <option value="remoto">Remoto</option>
          </select>
        </label>
        <label class="grid gap-1 text-sm font-semibold lg:col-span-2">
          <span>Categoria</span>
          <select class="rounded-xl border border-[var(--es-border)] px-4 py-3" name="categoria">
            <option value="">Todas</option>
            {categoryOptions.map((item) => <option value={item.slug}>{item.name}</option>)}
          </select>
        </label>
        <div class="flex items-end lg:col-span-2">
          <button class="es-btn es-btn-primary w-full py-3.5 text-base" type="submit">Buscar vagas</button>
        </div>
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="hero-search-meta text-xs font-bold uppercase tracking-wide">Populares:</span>
        {quickFilters.map(([label, href]) => <a class="chip hover:border-[var(--brand-primary)] hover:text-[var(--brand-primary)]" href={href}>{label}</a>)}
      </div>
    </form>
  </PageHero>

  <div class="es-container py-6"><AdSlot slot="home-top" pageType="home" /></div>

  <section class="es-section pt-0">
    <div class="es-container">
      <SectionHeading kicker="Oportunidades" title={featured.length ? "Vagas em destaque" : "Vagas mais recentes"} actionHref="/vagas" actionLabel="Ver todas" />
      {displayFeatured.length ? (
        <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {displayFeatured.map((job) => <JobCard {...job} />)}
        </div>
      ) : (
        <div class="mt-8">
          <EmptyState title="Novas vagas em breve" description="Ainda não há vagas publicadas agora, mas você pode criar um alerta gratuito e explorar categorias e cidades abaixo." actionHref="/alertas" actionLabel="Criar alerta" secondaryHref="/vagas" secondaryLabel="Explorar busca" />
        </div>
      )}
    </div>
  </section>

  {recent.length > displayFeatured.length && (
    <section class="es-section bg-white">
      <div class="es-container">
        <SectionHeading title="Publicadas recentemente" />
        <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {recent.filter((job) => !displayFeatured.some((item) => item.id === job.id)).slice(0, 6).map((job) => <JobCard {...job} compact />)}
        </div>
      </div>
    </section>
  )}

  {newsArticles.length > 0 && (
    <section class="es-section">
      <div class="es-container">
        <SectionHeading kicker="Notícias" title="Atualizações do mercado de trabalho" actionHref="/noticias" actionLabel="Ver notícias" />
        <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {newsArticles.map(({ article }) => (
            <article class="es-card p-5">
              <p class="text-xs font-bold text-[var(--brand-primary)]">Notícia</p>
              <h3 class="font-display mt-1 text-lg font-black">
                <a href={articlePublicPath(article.type, article.slug)}>{article.title}</a>
              </h3>
              {article.excerpt && <p class="mt-2 text-sm text-[var(--es-muted)] line-clamp-3">{article.excerpt}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {blogArticles.length > 0 && (
    <section class="es-section bg-white">
      <div class="es-container">
        <SectionHeading kicker="Blog" title="Guias para se candidatar melhor" actionHref="/blog" actionLabel="Ver blog" />
        <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {blogArticles.map(({ article }) => (
            <article class="es-card p-5">
              <p class="text-xs font-bold text-[var(--brand-primary)]">{article.type === "DATA_REPORT" ? "Relatório" : "Guia"}</p>
              <h3 class="font-display mt-1 text-lg font-black">
                <a href={articlePublicPath(article.type, article.slug)}>{article.title}</a>
              </h3>
              {article.excerpt && <p class="mt-2 text-sm text-[var(--es-muted)] line-clamp-3">{article.excerpt}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="es-container"><AdSlot slot="home-between-sections" pageType="home" /></div>

  <section class="es-section bg-[var(--es-cream-dark)]">
    <div class="es-container grid gap-10 lg:grid-cols-2">
      {categoryRows.length > 0 && (
        <div>
          <SectionHeading kicker="Áreas" title="Categorias mais procuradas" />
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {categoryRows.map((item) => (
              <a class="es-card block p-4 hover:border-[var(--brand-primary)]" href={`/vagas/categoria/${item.slug}`}>
                <span class="font-display font-black">{item.name}</span>
                <span class="mt-1 block text-sm text-[var(--es-muted)]">{item.total} vaga(s)</span>
              </a>
            ))}
          </div>
        </div>
      )}
      {cityRows.length > 0 && (
        <div>
          <SectionHeading kicker="Local" title="Vagas por cidade" />
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {cityRows.map((item) => (
              <a class="es-card block p-4 hover:border-[var(--brand-primary)]" href={`/vagas/cidade/${item.slug}`}>
                <span class="font-display font-black">{item.name}/{item.state}</span>
                <span class="mt-1 block text-sm text-[var(--es-muted)]">{item.total} vaga(s)</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  {companyRows.length > 0 && (
    <section class="es-section">
      <div class="es-container">
        <SectionHeading kicker="Empresas" title="Empresas com vagas abertas" actionHref="/empresas" actionLabel="Ver todas" />
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {companyRows.map((company) => (
            <a class="es-card flex items-center gap-4 p-5" href={`/empresas/${company.slug}`}>
              {company.logoUrl ? <img src={company.logoUrl} alt="" class="h-12 w-12 rounded-xl border object-contain p-1" width="48" height="48" loading="lazy" /> : <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--es-cream-dark)] font-black text-[var(--brand-primary)]">{company.name.slice(0, 1)}</div>}
              <div>
                <p class="font-display font-black">{company.name}</p>
                <p class="text-sm text-[var(--es-muted)]">{company.total} vaga(s)</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="es-section bg-white">
    <div class="es-container">
      <SectionHeading kicker="Como funciona" title="Simples para quem busca emprego" description="Sem cobrança do candidato e com fonte identificada em cada publicação." />
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {steps.map(([title, text], index) => (
          <article class="es-card p-6">
            <p class="text-sm font-black text-[var(--brand-primary)]">0{index + 1}</p>
            <h3 class="font-display mt-2 text-xl font-black">{title}</h3>
            <p class="mt-2 text-sm text-[var(--es-muted)]">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <InstagramFollow />

  <section class="hero-pattern es-section text-white">
    <div class="es-container flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <p class="es-kicker text-white/70">Alertas</p>
        <h2 class="font-display mt-2 text-3xl font-black sm:text-4xl">Receba vagas compatíveis com você</h2>
        <p class="mt-3 max-w-xl text-white/80">Escolha cidade, área e frequência. Gratuito e cancelável a qualquer momento.</p>
      </div>
      <a class="es-btn bg-white text-[var(--brand-primary)] hover:bg-[var(--brand-background)]" href="/alertas">Criar alerta gratuito</a>
    </div>
  </section>

  <section class="es-section">
    <div class="es-container grid gap-5 lg:grid-cols-2">
      <article class="es-card p-6 sm:p-8">
        <p class="es-kicker">Empresas</p>
        <h2 class="font-display mt-2 text-2xl font-black">Divulgue vagas com transparência</h2>
        <p class="mt-3 text-[var(--text-secondary)]">Alcance candidatos locais com fonte identificada e página dedicada da empresa.</p>
        <a class="es-btn es-btn-primary mt-5" href="/publicar-vaga">Publicar vaga</a>
      </article>
      <article class="es-card p-6 sm:p-8">
        <p class="es-kicker">Segurança</p>
        <h2 class="font-display mt-2 text-2xl font-black">Candidatura segura</h2>
        <p class="mt-3 text-[var(--es-muted)]">Desconfie de cobranças e links suspeitos. Veja orientações para se proteger.</p>
        <a class="es-btn es-btn-secondary mt-5" href="/seguranca-candidatos">Ler orientações</a>
      </article>
    </div>
  </section>
    </>
  )}
</BaseLayout>
