---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Pagination from "../../components/ui/Pagination.astro";
import { listPublishedArticlesPage } from "../../lib/articles";
import { listAutoEditorialArticles } from "../../lib/auto-editorial";
import {
  EDITORIAL_BLOG_THEMES,
  getEditorialPortalMode,
  type EditorialBlogTheme
} from "../../lib/portal-modes";

const pageSize = 12;
const page = Math.max(1, Number(Astro.url.searchParams.get("pagina") ?? 1) || 1);
const themeParam = Astro.url.searchParams.get("tema");
const { items, total, page: current, pages, theme } = await listPublishedArticlesPage(
  page,
  pageSize,
  ["GUIDE", "DATA_REPORT"],
  themeParam,
  true // exibir somente guias indexáveis e revisados durante a análise do AdSense
);
const portal = await getEditorialPortalMode();
const automatic = listAutoEditorialArticles(3).filter((item) => !items.some(({ article }) => article.slug === item.slug));
const themeMeta = theme ? EDITORIAL_BLOG_THEMES[theme as EditorialBlogTheme] : null;
const featuredGuide = current === 1 && !theme ? items[0] : undefined;
const listingGuides = featuredGuide ? items.slice(1) : items;
const pageUrl = (target: number) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  if (target <= 1) params.delete("pagina");
  else params.set("pagina", String(target));
  const q = params.toString();
  return q ? `?${q}` : "/blog";
};
const canonicalPath =
  current > 1 || theme
    ? `/blog?${new URLSearchParams({
        ...(theme ? { tema: theme } : {}),
        ...(current > 1 ? { pagina: String(current) } : {})
      }).toString()}`
    : "/blog";
const canonical = new URL(canonicalPath, Astro.site).toString();
const heroTitle = themeMeta ? `${themeMeta.label} — guias` : "Guias e mercado de trabalho";
const heroDescription = themeMeta
  ? `Conteúdos do blog sobre ${themeMeta.label.toLowerCase()} para candidatos em São Luís e no Maranhão.`
  : "Orientação gratuita, análises locais e informações úteis para candidatos e empresas.";
---
<BaseLayout
  title={themeMeta ? `${themeMeta.label} — Empregos São Luís` : "Guias gratuitos de emprego — Empregos São Luís"}
  description={heroDescription}
  breadcrumbs={[{ name: "Guias", url: "/blog" }, ...(themeMeta ? [{ name: themeMeta.label, url: `/blog?tema=${theme}` }] : [])]}
  pageSchemaType="CollectionPage"
  canonical={canonical}
  noindex={items.length === 0 || current > 1 || Boolean(theme)}
>
  <PageHero kicker="Conteúdo gratuito" title={heroTitle} description={heroDescription} pattern={false} />
  <section class="es-section pt-0">
    <div class="es-container">
      <Breadcrumbs items={[{ name: "Início", url: "/" }, { name: "Guias", url: "/blog" }, ...(themeMeta ? [{ name: themeMeta.label }] : [])]} />
      {current === 1 && !theme && automatic.length > 0 && (
        <section class="mt-8" aria-label="Novos guias com revisão automatizada">
          <h2 class="font-display text-2xl font-black">Novos guias gratuitos</h2>
          <p class="mt-2 text-sm text-[var(--text-secondary)]">Publicações programadas e verificadas por critérios automáticos de estrutura, fontes e conteúdo. A verificação automática não substitui a checagem humana de fatos.</p>
          <ul class="mt-5 grid gap-4 md:grid-cols-2">
            {automatic.map(item => (
              <li class="es-card es-premium-article-card es-blog-story-card overflow-hidden">
                <a href={`/blog/${item.slug}`} class="block">
                  <img src={item.coverImageUrl} alt={item.coverImageAlt} width="600" height="338" loading="lazy" decoding="async" class="es-premium-card-image h-44 w-full object-cover" />
                  <span class="block p-4 font-display text-xl font-black">{item.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <nav class="es-premium-tabs mt-7 flex flex-wrap gap-2" aria-label="Temas do blog">
        <a class={`rounded-full border px-4 py-2 text-sm font-semibold ${!theme ? "bg-[var(--brand-primary)] text-white border-transparent" : "bg-white text-[var(--text-secondary)] border-[var(--brand-border)]"}`} href="/blog">Todos</a>
        {(Object.keys(EDITORIAL_BLOG_THEMES) as EditorialBlogTheme[]).map((key) => (
          <a
            class={`rounded-full border px-4 py-2 text-sm font-semibold ${theme === key ? "bg-[var(--brand-primary)] text-white border-transparent" : "bg-white text-[var(--text-secondary)] border-[var(--brand-border)]"}`}
            href={`/blog?tema=${key}`}
          >
            {EDITORIAL_BLOG_THEMES[key].label}
          </a>
        ))}
      </nav>
      {featuredGuide && (
        <article class="es-blog-editorial-feature mt-9">
          <a href={"/blog/" + featuredGuide.article.slug} class="es-blog-feature-link">
            <div class="es-blog-feature-visual">
              {featuredGuide.article.coverImageUrl ? (
                <img
                  src={featuredGuide.article.coverImageUrl}
                  alt={featuredGuide.article.coverImageAlt ?? featuredGuide.article.title}
                  width="900"
                  height="620"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              ) : <div class="es-blog-feature-fallback" aria-hidden="true">ES / GUIAS</div>}
            </div>
            <div class="es-blog-feature-content">
              <p class="es-magazine-section-kicker">LEITURA PRINCIPAL</p>
              <h2 class="font-display">{featuredGuide.article.title}</h2>
              {featuredGuide.article.excerpt && <p>{featuredGuide.article.excerpt}</p>}
              <span>Por {featuredGuide.authorName}</span>
              <strong>Ler o guia completo <span aria-hidden="true">↗</span></strong>
            </div>
          </a>
        </article>
      )}
      {items.length === 0 ? (
        <div class="mt-8">
          <EmptyState
            title={themeMeta ? `Nenhum guia sobre ${themeMeta.label.toLowerCase()}` : "Nenhum guia publicado"}
            description="Esta página permanece fora do índice até haver conteúdo editorial revisado neste recorte."
            actionHref={portal.enabled ? "/noticias" : "/vagas"}
            actionLabel={portal.enabled ? "Ver notícias" : "Ver vagas"}
          />
        </div>
      ) : (
        <>
          <p class="mt-6 text-sm text-[var(--text-secondary)]">{total} guia(s) · página {current} de {pages}</p>
          <ul class="es-blog-story-grid mt-7 grid gap-5 md:grid-cols-2">
            {listingGuides.map(({ article, authorName }) => (
              <li class="es-card es-premium-article-card overflow-hidden">
                {article.coverImageUrl && (
                  <img
                    src={article.coverImageUrl}
                    alt={article.coverImageAlt ?? article.title}
                    class="es-premium-card-image es-blog-story-cover h-48 w-full object-cover"
                    width="640" height="360" loading="lazy" decoding="async"
                  />
                )}
                <div class="p-6">
                  <p class="es-kicker">{article.type === "DATA_REPORT" ? "Relatório" : "Guia"}</p>
                  <a class="es-premium-story-title font-display mt-2 block text-2xl font-black leading-tight" href={`/blog/${article.slug}`}>{article.title}</a>
                  <p class="mt-3 text-[var(--es-muted)]">{article.excerpt}</p>
                  <p class="mt-4 text-xs text-[var(--es-muted)]">Por {authorName}</p>
                </div>
              </li>
            ))}
          </ul>
          <Pagination current={current} pages={pages} hrefForPage={pageUrl} />
        </>
      )}
    </div>
  </section>
</BaseLayout>
