---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import PageHero from "../../components/ui/PageHero.astro";
import { listPublishedArticles } from "../../lib/articles";
const items = await listPublishedArticles(50, undefined, ["GUIDE", "DATA_REPORT"]);
---
<BaseLayout title="Guias gratuitos de emprego — Empregos São Luís" description="Guias gratuitos para candidatos e análises do mercado de trabalho local." breadcrumbs={[{ name: "Guias", url: "/blog" }]} pageSchemaType="CollectionPage" noindex={items.length === 0}>
  <PageHero kicker="Conteúdo gratuito" title="Guias e mercado de trabalho" description="Orientação gratuita, análises locais e informações úteis para candidatos e empresas." pattern={false} />
  <section class="es-section pt-0"><div class="es-container">
    <Breadcrumbs items={[{ name: "Início", url: "/" }, { name: "Guias" }]} />
    {items.length === 0 ? <div class="mt-8"><EmptyState title="Nenhum guia publicado" description="Esta página permanecerá fora do índice até receber conteúdo editorial revisado." actionHref="/vagas" actionLabel="Ver vagas" /></div> :
      <ul class="mt-8 grid gap-5 md:grid-cols-2">{items.map(({ article, authorName }) => <li class="es-card overflow-hidden">{article.coverImageUrl && <img src={article.coverImageUrl} alt={article.coverImageAlt ?? article.title} class="h-48 w-full object-cover" loading="lazy" />}<div class="p-6"><p class="es-kicker">{article.type === "DATA_REPORT" ? "Relatório" : "Guia"}</p><a class="font-display mt-2 block text-2xl font-black" href={`/blog/${article.slug}`}>{article.title}</a><p class="mt-3 text-[var(--es-muted)]">{article.excerpt}</p><p class="mt-4 text-xs text-[var(--es-muted)]">Por {authorName}</p></div></li>)}</ul>}
  </div></section>
</BaseLayout>
