---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import PageHero from "../../components/ui/PageHero.astro";
import { listPublishedArticlesPage } from "../../lib/articles";

const pageSize = 12;
const page = Math.max(1, Number(Astro.url.searchParams.get("pagina") ?? 1) || 1);
const { items, total, page: current, pages } = await listPublishedArticlesPage(page, pageSize, ["GUIDE", "DATA_REPORT"]);
const pageUrl = (target: number) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  if (target <= 1) params.delete("pagina");
  else params.set("pagina", String(target));
  const q = params.toString();
  return q ? `?${q}` : "/blog";
};
const canonical = new URL(current > 1 ? `/blog?pagina=${current}` : "/blog", Astro.site).toString();
---
<BaseLayout
  title="Guias gratuitos de emprego — Empregos São Luís"
  description="Guias gratuitos para candidatos e análises do mercado de trabalho local."
  breadcrumbs={[{ name: "Guias", url: "/blog" }]}
  pageSchemaType="CollectionPage"
  canonical={canonical}
  noindex={items.length === 0 || current > 1}
>
  <PageHero kicker="Conteúdo gratuito" title="Guias e mercado de trabalho" description="Orientação gratuita, análises locais e informações úteis para candidatos e empresas." pattern={false} />
  <section class="es-section pt-0">
    <div class="es-container">
      <Breadcrumbs items={[{ name: "Início", url: "/" }, { name: "Guias" }]} />
      {items.length === 0 ? (
        <div class="mt-8">
          <EmptyState
            title="Nenhum guia publicado"
            description="Esta página permanecerá fora do índice até receber conteúdo editorial revisado."
            actionHref="/vagas"
            actionLabel="Ver vagas"
          />
        </div>
      ) : (
        <>
          <p class="mt-6 text-sm text-[var(--text-secondary)]">{total} guia(s) · página {current} de {pages}</p>
          <ul class="mt-6 grid gap-5 md:grid-cols-2">
            {items.map(({ article, authorName }) => (
              <li class="es-card overflow-hidden">
                {article.coverImageUrl && (
                  <img
                    src={article.coverImageUrl}
                    alt={article.coverImageAlt ?? article.title}
                    class="h-48 w-full object-cover"
                    loading="lazy"
                  />
                )}
                <div class="p-6">
                  <p class="es-kicker">{article.type === "DATA_REPORT" ? "Relatório" : "Guia"}</p>
                  <a class="font-display mt-2 block text-2xl font-black" href={`/blog/${article.slug}`}>{article.title}</a>
                  <p class="mt-3 text-[var(--es-muted)]">{article.excerpt}</p>
                  <p class="mt-4 text-xs text-[var(--es-muted)]">Por {authorName}</p>
                </div>
              </li>
            ))}
          </ul>
          {pages > 1 && (
            <nav class="mt-8 flex items-center justify-between" aria-label="Paginação">
              <span class="text-sm text-[var(--text-secondary)]">Página {current} de {pages}</span>
              <div class="flex gap-2">
                {current > 1 && (
                  <a class="rounded-xl border bg-white px-4 py-2 text-sm font-semibold" href={pageUrl(current - 1)}>Anterior</a>
                )}
                {current < pages && (
                  <a class="rounded-xl border bg-white px-4 py-2 text-sm font-semibold" href={pageUrl(current + 1)}>Próxima</a>
                )}
              </div>
            </nav>
          )}
        </>
      )}
    </div>
  </section>
</BaseLayout>
