---
import BaseLayout from "../../layouts/BaseLayout.astro"; import { findPublishedArticle } from "../../lib/articles";
const result = await findPublishedArticle(Astro.params.slug ?? ""); if (!result) { Astro.response.status = 404; return new Response("Conteúdo não encontrado", { status: 404 }); }
const { article, authorName } = result; const schemaType = article.type === "NEWS" ? "NewsArticle" : "Article"; const jsonLd = { "@context": "https://schema.org", "@type": schemaType, headline: article.title, datePublished: article.publishedAt?.toISOString(), dateModified: article.updatedAt.toISOString(), author: { "@type": "Person", name: authorName }, publisher: { "@type": "Organization", name: "Empregos São Luís" }, ...(article.coverImageUrl ? { image: [article.coverImageUrl] } : {}) };
---
<BaseLayout title={`${article.title} — Empregos São Luís`} description={article.excerpt}><script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}/><article class="mx-auto max-w-3xl px-4 py-12"><p class="font-bold text-red-700">{article.type === "NEWS" ? "Notícia" : "Guia"}</p><h1 class="mt-3 text-4xl font-black">{article.title}</h1><p class="mt-4 text-slate-600">Por {authorName}</p><div class="prose mt-8 max-w-none" set:html={article.contentHtml}/></article></BaseLayout>
