---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Pagination from "../../components/ui/Pagination.astro";
import { listPublishedArticlesPage } from "../../lib/articles";
import { getRuntimeSiteUrl } from "../../lib/canonical-url";

const pageSize = 12;
const pageParam = Astro.url.searchParams.get("pagina") ?? "1";
const pageNumber = Number(pageParam);
const page = /^[1-9]\d*$/.test(pageParam) && Number.isSafeInteger(pageNumber) ? pageNumber : 1;
const { items, total, page: current, pages } = await listPublishedArticlesPage(page, pageSize, "NEWS");
if (page > pages) return new Response("Página não encontrada", { status: 404, headers: { "X-Robots-Tag": "noindex, follow" } });
const featured = current === 1 ? items[0] : undefined;
const rest = current === 1 ? items.slice(1) : items;
const pageUrl = (target: number) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  if (target <= 1) params.delete("pagina");
  else params.set("pagina", String(target));
  const q = params.toString();
  return q ? `?${q}` : "/noticias";
};
const canonical = new URL(current > 1 ? `/noticias?pagina=${current}` : "/noticias", getRuntimeSiteUrl(Astro.site)).toString();
---
<BaseLayout
  title="Notícias de emprego — Empregos São Luís"
  description="Notícias sobre mercado de trabalho, concursos e oportunidades em São Luís e no Maranhão."
  breadcrumbs={[{ name: "Notícias", url: "/noticias" }]}
  pageSchemaType="CollectionPage"
  canonical={canonical}
  noindex={items.length === 0 || current > 1}
>
  <PageHero kicker="Editorial" title="Notícias e orientação profissional" description="Conteúdo sobre mercado de trabalho, carreira e oportunidades na região." pattern={false} />

  <section class="es-section pt-0">
    <div class="es-container">
      <Breadcrumbs items={[{ name: "Início", url: "/" }, { name: "Notícias" }]} />

      {items.length === 0 ? (
        <div class="mt-8">
          <EmptyState
            title="Nenhuma notícia publicada"
            description="Volte em breve para conteúdos sobre carreira e mercado de trabalho."
            actionHref="/vagas"
            actionLabel="Ver vagas"
          />
        </div>
      ) : (
        <>
          <p class="mt-6 text-sm text-[var(--text-secondary)]">{total} notícia(s) · página {current} de {pages}</p>
          <div class="mt-6 grid gap-6 lg:grid-cols-3">
            {featured && (
              <article class="es-card overflow-hidden lg:col-span-2">
                {featured.article.coverImageUrl && (
                  <img
                    src={featured.article.coverImageUrl}
                    alt={featured.article.coverImageAlt ?? featured.article.title}
                    class="h-56 w-full object-cover"
                    loading="lazy"
                  />
                )}
                <div class="p-6 sm:p-8">
                  <p class="es-kicker">{featured.article.section ?? "Notícia"}</p>
                  <h2 class="font-display mt-2 text-3xl font-black">
                    <a href={`/noticias/${featured.article.slug}`}>{featured.article.title}</a>
                  </h2>
                  <p class="mt-3 text-[var(--es-muted)]">{featured.article.excerpt}</p>
                  <p class="mt-4 text-sm text-[var(--es-muted)]">
                    Por {featured.authorName} · {featured.article.publishedAt?.toLocaleDateString("pt-BR")}
                  </p>
                </div>
              </article>
            )}
            <div class="grid gap-4">
              {(featured ? rest.slice(0, 4) : rest.slice(0, 6)).map(({ article, authorName }) => (
                <article class="es-card p-5">
                  <p class="text-xs font-bold text-[var(--brand-primary)]">{article.section ?? "Notícia"}</p>
                  <h3 class="font-display mt-1 text-lg font-black">
                    <a href={`/noticias/${article.slug}`}>{article.title}</a>
                  </h3>
                  <p class="mt-2 text-sm text-[var(--es-muted)]">
                    {authorName} · {article.publishedAt?.toLocaleDateString("pt-BR")}
                  </p>
                </article>
              ))}
            </div>
            {(featured ? rest.length > 4 : rest.length > 6) && (
              <div class="grid gap-5 sm:grid-cols-2 lg:col-span-3">
                {(featured ? rest.slice(4) : rest.slice(6)).map(({ article, authorName }) => (
                  <article class="es-card overflow-hidden">
                    {article.coverImageUrl && (
                      <img
                        src={article.coverImageUrl}
                        alt={article.coverImageAlt ?? article.title}
                        class="h-40 w-full object-cover"
                        loading="lazy"
                      />
                    )}
                    <div class="p-5">
                      <h3 class="font-display text-xl font-black">
                        <a href={`/noticias/${article.slug}`}>{article.title}</a>
                      </h3>
                      <p class="mt-2 text-sm text-[var(--es-muted)]">{article.excerpt}</p>
                      <p class="mt-3 text-xs text-[var(--es-muted)]">{authorName}</p>
                    </div>
                  </article>
                ))}
              </div>
            )}
          </div>
          <Pagination current={current} pages={pages} hrefForPage={pageUrl} />
        </>
      )}
    </div>
  </section>
</BaseLayout>
