---
import BaseLayout from "../../layouts/BaseLayout.astro"; import { listPublishedArticles } from "../../lib/articles"; const items = await listPublishedArticles(50, undefined, "NEWS");
---
<BaseLayout title="Notícias de emprego — Empregos São Luís" description="Notícias sobre mercado de trabalho, concursos e oportunidades em São Luís e no Maranhão."><section class="mx-auto max-w-6xl px-4 py-12"><nav class="text-sm text-slate-600"><a href="/">Início</a> / Notícias</nav><h1 class="mt-4 text-4xl font-black">Notícias de emprego</h1>{items.length === 0 ? <p class="mt-8 rounded-xl border bg-white p-6">Nenhuma notícia publicada neste momento.</p> : <div class="mt-8 grid gap-5 md:grid-cols-2">{items.map(({ article, authorName }) => <article class="rounded-2xl border bg-white p-6"><p class="text-sm font-bold text-red-700">{article.section ?? "Notícia"}</p><h2 class="mt-2 text-2xl font-black"><a href={`/noticias/${article.slug}`}>{article.title}</a></h2><p class="mt-3 text-slate-600">{article.excerpt}</p><p class="mt-4 text-sm">Por {authorName} · {article.publishedAt?.toLocaleDateString("pt-BR")}</p></article>)}</div>}</section></BaseLayout>
