---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import {
  articlePublicPath,
  findPublishedArticle,
  findPublishedSlLocalByNumber,
  resolveSlLocalSeoSlug
} from "../../lib/articles";
import { getEditorialPortalMode } from "../../lib/portal-modes";
import { rewriteJobBoardLinksForPortal } from "../../lib/portal-content-rewrite";
import { normalizeEditorialHtml } from "@es/shared";
import { isEditorialReviewPending } from "../../data/editorial-review-pending";
import { getNewsEditorialOverride } from "../../data/news-editorial-content-overrides";
import { getRuntimeSiteUrl, resolveCanonicalUrl, resolvePublicHttpUrl } from "../../lib/canonical-url";
import { buildEditorialSchema, extractExternalEditorialCitations, isNewsroomAuthor } from "../../lib/editorial-schema";
import { buildOwnedEditorialCoverImageObject, getEditorialCoverMetadata } from "../../lib/editorial-cover-metadata";

const slug = Astro.params.slug!;
const portal = await getEditorialPortalMode();
const seoFromLegacy = resolveSlLocalSeoSlug(slug);
if (seoFromLegacy && seoFromLegacy !== slug) {
  const moved = await findPublishedArticle(seoFromLegacy, ["GUIDE", "DATA_REPORT", "NEWS"]);
  if (moved) return Astro.redirect(articlePublicPath(moved.article.type, moved.article.slug), 301);
}
const result = await findPublishedArticle(slug, "NEWS");
if (!result) {
  // SEO: posts reclassificados (NEWS → GUIDE/DATA) mantêm 301 a partir da URL antiga.
  const retyped = await findPublishedArticle(slug, ["GUIDE", "DATA_REPORT"]);
  if (retyped) {
    return Astro.redirect(`/blog/${slug}`, 301);
  }
  const renamed = await findPublishedSlLocalByNumber(slug, ["GUIDE", "DATA_REPORT", "NEWS"]);
  if (renamed) return Astro.redirect(articlePublicPath(renamed.article.type, renamed.article.slug), 301);
  return new Response("Notícia não encontrada", {
    status: 404,
    headers: { "Content-Type": "text/plain; charset=utf-8", "X-Robots-Tag": "noindex, follow" }
  });
}
const { article, authorName } = result;
const newsroomAuthor = isNewsroomAuthor(authorName);
const editorialOverride = getNewsEditorialOverride(article.slug);
const editorialNoindex = isEditorialReviewPending("NEWS", article.slug) && !editorialOverride;
const normalizedHtml = normalizeEditorialHtml(editorialOverride?.contentHtml ?? article.contentHtml, { baseHeadingLevel: 2 });
const contentHtml = portal.enabled ? rewriteJobBoardLinksForPortal(normalizedHtml) : normalizedHtml;
const runtimeSite = getRuntimeSiteUrl(Astro.site);
const citations = extractExternalEditorialCitations(\n  contentHtml,\n  runtimeSite.toString(),\n  !editorialOverride && article.sourceUrl ? [article.sourceUrl] : []\n);
const canonical = resolveCanonicalUrl(article.canonicalUrl ?? undefined, `/noticias/${article.slug}`, runtimeSite);
const reviewedAt = editorialOverride ? new Date(`${editorialOverride.reviewedAt}T12:00:00-03:00`) : null;
const coverMetadata = getEditorialCoverMetadata(article.slug, article.coverImageUrl);
const effectiveCoverAlt = coverMetadata?.alt ?? article.coverImageAlt ?? article.title;
const effectiveCoverCaption = coverMetadata?.caption ?? article.coverImageCaption;
const effectiveCoverCredit = coverMetadata?.credit ?? article.coverImageCredit;
const effectiveCoverWidth = coverMetadata?.width ?? article.coverImageWidth ?? 1600;
const effectiveCoverHeight = coverMetadata?.height ?? article.coverImageHeight ?? 900;
const variants = article.coverImageVariants && typeof article.coverImageVariants === "object"
  ? article.coverImageVariants as Record<string, { url?: string; width?: number; height?: number }>
  : {};
const manifestedCoverUrl = coverMetadata
  ? resolvePublicHttpUrl(article.coverImageUrl ?? undefined, runtimeSite)
  : null;
const ownedStructuredImage = buildOwnedEditorialCoverImageObject(coverMetadata, manifestedCoverUrl);
const structuredImages = manifestedCoverUrl
  ? [ownedStructuredImage ?? {
      "@type": "ImageObject",
      url: manifestedCoverUrl,
      width: effectiveCoverWidth,
      height: effectiveCoverHeight,
      ...(effectiveCoverCaption ? { caption: effectiveCoverCaption } : {}),
      ...(effectiveCoverCredit ? { creditText: effectiveCoverCredit } : {})
    }]
  : [variants.hero, variants.landscape43, variants.square]
  .flatMap((image) => {
    if (!image) return [];
    const url = resolvePublicHttpUrl(image?.url, runtimeSite);
    if (!url) return [];
    return [{
    "@type": "ImageObject",
    url,
    ...(image.width ? { width: image.width } : {}),
    ...(image.height ? { height: image.height } : {}),
    ...(effectiveCoverCaption ? { caption: effectiveCoverCaption } : {}),
    ...(effectiveCoverCredit ? { creditText: effectiveCoverCredit } : {})
    }];
  });
const jsonLd = buildEditorialSchema({
  type: "NewsArticle",
  title: article.title,
  description: article.metaDescription ?? article.excerpt,
  canonical,
  authorName,
  publishedAt: article.publishedAt,
  updatedAt: reviewedAt ?? article.updatedAt,
  ...(citations.length ? { citations } : {}),
  ...(structuredImages.length ? { image: structuredImages } : {}),
  siteUrl: runtimeSite.toString()
});
---
<BaseLayout title={`${article.seoTitle ?? article.title} — Empregos São Luís`} description={article.metaDescription ?? article.excerpt} canonical={canonical} ogImage={article.ogImageUrl ?? article.coverImageUrl ?? undefined} breadcrumbs={[{ name: "Notícias", url: "/noticias" }, { name: article.title, url: `/noticias/${article.slug}` }]} schemas={[jsonLd]} noindex={editorialNoindex}>
  <article class="es-section">
    <div class="es-container max-w-4xl">
      <Breadcrumbs items={[{ name: "Início", url: "/" }, { name: "Notícias", url: "/noticias" }, { name: article.title }]} />
      <p class="es-kicker mt-6">{article.section ?? "Notícia"}</p>
      <h1 class="font-display mt-2 text-4xl font-black sm:text-5xl">{article.title}</h1>
      {article.subtitle && <p class="mt-4 text-xl text-[var(--es-muted)]">{article.subtitle}</p>}
      <p class="mt-4 text-sm text-[var(--es-muted)]">Por {newsroomAuthor ? <a class="underline" href="/redacao" rel="author">{authorName}</a> : authorName} · {article.publishedAt?.toLocaleDateString("pt-BR")}{reviewedAt ? ` · Revisado em ${reviewedAt.toLocaleDateString("pt-BR")}` : ""}</p>
      {article.coverImageUrl && (
        <figure class="mt-8 overflow-hidden rounded-3xl">
          <img class="w-full max-h-[34rem] bg-[var(--es-cream)] object-contain" decoding="async" src={coverMetadata ? article.coverImageUrl : variants.hero?.url ?? article.coverImageUrl} srcset={!coverMetadata && variants.card?.url && variants.hero?.url ? `${variants.card.url} 640w, ${variants.hero.url} 1600w` : undefined} sizes="(max-width: 768px) 100vw, 896px" alt={effectiveCoverAlt} width={effectiveCoverWidth} height={effectiveCoverHeight} loading="eager" fetchpriority="high" />
          {(effectiveCoverCaption || effectiveCoverCredit) && <figcaption class="mt-2 text-sm text-[var(--es-muted)]">{effectiveCoverCaption}{effectiveCoverCaption && effectiveCoverCredit ? " · " : ""}{effectiveCoverCredit ? `Crédito: ${effectiveCoverCredit}` : ""}</figcaption>}
        </figure>
      )}
      <div class="es-prose mt-8 max-w-none text-[1.05rem] leading-8" set:html={contentHtml} />
      {!editorialOverride && article.sourceUrl && <p class="mt-8 text-sm">Fonte: <a class="underline" href={article.sourceUrl} rel="nofollow noopener">{article.sourceName ?? "fonte original"}</a></p>}
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="es-btn es-btn-secondary" href={`https://wa.me/?text=${encodeURIComponent(`${article.title} - ${canonical}`)}`} rel="noopener noreferrer">Compartilhar</a>
        <a class="es-btn es-btn-secondary" href="/noticias">Voltar às notícias</a>
      </div>
    </div>
  </article>
</BaseLayout>
