---
import BaseLayout from "../layouts/BaseLayout.astro";

if (Astro.locals.candidate) {
  const next = Astro.url.searchParams.get("next");
  if (next && next.startsWith("/") && !next.startsWith("//")) return Astro.redirect(next);
  return Astro.redirect("/minha-conta");
}

const status = Astro.url.searchParams.get("status");
const motivo = Astro.url.searchParams.get("motivo");
const next = Astro.url.searchParams.get("next");
const safeNext = next && next.startsWith("/") && !next.startsWith("//") ? next : "";
---
<BaseLayout title="Entrar — Empregos São Luís">
  <section class="mx-auto max-w-lg px-4 py-16">
    <h1 class="text-4xl font-black">Entrar na sua conta</h1>
    <p class="mt-4 text-[var(--es-muted)]">Enviaremos um link seguro para seu e-mail. Não é necessário criar senha.</p>
    {motivo === "salvar-vaga" && (
      <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm font-semibold text-amber-950">
        Para salvar esta vaga, entre com seu e-mail. Depois você volta para a vaga automaticamente.
      </p>
    )}
    {status === "verifique-email" && (
      <p class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-900">
        Se o e-mail existir, enviamos o link de acesso. Confira sua caixa de entrada.
      </p>
    )}
    <form class="mt-8 grid gap-4 rounded-2xl border bg-white p-6" method="post" action="/api/account/request-link">
      {safeNext && <input type="hidden" name="next" value={safeNext} />}
      <label class="grid gap-1 text-sm font-semibold">Nome<input class="rounded-xl border p-3" name="name" maxlength="120" /></label>
      <label class="grid gap-1 text-sm font-semibold">E-mail<input class="rounded-xl border p-3" type="email" name="email" required /></label>
      <button class="rounded-xl bg-red-700 p-3 font-bold text-white" type="submit">Enviar link de acesso</button>
    </form>
  </section>
</BaseLayout>
