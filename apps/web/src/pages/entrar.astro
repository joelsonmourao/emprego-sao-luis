---
import BaseLayout from "../layouts/BaseLayout.astro"; if (Astro.locals.candidate) return Astro.redirect("/minha-conta");
---
<BaseLayout title="Entrar — Empregos São Luís"><section class="mx-auto max-w-lg px-4 py-16"><h1 class="text-4xl font-black">Entrar na sua conta</h1><p class="mt-4">Enviaremos um link seguro para seu e-mail. Não é necessário criar senha.</p><form class="mt-8 grid gap-4 rounded-2xl border bg-white p-6" method="post" action="/api/account/request-link"><label>Nome<input class="mt-1 w-full rounded-xl border p-3" name="name" maxlength="120"/></label><label>E-mail<input class="mt-1 w-full rounded-xl border p-3" type="email" name="email" required/></label><button class="rounded-xl bg-red-700 p-3 font-bold text-white">Enviar link de acesso</button></form></section></BaseLayout>
