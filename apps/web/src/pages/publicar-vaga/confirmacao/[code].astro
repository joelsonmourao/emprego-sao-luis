---
import { jobBoardPublicGate } from "../../../lib/job-board-gate";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getOrderByCode } from "../../../lib/commercial";

const gate = await jobBoardPublicGate();
if (gate.paused) return Astro.rewrite("/quadro-pausado");
const { code } = Astro.params;
const data = code ? await getOrderByCode(code) : null;
if (!data) return Astro.redirect("/publicar-vaga", 302);
const { order, plan, remaining } = data;
const paid = order.status === "PAID";
const manualReview = order.status === "MANUAL_REVIEW";
const pending = order.status === "PENDING_PAYMENT";
---
<BaseLayout title={`Confirmação ${order.orderCode}`} description="Status do pedido e próximos passos." canonical={`/publicar-vaga/confirmacao/${order.orderCode}`}>
  <section class="es-section">
    <div class="es-container max-w-2xl">
      <p class="es-kicker">Pedido {order.orderCode}</p>
      {paid ? (
        <>
          <h1 class="font-display mt-2 text-4xl font-black">Pagamento confirmado</h1>
          <p class="mt-3 text-[var(--text-secondary)]">Seu plano <strong>{plan?.name}</strong> foi liberado. Cadastre a vaga quando estiver pronto.</p>
          {remaining > 0 ? (
            <a class="es-btn es-btn-primary mt-8" href={`/publicar-vaga/cadastro?pedido=${order.orderCode}`}>Cadastrar vaga</a>
          ) : (
            <p class="mt-6 text-sm text-[var(--text-secondary)]">Créditos em processamento. Atualize esta página em instantes.</p>
          )}
        </>
      ) : manualReview ? (
        <>
          <h1 class="font-display mt-2 text-4xl font-black">Comprovante recebido</h1>
          <p class="mt-3 text-[var(--text-secondary)]">Recebemos seu comprovante PIX para o plano <strong>{plan?.name}</strong>. A liberação ocorre após revisão manual da equipe.</p>
          <div class="es-card mt-8 rounded-2xl p-6">
            <p class="text-sm text-[var(--text-secondary)]">Valor: <strong>R$ {Number(order.amount).toFixed(2).replace(".", ",")}</strong></p>
            <p class="mt-2 text-sm">Você receberá confirmação por e-mail em <strong>{order.email}</strong> quando o crédito for liberado.</p>
          </div>
          <a class="es-btn es-btn-secondary mt-6" href="/contato">Falar com o comercial</a>
        </>
      ) : pending ? (
        <>
          <h1 class="font-display mt-2 text-4xl font-black">Pagamento pendente</h1>
          <p class="mt-3 text-[var(--text-secondary)]">O pedido <strong>{order.orderCode}</strong> ainda aguarda pagamento.</p>
          <a class="es-btn es-btn-primary mt-8" href={`/publicar-vaga/pedido/${order.orderCode}`}>Ir para pagamento</a>
        </>
      ) : (
        <>
          <h1 class="font-display mt-2 text-4xl font-black">Pedido registrado</h1>
          <p class="mt-3 text-[var(--text-secondary)]">Status atual: <strong>{order.status}</strong>. Entre em contato se precisar de ajuda.</p>
          <a class="es-btn es-btn-secondary mt-8" href="/contato">Falar com o comercial</a>
        </>
      )}
    </div>
  </section>
</BaseLayout>
