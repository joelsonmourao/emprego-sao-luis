---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getOrderByCode, getPaymentSettings } from "../../../lib/commercial";
import { getConfiguredGateway, isPaymentAvailable } from "../../../lib/payments/gateway";

const { code } = Astro.params;
const data = code ? await getOrderByCode(code) : null;
if (!data) return Astro.redirect("/publicar-vaga", 302);

const { order, plan, remaining } = data;
const paymentAvailable = await isPaymentAvailable();
const paymentSettings = await getPaymentSettings();
const gateway = getConfiguredGateway();
const manualPix = paymentSettings.manualPixEnabled && paymentSettings.manualPixKey.trim();
const gatewayReady = gateway?.provider === "mercadopago";

if (order.status === "PAID" && remaining > 0) {
  return Astro.redirect(`/publicar-vaga/cadastro?pedido=${order.orderCode}`, 302);
}
if (order.status === "MANUAL_REVIEW" || order.status === "PAID") {
  return Astro.redirect(`/publicar-vaga/confirmacao/${order.orderCode}`, 302);
}

const proofError = Astro.url.searchParams.get("proof");
---
<BaseLayout title={`Pedido ${order.orderCode}`} description="Acompanhe pagamento e liberação de crédito." canonical={`/publicar-vaga/pedido/${order.orderCode}`}>
  <section class="es-section">
    <div class="es-container max-w-2xl">
      <p class="es-kicker">Etapa 4 de 4</p>
      <h1 class="font-display mt-2 text-4xl font-black">Pagamento do pedido</h1>
      <p class="mt-3 text-[var(--text-secondary)]">Pedido <strong>{order.orderCode}</strong> · {plan?.name}</p>
      <p class="mt-2 text-2xl font-black text-[var(--brand-primary)]">R$ {Number(order.amount).toFixed(2).replace(".", ",")}</p>

      <div class="es-card mt-8 rounded-2xl p-6">
        <p class="text-sm text-[var(--text-secondary)]">Status: <strong>{order.status}</strong></p>

        {order.status === "PENDING_PAYMENT" && gatewayReady && (
          <form class="mt-4" method="post" action="/api/commercial/pay">
            <input type="hidden" name="orderCode" value={order.orderCode} />
            <button class="es-btn es-btn-primary" type="submit">Pagar com Mercado Pago</button>
          </form>
        )}

        {order.status === "PENDING_PAYMENT" && manualPix && (
          <div class="mt-6 grid gap-4 border-t border-[var(--brand-border)] pt-6">
            <h2 class="font-display text-lg font-black">PIX manual</h2>
            <p class="text-sm text-[var(--text-secondary)]">{paymentSettings.manualPixInstructions}</p>
            <dl class="grid gap-2 text-sm">
              <div><dt class="text-[var(--text-secondary)]">Chave PIX</dt><dd class="font-mono font-semibold">{paymentSettings.manualPixKey}</dd></div>
              {paymentSettings.manualPixHolder && <div><dt class="text-[var(--text-secondary)]">Titular</dt><dd class="font-semibold">{paymentSettings.manualPixHolder}</dd></div>}
              <div><dt class="text-[var(--text-secondary)]">Valor</dt><dd class="font-semibold">R$ {Number(order.amount).toFixed(2).replace(".", ",")}</dd></div>
            </dl>
            {paymentSettings.manualPixQrUrl && (
              <img class="mx-auto max-w-xs rounded-xl border border-[var(--brand-border)]" src={paymentSettings.manualPixQrUrl} alt="QR Code PIX" width="280" height="280" loading="lazy" />
            )}
            <form class="grid gap-3" method="post" action="/api/commercial/manual-proof" enctype="multipart/form-data">
              <input type="hidden" name="orderCode" value={order.orderCode} />
              <label class="grid gap-1 text-sm font-semibold">
                URL do comprovante
                <input class="rounded-xl border border-[var(--brand-border)] px-3 py-2.5" type="url" name="proofUrl" required placeholder="https://..." maxlength="500" />
              </label>
              <p class="text-xs text-[var(--text-secondary)]">Cole o link do comprovante (Google Drive, Dropbox ou outro serviço com acesso liberado).</p>
              <button class="es-btn es-btn-secondary" type="submit">Enviar comprovante</button>
            </form>
            {proofError === "invalido" && <p class="text-sm text-red-700">Informe uma URL válida para o comprovante.</p>}
            {proofError === "erro" && <p class="text-sm text-red-700">Não foi possível enviar o comprovante. Tente novamente.</p>}
          </div>
        )}

        {order.status === "PENDING_PAYMENT" && !paymentAvailable && (
          <div class="mt-4 grid gap-3">
            <p class="rounded-xl border border-yellow-200 bg-yellow-50 p-3 text-sm text-yellow-900">Pagamento temporariamente indisponível. Não liberamos vagas automaticamente sem confirmação.</p>
            <a class="es-btn es-btn-secondary" href={`/contato?assunto=Pagamento+pedido+${order.orderCode}`}>Falar com o comercial</a>
          </div>
        )}

        {order.status === "PENDING_PAYMENT" && paymentAvailable && !gatewayReady && !manualPix && (
          <p class="mt-4 text-sm text-[var(--text-secondary)]">Nenhum método de pagamento configurado no momento.</p>
        )}

        {order.status !== "PENDING_PAYMENT" && (
          <p class="mt-4 text-sm">Aguarde a confirmação ou acesse o cadastro quando o crédito estiver liberado.</p>
        )}

        <a class="mt-6 block text-center text-sm text-[var(--text-secondary)] underline" href={`/publicar-vaga/resumo/${order.orderCode}`}>Voltar ao resumo</a>
      </div>
    </div>
  </section>
</BaseLayout>
