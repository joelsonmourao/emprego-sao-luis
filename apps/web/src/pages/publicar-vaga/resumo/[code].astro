---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getOrderByCode } from "../../../lib/commercial";

const { code } = Astro.params;
const data = code ? await getOrderByCode(code) : null;
if (!data) return Astro.redirect("/publicar-vaga", 302);

const { order, plan } = data;
if (order.status === "PAID") {
  return Astro.redirect(`/publicar-vaga/confirmacao/${order.orderCode}`, 302);
}
if (order.status !== "PENDING_PAYMENT") {
  return Astro.redirect(`/publicar-vaga/confirmacao/${order.orderCode}`, 302);
}
---
<BaseLayout title={`Resumo do pedido ${order.orderCode}`} description="Revise os dados antes do pagamento." canonical={`/publicar-vaga/resumo/${order.orderCode}`} noindex>
  <section class="es-section">
    <div class="es-container max-w-2xl">
      <p class="es-kicker">Etapa 3 de 4</p>
      <h1 class="font-display mt-2 text-4xl font-black">Resumo do pedido</h1>
      <p class="mt-3 text-[var(--text-secondary)]">Confira os dados antes de seguir para o pagamento.</p>

      <div class="es-card mt-8 grid gap-6 rounded-2xl p-6">
        <div>
          <h2 class="font-display text-lg font-black">Plano</h2>
          <p class="mt-1 font-semibold">{plan?.name}</p>
          <p class="mt-1 text-sm text-[var(--text-secondary)]">{plan?.description}</p>
          <p class="mt-3 text-2xl font-black text-[var(--brand-primary)]">R$ {Number(order.amount).toFixed(2).replace(".", ",")}</p>
        </div>

        <div class="border-t border-[var(--brand-border)] pt-6">
          <h2 class="font-display text-lg font-black">Empresa</h2>
          <dl class="mt-3 grid gap-2 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-[var(--text-secondary)]">Pedido</dt><dd class="font-semibold">{order.orderCode}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-[var(--text-secondary)]">Empresa</dt><dd class="font-semibold">{order.companyName}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-[var(--text-secondary)]">Responsável</dt><dd class="font-semibold">{order.contactName}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-[var(--text-secondary)]">E-mail</dt><dd class="font-semibold">{order.email}</dd></div>
            {order.whatsapp && <div class="flex justify-between gap-4"><dt class="text-[var(--text-secondary)]">WhatsApp</dt><dd class="font-semibold">{order.whatsapp}</dd></div>}
            {order.cnpj && <div class="flex justify-between gap-4"><dt class="text-[var(--text-secondary)]">CNPJ</dt><dd class="font-semibold">{order.cnpj}</dd></div>}
            <div class="flex justify-between gap-4"><dt class="text-[var(--text-secondary)]">Cidade</dt><dd class="font-semibold">{order.city}</dd></div>
          </dl>
        </div>

        <div class="grid gap-3 border-t border-[var(--brand-border)] pt-6">
          <a class="es-btn es-btn-primary" href={`/publicar-vaga/pedido/${order.orderCode}`}>Continuar para pagamento</a>
          <a class="text-center text-sm text-[var(--text-secondary)] underline" href="/contato">Preciso de ajuda</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
