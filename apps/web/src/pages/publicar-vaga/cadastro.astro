---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getOrderByCode } from "../../lib/commercial";

const orderCode = Astro.url.searchParams.get("pedido");
const data = orderCode ? await getOrderByCode(orderCode) : null;
if (!data || data.order.status !== "PAID" || data.remaining <= 0) {
  return Astro.redirect("/publicar-vaga", 302);
}
---
<BaseLayout title="Cadastrar vaga — Empregos São Luís" description="Cadastre sua vaga após confirmação do pagamento." canonical="/publicar-vaga/cadastro">
  <section class="es-section">
    <div class="es-container max-w-2xl">
      <p class="es-kicker">Etapa 4 de 4</p>
      <h1 class="font-display mt-2 text-4xl font-black">Cadastro da vaga</h1>
      <p class="mt-3 text-[var(--text-secondary)]">Créditos disponíveis: <strong>{data.remaining}</strong> · Pedido {data.order.orderCode}</p>
      <div class="es-card mt-8 rounded-2xl p-6">
        <p class="text-sm text-[var(--text-secondary)]">Após enviar, a vaga entra em <strong>revisão administrativa</strong> antes da publicação (padrão seguro).</p>
        <form class="es-light-form-panel mt-5 grid gap-4" method="post" action="/api/commercial/job-draft">
          <input type="hidden" name="orderCode" value={data.order.orderCode} />
          <label class="grid gap-1 text-sm font-semibold">Título da vaga<input class="rounded-xl border border-[var(--brand-border)] px-3 py-2.5" name="jobTitle" required maxlength="180" /></label>
          <label class="grid gap-1 text-sm font-semibold">Descrição<textarea class="min-h-32 rounded-xl border border-[var(--brand-border)] px-3 py-2.5" name="description" required maxlength="8000"></textarea></label>
          <label class="grid gap-1 text-sm font-semibold">Link de candidatura<input class="rounded-xl border border-[var(--brand-border)] px-3 py-2.5" type="url" name="applyUrl" required maxlength="500" /></label>
          <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="termsAccepted" value="1" required /><span>Confirmo que as informações são verdadeiras e aceito os termos para anunciantes.</span></label>
          <button class="es-btn es-btn-primary" type="submit">Enviar para revisão</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
