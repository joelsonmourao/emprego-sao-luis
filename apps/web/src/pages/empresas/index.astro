---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import PageHero from "../../components/ui/PageHero.astro";
import { companies, createDatabase, jobs } from "@es/db";
import { and, asc, count, eq, gt } from "drizzle-orm";

let rows: Array<{ name: string; slug: string; logo: string | null; total: number }> = [];
if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    const listed = await connection.db
      .select({ name: companies.name, slug: companies.slug, logo: companies.logoUrl, total: count(jobs.id) })
      .from(companies)
      .innerJoin(jobs, and(eq(jobs.companyId, companies.id), eq(jobs.publicationStatus, "PUBLISHED"), gt(jobs.expiresAt, new Date())))
      .where(eq(companies.active, true))
      .groupBy(companies.id)
      .orderBy(asc(companies.name));
    rows = listed.filter((item) => item.total > 0);
  } finally {
    await connection.close();
  }
}
---
<BaseLayout title="Empresas com vagas — Empregos São Luís" description="Conheça empresas e consulte oportunidades abertas em São Luís e no Maranhão." breadcrumbs={[{ name: "Empresas", url: "/empresas" }]} pageSchemaType="CollectionPage" noindex={rows.length === 0}>
  <PageHero kicker="Empresas" title="Empresas que contratam na região" description="Consulte perfis e vagas abertas com fonte identificada." pattern={false} />
  <section class="es-section pt-0">
    <div class="es-container">
      <Breadcrumbs items={[{ name: "Início", url: "/" }, { name: "Empresas" }]} />
      {rows.length ? (
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {rows.map((item) => (
            <article class="es-card p-6">
              <div class="flex items-center gap-4">
                {item.logo ? <img src={item.logo} alt="" class="h-14 w-14 rounded-2xl border object-contain p-1" width="56" height="56" loading="lazy" /> : <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[var(--es-cream-dark)] text-lg font-black text-[var(--brand-primary)]">{item.name.slice(0, 1)}</div>}
                <div>
                  <h2 class="font-display text-xl font-black"><a href={`/empresas/${item.slug}`}>{item.name}</a></h2>
                  <p class="text-sm text-[var(--es-muted)]">{item.total} vaga(s) ativa(s)</p>
                </div>
              </div>
              <a class="es-btn es-btn-secondary mt-5 w-full" href={`/empresas/${item.slug}`}>Ver empresa</a>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-8"><EmptyState title="Nenhuma empresa pública" description="As empresas cadastradas aparecerão aqui com suas vagas ativas." actionHref="/vagas" actionLabel="Ver vagas" /></div>
      )}
    </div>
  </section>
</BaseLayout>
