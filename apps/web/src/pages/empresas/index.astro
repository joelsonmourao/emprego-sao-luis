---
import BaseLayout from "../../layouts/BaseLayout.astro";import{companies,createDatabase,jobs}from"@es/db";import{and,asc,count,eq,gt}from"drizzle-orm";let rows:Array<{name:string;slug:string;logo:string|null;description:string|null;total:number}>=[];if(process.env.DATABASE_URL){const connection=createDatabase(process.env.DATABASE_URL);try{rows=await connection.db.select({name:companies.name,slug:companies.slug,logo:companies.logoUrl,description:companies.descriptionHtml,total:count(jobs.id)}).from(companies).leftJoin(jobs,and(eq(jobs.companyId,companies.id),eq(jobs.publicationStatus,"PUBLISHED"),gt(jobs.expiresAt,new Date()))).where(eq(companies.active,true)).groupBy(companies.id).orderBy(asc(companies.name));}finally{await connection.close();}}
---
<BaseLayout title="Empresas com vagas — Empregos São Luís"><section class="mx-auto max-w-6xl px-4 py-12"><nav class="text-sm text-slate-600"><a href="/">Início</a> / Empresas</nav><h1 class="mt-4 text-4xl font-black">Empresas</h1><p class="mt-4">Conheça empresas e consulte oportunidades abertas.</p>{rows.length?<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{rows.map((item)=><article class="rounded-2xl border bg-white p-6"><h2 class="text-xl font-black"><a href={`/empresas/${item.slug}`}>{item.name}</a></h2><p class="mt-2 text-sm text-slate-600">{item.total} vaga(s) ativa(s)</p><a class="mt-4 inline-flex font-bold text-red-700" href={`/empresas/${item.slug}`}>Ver empresa →</a></article>)}</div>:<p class="mt-8 rounded-xl border bg-white p-6">Nenhuma empresa pública cadastrada.</p>}</section></BaseLayout>
