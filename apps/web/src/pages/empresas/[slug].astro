---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import JobCard from "../../components/ui/JobCard.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { cities, companies, createDatabase, jobs, states } from "@es/db";
import { and, desc, eq, gt } from "drizzle-orm";

const slug = Astro.params.slug ?? "";
let company;
let vacancies: Array<{
  id: string; title: string; slug: string; code: string; city: string; state: string; workplace: string;
  contract: string; publishedAt: Date | null; logoUrl: string | null;
}> = [];

if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    [company] = await connection.db.select().from(companies).where(and(eq(companies.slug, slug), eq(companies.active, true))).limit(1);
    if (company) {
      vacancies = await connection.db
        .select({
          id: jobs.id, title: jobs.normalizedTitle, slug: jobs.slug, code: jobs.publicCode,
          city: cities.name, state: states.code, workplace: jobs.workplaceType, contract: jobs.employmentType,
          publishedAt: jobs.publishedAt, logoUrl: companies.logoUrl
        })
        .from(jobs)
        .innerJoin(cities, eq(jobs.cityId, cities.id))
        .innerJoin(states, eq(jobs.stateId, states.id))
        .innerJoin(companies, eq(jobs.companyId, companies.id))
        .where(and(eq(jobs.companyId, company.id), eq(jobs.publicationStatus, "PUBLISHED"), gt(jobs.expiresAt, new Date())))
        .orderBy(desc(jobs.publishedAt))
        .limit(50);
    }
  } finally {
    await connection.close();
  }
}
if (!company) {
  return new Response("Empresa não encontrada", {
    status: 404,
    headers: { "Content-Type": "text/plain; charset=utf-8", "X-Robots-Tag": "noindex, follow" }
  });
}
---
<BaseLayout title={company.seoTitle ?? `${company.name} — vagas e informações`} description={company.metaDescription ?? `Consulte vagas abertas na ${company.name}.`} breadcrumbs={[{ name: "Empresas", url: "/empresas" }, { name: company.name, url: `/empresas/${company.slug}` }]}>
  <section class="es-section bg-white">
    <div class="es-container">
      <Breadcrumbs items={[{ name: "Início", url: "/" }, { name: "Empresas", url: "/empresas" }, { name: company.name }]} />
      <div class="mt-6 flex flex-wrap items-start gap-5">
        {company.logoUrl && <img class="h-24 w-24 rounded-2xl border object-contain p-2" src={company.logoUrl} alt={`Logo ${company.name}`} width="96" height="96" />}
        <div>
          <h1 class="font-display text-4xl font-black">{company.name}</h1>
          {company.verifiedAt && <p class="mt-2 inline-flex rounded-full bg-[color-mix(in_srgb,var(--es-green)_12%,white)] px-3 py-1 text-sm font-bold text-[var(--es-green)]">Empresa verificada</p>}
        </div>
      </div>
      {company.descriptionHtml && <section class="es-prose mt-8 max-w-3xl" set:html={company.descriptionHtml} />}
      <section class="mt-10">
        <SectionHeading title="Vagas abertas" description={`${vacancies.length} oportunidade(s) ativa(s) nesta empresa.`} />
        {vacancies.length ? (
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {vacancies.map((job) => <JobCard {...job} company={company.name} compact />)}
          </div>
        ) : (
          <p class="mt-5 es-card p-5 text-[var(--es-muted)]">Nenhuma vaga ativa desta empresa no momento.</p>
        )}
      </section>
    </div>
  </section>
</BaseLayout>
