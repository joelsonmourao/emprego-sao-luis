---
import BaseLayout from "../../layouts/BaseLayout.astro";import{cities,companies,createDatabase,jobs,states}from"@es/db";import{and,desc,eq,gt}from"drizzle-orm";const slug=Astro.params.slug??"";let company;let vacancies:Array<{title:string;slug:string;code:string;city:string;state:string}>=[];if(process.env.DATABASE_URL){const connection=createDatabase(process.env.DATABASE_URL);try{[company]=await connection.db.select().from(companies).where(and(eq(companies.slug,slug),eq(companies.active,true))).limit(1);if(company)vacancies=await connection.db.select({title:jobs.normalizedTitle,slug:jobs.slug,code:jobs.publicCode,city:cities.name,state:states.code}).from(jobs).innerJoin(cities,eq(jobs.cityId,cities.id)).innerJoin(states,eq(jobs.stateId,states.id)).where(and(eq(jobs.companyId,company.id),eq(jobs.publicationStatus,"PUBLISHED"),gt(jobs.expiresAt,new Date()))).orderBy(desc(jobs.publishedAt)).limit(50);}finally{await connection.close();}}if(!company)return Astro.redirect("/empresas",302);
---
<BaseLayout title={company.seoTitle??`${company.name} — vagas e informações`} description={company.metaDescription??`Consulte vagas abertas na ${company.name}.`}><section class="mx-auto max-w-5xl px-4 py-12"><nav class="text-sm text-slate-600"><a href="/">Início</a> / <a href="/empresas">Empresas</a> / {company.name}</nav><div class="mt-6 flex items-start gap-5">{company.logoUrl&&<img class="h-20 w-20 rounded-xl object-contain" src={company.logoUrl} alt={`Logo ${company.name}`}/>}<div><h1 class="text-4xl font-black">{company.name}</h1>{company.verifiedAt&&<p class="mt-2 font-bold text-emerald-700">Empresa verificada</p>}</div></div>{company.descriptionHtml&&<section class="prose mt-8" set:html={company.descriptionHtml}/>}<h2 class="mt-10 text-2xl font-black">Vagas abertas</h2>{vacancies.length?<div class="mt-5 grid gap-3">{vacancies.map((job)=><a class="rounded-xl border bg-white p-5" href={`/vagas/${job.slug}`}><strong>{job.title}</strong><span class="mt-1 block text-sm text-slate-600">{job.code} · {job.city}/{job.state}</span></a>)}</div>:<p class="mt-5 rounded-xl border bg-white p-5">Nenhuma vaga ativa desta empresa no momento.</p>}</section></BaseLayout>
