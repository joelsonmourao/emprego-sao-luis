---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createDatabase, webStories } from "@es/db";
import { and, eq, gt, or, isNull } from "drizzle-orm";
import { getRuntimeSiteUrl, resolveCanonicalUrl } from "../../lib/canonical-url";

const slug = Astro.params.slug ?? "";
let story: typeof webStories.$inferSelect | null = null;
if (process.env.DATABASE_URL && slug) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    const now = new Date();
    const [row] = await connection.db
      .select()
      .from(webStories)
      .where(
        and(
          eq(webStories.slug, slug),
          eq(webStories.status, "PUBLISHED"),
          or(isNull(webStories.expiresAt), gt(webStories.expiresAt, now))
        )
      )
      .limit(1);
    story = row ?? null;
  } finally {
    await connection.close();
  }
}
if (!story) {
  return new Response("Web Story não encontrada", {
    status: 404,
    headers: { "Content-Type": "text/plain; charset=utf-8", "X-Robots-Tag": "noindex, follow" }
  });
}
const pages = Array.isArray(story.pages) ? story.pages : [];
const canonical = resolveCanonicalUrl(
  story.canonicalUrl ?? undefined,
  `/web-stories/${story.slug}`,
  getRuntimeSiteUrl(Astro.site)
);
---
<BaseLayout
  title={story.seoTitle || `${story.title} — Web Story`}
  description={story.metaDescription || story.title}
  canonical={canonical}
  noindex={false}
>
  <section class="es-section">
    <div class="es-container max-w-3xl">
      <p class="es-kicker">Web Story</p>
      <h1 class="font-display mt-2 text-4xl font-black">{story.title}</h1>
      <p class="mt-3 text-sm text-[var(--es-muted)]">Narrativa própria com revisão editorial. Não é publicação automática nem cópia de Instagram.</p>
      {story.posterUrl && (
        <img class="mt-6 w-full rounded-2xl object-cover" src={story.posterUrl} alt={story.posterAlt ?? story.title} />
      )}
      <ol class="mt-8 grid gap-4">
        {pages.map((page: any) => (
          <li class="rounded-2xl border border-[var(--es-border)] bg-white p-5">
            <p class="text-xs font-bold uppercase text-[var(--es-muted)]">Página {page.order}</p>
            <h2 class="font-display mt-1 text-2xl font-black">{page.headline}</h2>
            {page.body && <p class="mt-3 text-[var(--es-muted)]">{page.body}</p>}
            {page.imageUrl && <img class="mt-4 w-full rounded-xl" src={page.imageUrl} alt={page.imageAlt ?? page.headline} loading="lazy" />}
          </li>
        ))}
      </ol>
      {story.ctaUrl && (
        <a class="es-btn es-btn-primary mt-8 inline-flex" href={story.ctaUrl}>{story.ctaLabel || "Ler matéria completa"}</a>
      )}
    </div>
  </section>
</BaseLayout>
