---
import BaseLayout from "../layouts/BaseLayout.astro"; import { createDatabase, jobs, savedJobs, userJobPreferences } from "@es/db"; import { eq } from "drizzle-orm";
const candidate = Astro.locals.candidate; if (!candidate) return Astro.redirect("/entrar?next=/minha-conta"); let saved: Array<{ id:string; title:string; slug:string }> = []; let preferences = null; if (process.env.DATABASE_URL) { const connection = createDatabase(process.env.DATABASE_URL); try { saved = await connection.db.select({ id: jobs.id, title: jobs.normalizedTitle, slug: jobs.slug }).from(savedJobs).innerJoin(jobs, eq(savedJobs.jobId, jobs.id)).where(eq(savedJobs.userId, candidate.id)); [preferences] = await connection.db.select().from(userJobPreferences).where(eq(userJobPreferences.userId, candidate.id)).limit(1); } finally { await connection.close(); } }
---
<BaseLayout title="Minha conta — Empregos São Luís"><section class="mx-auto max-w-3xl px-4 py-12"><h1 class="text-4xl font-black">Minha conta</h1><p class="mt-2">{candidate.name} · {candidate.email}</p><h2 class="mt-10 text-2xl font-black">Vagas salvas</h2>{saved.length ? <ul class="mt-4 grid gap-3">{saved.map((job) => <li class="rounded-xl border bg-white p-4"><a class="font-bold" href={`/vagas/${job.slug}`}>{job.title}</a></li>)}</ul> : <p class="mt-3">Você ainda não salvou vagas.</p>}<h2 class="mt-10 text-2xl font-black">Privacidade</h2><div class="mt-4 flex flex-wrap gap-3"><a class="rounded-lg border px-4 py-2" href="/api/account/export">Exportar meus dados</a><form method="post" action="/api/account/logout"><button class="rounded-lg border px-4 py-2">Sair</button></form><form method="post" action="/api/account/delete" onsubmit="return confirm('Excluir e anonimizar sua conta?')"><input type="hidden" name="confirmation" value="EXCLUIR"/><button class="rounded-lg border border-red-300 px-4 py-2 text-red-700">Excluir conta</button></form></div>{preferences && <p class="mt-6 text-sm text-slate-500">Preferências de alerta configuradas.</p>}</section></BaseLayout>
