---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAdsenseReadiness } from "../../lib/adsense-readiness";

const baseUrl = new URL(process.env.SITE_URL ?? Astro.url.origin);
const report = await getAdsenseReadiness(baseUrl);
const tone =
  report.classification === "PRONTO PARA SOLICITAR ANÁLISE"
    ? "border-emerald-300 bg-emerald-50 text-emerald-950"
    : report.classification === "QUASE PRONTO"
      ? "border-amber-300 bg-amber-50 text-amber-950"
      : "border-rose-300 bg-rose-50 text-rose-950";
---
<AdminLayout title="Rota da Aprovação">
  <h1 class="text-3xl font-black">Rota da Aprovação</h1>
  <p class="mt-2 text-sm text-[var(--text-secondary)]">
    Evidências técnicas e editoriais para decidir se o site está preparado para solicitar análise do Google AdSense.
  </p>
  <aside class="mt-4 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950" role="note">
    <strong>AdSense no site público está desligado por padrão.</strong>
    <p class="mt-1">
      Esta página é o controle interno. Anúncios só aparecem no portal depois que você resolver os bloqueadores,
      tiver conteúdo editorial suficiente e definir <code class="rounded bg-white px-1">PUBLIC_ADSENSE_ENABLED=true</code> no Coolify
      com Publisher ID real. O candidato continua gratuito.
    </p>
    <p class="mt-2">
      Fluxo recomendado:
      <a class="font-bold underline" href="/admin/conteudo/pilares">Pilares</a> →
      <a class="font-bold underline" href="/admin/conteudo/post-magnetico">Post Magnético</a> →
      <a class="font-bold underline" href="/admin/web-stories">Web Stories</a> → checklist abaixo.
    </p>
  </aside>

  <section class={`mt-6 rounded-2xl border p-6 ${tone}`}>
    <p class="text-sm font-bold uppercase">Classificação interna</p>
    <strong class="mt-2 block text-3xl">{report.classification}</strong>
    <p class="mt-3 text-sm font-semibold">{report.disclaimer}</p>
    <p class="mt-2 text-xs">Gerado em {report.generatedAt.toLocaleString("pt-BR")}</p>
    {report.readyForRequest ? (
      <p class="mt-4 inline-flex rounded-lg bg-emerald-700 px-4 py-2 text-sm font-bold text-white">Pronto para solicitar análise (verificação interna)</p>
    ) : (
      <p class="mt-4 text-sm font-bold">Há bloqueadores ou pendências — não solicite revisão do AdSense ainda.</p>
    )}
  </section>

  <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-xl font-black">Meta editorial interna</h2>
    <p class="mt-2 text-sm text-[var(--text-secondary)]">
      O Google não publica quantidade mínima oficial. Internamente exigimos
      {report.editorialMeta.minPublished} posts com ≥{report.editorialMeta.minUsefulChars} caracteres úteis,
      autoria, fontes e pilar/cluster antes de marcar “Pronto para solicitar análise”.
    </p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <article>
        <p class="text-sm">Substanciais publicados</p>
        <strong class="text-3xl">{report.editorialMeta.substantialPublished}/{report.editorialMeta.minPublished}</strong>
      </article>
      <article>
        <p class="text-sm">Publicados (total)</p>
        <strong class="text-3xl">{report.editorialMeta.published}</strong>
      </article>
      <article>
        <p class="text-sm">Agendados</p>
        <strong class="text-3xl">{report.editorialMeta.scheduled}</strong>
      </article>
      <article>
        <p class="text-sm">Com capa completa</p>
        <strong class="text-3xl">{report.editorialMeta.withCover}/{report.editorialMeta.published}</strong>
      </article>
      <article>
        <p class="text-sm">Web Stories publicadas</p>
        <strong class="text-3xl">{report.editorialMeta.publishedStories}</strong>
      </article>
    </div>
    <p class="mt-4 text-sm">
      Seed: <code class="rounded bg-slate-100 px-1">npm run seed:adsense-editorial</code> (dry-run) ·
      <code class="rounded bg-slate-100 px-1">npm run seed:adsense-editorial -- --write</code> ·
      calendário em <a class="font-bold underline" href="/admin/calendario-editorial">/admin/calendario-editorial</a>.
    </p>
  </section>

  <div class="mt-6 grid gap-4 md:grid-cols-3">
    <article class="rounded-xl bg-white p-5"><p class="text-sm">Bloqueadores</p><strong class="text-3xl">{report.blockers.length}</strong></article>
    <article class="rounded-xl bg-white p-5"><p class="text-sm">Verificações</p><strong class="text-3xl">{report.checks.length}</strong></article>
    <article class="rounded-xl bg-white p-5"><p class="text-sm">Etapas</p><strong class="text-3xl">{report.stages.length}</strong></article>
  </div>

  {report.stages.map((stage) => (
    <section class="mt-8 overflow-x-auto rounded-2xl bg-white p-6">
      <h2 class="text-xl font-black">{stage.title}</h2>
      <table class="mt-4 min-w-full text-sm">
        <thead>
          <tr class="border-b text-left">
            <th class="p-3">Item</th>
            <th class="p-3">Severidade</th>
            <th class="p-3">Status</th>
            <th class="p-3">Evidência</th>
            <th class="p-3">Correção</th>
          </tr>
        </thead>
        <tbody>
          {stage.checks.map((check) => (
            <tr class="border-b align-top">
              <td class="p-3 font-bold">{check.label}</td>
              <td class="p-3">{check.severity}</td>
              <td class="p-3 font-black">{check.status}</td>
              <td class="max-w-xl p-3">{check.evidence}</td>
              <td class="p-3">
                {check.action ? <a class="font-bold text-red-700 underline" href={check.action}>Resolver</a> : "—"}
                {check.autoFixAvailable ? <span class="mt-1 block text-xs">Correção automática disponível</span> : null}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}

  <aside class="mt-6 rounded-xl border border-sky-200 bg-sky-50 p-5 text-sm text-sky-950">
    <strong>Aviso obrigatório</strong>
    <p class="mt-2">{report.disclaimer}</p>
    <p class="mt-2">Publisher ID, dados jurídicos e responsável LGPD devem ser preenchidos com valores reais no painel — o sistema não inventa credenciais.</p>
  </aside>
</AdminLayout>
