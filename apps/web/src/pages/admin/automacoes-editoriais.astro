---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { can } from "../../lib/auth";

const auth = Astro.locals.auth!;
if (!can(auth, "queues.manage")) return Astro.redirect("/admin?error=sem-permissao");
---
<AdminLayout title="Automações editoriais">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-red-700">Operação</p>
      <h1 class="mt-2 text-3xl font-black">Automações editoriais</h1>
      <p class="mt-2 text-sm text-[var(--text-secondary)]">
        Worker processa filas de publicação agendada, importação e monitoramentos. IA pode auxiliar; nunca publica sozinha.
      </p>
    </div>
    <a class="rounded-lg border px-4 py-2 font-bold" href="/admin/operacao">Filas e jobs</a>
  </div>
  <section class="mt-8 grid gap-4 md:grid-cols-2">
    <article class="rounded-2xl bg-white p-5">
      <h2 class="font-black">Publicação agendada</h2>
      <p class="mt-2 text-sm text-slate-600">Conteúdos e vagas com data futura entram na fila do worker.</p>
      <a class="mt-4 inline-block text-sm font-bold text-red-700" href="/admin/calendario-editorial">Ver calendário</a>
    </article>
    <article class="rounded-2xl bg-white p-5">
      <h2 class="font-black">Importação assistida</h2>
      <p class="mt-2 text-sm text-slate-600">Lotes com mapeamento, validação e aprovação em lote de alta confiança.</p>
      <a class="mt-4 inline-block text-sm font-bold text-red-700" href="/admin/vagas/importar">Abrir importação</a>
    </article>
    <article class="rounded-2xl bg-white p-5">
      <h2 class="font-black">Monitor de candidaturas</h2>
      <p class="mt-2 text-sm text-slate-600">Eventos de clique/canal sem cobrança ao candidato.</p>
      <a class="mt-4 inline-block text-sm font-bold text-red-700" href="/admin/vagas/monitor-candidaturas">Abrir monitor</a>
    </article>
    <article class="rounded-2xl bg-white p-5">
      <h2 class="font-black">Indexação</h2>
      <p class="mt-2 text-sm text-slate-600">Eventos de indexação e retries na operação. Não acionar Indexing API em produção daqui.</p>
      <a class="mt-4 inline-block text-sm font-bold text-red-700" href="/admin/operacao">Ver operação</a>
    </article>
  </section>
</AdminLayout>
