---
import AdminLayout from"../../layouts/AdminLayout.astro";import{categories,createDatabase,jobs}from"@es/db";import{asc,count,eq}from"drizzle-orm";import{can}from"../../lib/auth";const auth=Astro.locals.auth!;if(!can(auth,"settings.manage"))return new Response("Proibido",{status:403});let rows:Array<{id:string;name:string;slug:string;active:boolean;jobs:number}>=[];if(process.env.DATABASE_URL){const connection=createDatabase(process.env.DATABASE_URL);try{rows=await connection.db.select({id:categories.id,name:categories.name,slug:categories.slug,active:categories.active,jobs:count(jobs.id)}).from(categories).leftJoin(jobs,eq(jobs.categoryId,categories.id)).groupBy(categories.id).orderBy(asc(categories.name));}finally{await connection.close();}}
---
<AdminLayout title="Categorias"><h1 class="text-3xl font-black">Categorias</h1><div class="mt-6 grid gap-6 lg:grid-cols-2"><form class="grid gap-4 rounded-2xl bg-white p-6" method="post" action="/api/admin/categories"><h2 class="text-xl font-black">Cadastrar</h2><label>Nome<input class="mt-1 w-full rounded-lg border p-3" name="name" required/></label><label>Slug<input class="mt-1 w-full rounded-lg border p-3" name="slug" required/></label><button class="rounded-lg bg-red-700 p-3 font-bold text-white">Cadastrar categoria</button></form><form class="grid gap-4 rounded-2xl border border-amber-300 bg-amber-50 p-6" method="post" action="/api/admin/categories/merge"><h2 class="text-xl font-black">Mesclar duplicadas</h2><label>Categoria principal<select class="mt-1 w-full rounded-lg border p-3" name="primaryId">{rows.filter((item)=>item.active).map((item)=><option value={item.id}>{item.name}</option>)}</select></label><label>Categoria duplicada<select class="mt-1 w-full rounded-lg border p-3" name="duplicateId">{rows.filter((item)=>item.active).map((item)=><option value={item.id}>{item.name}</option>)}</select></label><button class="rounded-lg bg-amber-700 p-3 font-bold text-white">Confirmar mesclagem</button></form></div><div class="mt-6 rounded-2xl bg-white"><table class="w-full"><thead><tr class="border-b text-left"><th class="p-4">Categoria</th><th class="p-4">Slug</th><th class="p-4">Vagas</th><th class="p-4">Status</th></tr></thead><tbody>{rows.map((item)=><tr class="border-b"><td class="p-4 font-bold"><a href={`/categorias/${item.slug}`} target="_blank">{item.name}</a></td><td class="p-4 font-mono">{item.slug}</td><td class="p-4">{item.jobs}</td><td class="p-4">{item.active?"Ativa":"Arquivada"}</td></tr>)}</tbody></table></div></AdminLayout>
