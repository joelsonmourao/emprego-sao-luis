---
import AdminLayout from"../../layouts/AdminLayout.astro";import{companies,createDatabase,jobs}from"@es/db";import{asc,count,eq}from"drizzle-orm";import{can}from"../../lib/auth";const auth=Astro.locals.auth!;if(!can(auth,"companies.manage"))return new Response("Proibido",{status:403});let rows:Array<{id:string;name:string;slug:string;websiteUrl:string|null;active:boolean;jobs:number}>=[];if(process.env.DATABASE_URL){const connection=createDatabase(process.env.DATABASE_URL);try{rows=await connection.db.select({id:companies.id,name:companies.name,slug:companies.slug,websiteUrl:companies.websiteUrl,active:companies.active,jobs:count(jobs.id)}).from(companies).leftJoin(jobs,eq(jobs.companyId,companies.id)).groupBy(companies.id).orderBy(asc(companies.name));}finally{await connection.close();}}
---
<AdminLayout title="Empresas"><h1 class="text-3xl font-black">Empresas</h1><div class="mt-6 grid gap-6 lg:grid-cols-2"><form class="grid gap-4 rounded-2xl bg-white p-6" method="post" action="/api/admin/companies"><h2 class="text-xl font-black">Cadastrar</h2><label>Nome<input class="mt-1 w-full rounded-lg border p-3" name="name" required/></label><label>Slug<input class="mt-1 w-full rounded-lg border p-3" name="slug" required/></label><label>Site<input class="mt-1 w-full rounded-lg border p-3" type="url" name="websiteUrl"/></label><label>Logo<input class="mt-1 w-full rounded-lg border p-3" type="url" name="logoUrl"/></label><label>Descrição<textarea class="mt-1 w-full rounded-lg border p-3" name="description"></textarea></label><button class="rounded-lg bg-red-700 p-3 font-bold text-white">Cadastrar empresa</button></form><form class="grid gap-4 rounded-2xl border border-amber-300 bg-amber-50 p-6" method="post" action="/api/admin/companies/merge"><h2 class="text-xl font-black">Mesclar duplicadas</h2><p class="text-sm">Vagas são movidas, a duplicada é arquivada e o slug recebe redirecionamento 301.</p><label>Empresa principal<select class="mt-1 w-full rounded-lg border p-3" name="primaryId">{rows.filter((item)=>item.active).map((item)=><option value={item.id}>{item.name}</option>)}</select></label><label>Empresa duplicada<select class="mt-1 w-full rounded-lg border p-3" name="duplicateId">{rows.filter((item)=>item.active).map((item)=><option value={item.id}>{item.name}</option>)}</select></label><button class="rounded-lg bg-amber-700 p-3 font-bold text-white">Confirmar mesclagem</button></form></div><div class="mt-6 overflow-x-auto rounded-2xl bg-white"><table class="w-full"><thead><tr class="border-b text-left"><th class="p-4">Empresa</th><th class="p-4">Slug</th><th class="p-4">Vagas</th><th class="p-4">Status</th><th class="p-4">Preview</th></tr></thead><tbody>{rows.map((item)=><tr class="border-b"><td class="p-4 font-bold">{item.name}</td><td class="p-4 font-mono">{item.slug}</td><td class="p-4">{item.jobs}</td><td class="p-4">{item.active?"Ativa":"Arquivada"}</td><td class="p-4"><a class="text-red-700" href={`/empresas/${item.slug}`} target="_blank">Abrir</a></td></tr>)}</tbody></table></div></AdminLayout>
