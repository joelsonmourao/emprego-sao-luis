---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { companies, createDatabase, jobs } from "@es/db";
import { asc, count, eq } from "drizzle-orm";
import { can } from "../../lib/auth";
const auth = Astro.locals.auth!;
if (!can(auth, "companies.manage")) return new Response("Proibido", { status: 403 });
let rows: Array<{ id: string; name: string; slug: string; websiteUrl: string | null; active: boolean; jobs: number }> = [];
if (process.env.DATABASE_URL) { const connection = createDatabase(process.env.DATABASE_URL); try { rows = await connection.db.select({ id: companies.id, name: companies.name, slug: companies.slug, websiteUrl: companies.websiteUrl, active: companies.active, jobs: count(jobs.id) }).from(companies).leftJoin(jobs, eq(jobs.companyId, companies.id)).groupBy(companies.id).orderBy(asc(companies.name)); } finally { await connection.close(); } }
---
<AdminLayout title="Empresas"><h1 class="text-3xl font-black">Empresas</h1><p class="mt-2 text-slate-600">Cadastre empresas antes de publicar ou importar vagas.</p><form class="mt-6 grid gap-4 rounded-2xl bg-white p-6 md:grid-cols-2" method="post" action="/api/admin/companies"><label>Nome<input class="mt-1 w-full rounded-lg border p-3" name="name" required minlength="2"/></label><label>Slug<input class="mt-1 w-full rounded-lg border p-3" name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*"/></label><label>Site<input class="mt-1 w-full rounded-lg border p-3" type="url" name="websiteUrl"/></label><label>Logo (URL)<input class="mt-1 w-full rounded-lg border p-3" type="url" name="logoUrl"/></label><label class="md:col-span-2">Descrição<textarea class="mt-1 w-full rounded-lg border p-3" name="description"></textarea></label><button class="rounded-lg bg-red-700 p-3 font-bold text-white md:col-span-2">Cadastrar empresa</button></form><div class="mt-6 overflow-x-auto rounded-2xl bg-white"><table class="w-full min-w-[700px]"><thead><tr class="border-b text-left"><th class="p-4">Empresa</th><th class="p-4">Slug</th><th class="p-4">Vagas</th><th class="p-4">Status</th><th class="p-4">Site</th></tr></thead><tbody>{rows.length ? rows.map((item) => <tr class="border-b"><td class="p-4 font-bold">{item.name}</td><td class="p-4 font-mono text-sm">{item.slug}</td><td class="p-4">{item.jobs}</td><td class="p-4">{item.active ? "Ativa" : "Inativa"}</td><td class="p-4">{item.websiteUrl ? <a class="text-red-700" href={item.websiteUrl} target="_blank">Abrir</a> : "—"}</td></tr>) : <tr><td colspan="5" class="p-8 text-center">Nenhuma empresa cadastrada.</td></tr>}</tbody></table></div></AdminLayout>
