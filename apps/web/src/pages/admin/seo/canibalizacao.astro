---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { can } from "../../../lib/auth";
import { articles, createDatabase } from "@es/db";
import { desc, eq } from "drizzle-orm";

const auth = Astro.locals.auth!;
if (!can(auth, "seo.manage")) return Astro.redirect("/admin?error=sem-permissao");

type Group = { keyword: string; count: number; titles: string[] };
let groups: Group[] = [];
if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    const rows = await connection.db
      .select({
        title: articles.title,
        primaryKeyword: articles.primaryKeyword,
        status: articles.status
      })
      .from(articles)
      .where(eq(articles.status, "PUBLISHED"))
      .orderBy(desc(articles.updatedAt))
      .limit(300);
    const map = new Map<string, string[]>();
    for (const row of rows) {
      const key = (row.primaryKeyword ?? "").trim().toLowerCase();
      if (!key) continue;
      const list = map.get(key) ?? [];
      list.push(row.title);
      map.set(key, list);
    }
    groups = [...map.entries()]
      .filter(([, titles]) => titles.length > 1)
      .map(([keyword, titles]) => ({ keyword, count: titles.length, titles }))
      .sort((a, b) => b.count - a.count);
  } finally {
    await connection.close();
  }
}
---
<AdminLayout title="Canibalização">
  <div>
    <p class="text-sm font-bold uppercase tracking-wide text-red-700">SEO e indexação</p>
    <h1 class="mt-2 text-3xl font-black">Conteúdo órfão e canibalização</h1>
    <p class="mt-2 text-sm text-[var(--text-secondary)]">Palavras-chave principais compartilhadas por mais de um conteúdo publicado.</p>
  </div>
  <div class="mt-8 space-y-4">
    {groups.map((group) => (
      <article class="rounded-2xl bg-white p-5">
        <h2 class="font-black">{group.keyword} <span class="text-sm font-normal text-slate-500">({group.count})</span></h2>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm">
          {group.titles.map((title) => <li>{title}</li>)}
        </ul>
      </article>
    ))}
    {groups.length === 0 && <p class="rounded-2xl bg-white p-6 text-sm text-slate-600">Nenhuma canibalização evidente pela palavra-chave principal.</p>}
  </div>
  <p class="mt-6 text-sm"><a class="text-red-700 font-bold" href="/admin/seo/links-internos">Ver também links internos / órfãos</a></p>
</AdminLayout>
