---
import AdminLayout from "../../layouts/AdminLayout.astro";import{cities,createDatabase,neighborhoods,states}from"@es/db";import{asc,eq}from"drizzle-orm";import{can}from"../../lib/auth";
const auth=Astro.locals.auth!;if(!can(auth,"settings.manage"))return new Response("Proibido",{status:403});let stateRows:Array<{id:string;name:string;code:string}>=[];let cityRows:Array<{id:string;name:string;slug:string;state:string;active:boolean}>=[];let neighborhoodRows:Array<{id:string;name:string;slug:string;city:string;active:boolean}>=[];if(process.env.DATABASE_URL){const connection=createDatabase(process.env.DATABASE_URL);try{[stateRows,cityRows,neighborhoodRows]=await Promise.all([connection.db.select({id:states.id,name:states.name,code:states.code}).from(states).orderBy(asc(states.name)),connection.db.select({id:cities.id,name:cities.name,slug:cities.slug,state:states.code,active:cities.active}).from(cities).innerJoin(states,eq(cities.stateId,states.id)).orderBy(asc(cities.name)),connection.db.select({id:neighborhoods.id,name:neighborhoods.name,slug:neighborhoods.slug,city:cities.name,active:neighborhoods.active}).from(neighborhoods).innerJoin(cities,eq(neighborhoods.cityId,cities.id)).orderBy(asc(neighborhoods.name))]);}finally{await connection.close();}}
---
<AdminLayout title="Cidades e bairros"><h1 class="text-3xl font-black">Cidades e bairros</h1><div class="mt-6 grid gap-6 lg:grid-cols-2"><form class="grid gap-4 rounded-2xl bg-white p-6" method="post" action="/api/admin/locations/cities"><h2 class="text-xl font-black">Nova cidade</h2><label>Nome<input class="mt-1 w-full rounded-lg border p-3" name="name" required/></label><label>Slug<input class="mt-1 w-full rounded-lg border p-3" name="slug" required/></label><label>UF<select class="mt-1 w-full rounded-lg border p-3" name="stateId">{stateRows.map((state)=><option value={state.id}>{state.name} ({state.code})</option>)}</select></label><label>Código IBGE<input class="mt-1 w-full rounded-lg border p-3" name="ibgeCode"/></label><label><input type="checkbox" name="metropolitanRegion" value="true"/> Região Metropolitana</label><button class="rounded-lg bg-red-700 p-3 font-bold text-white">Cadastrar cidade</button></form><form class="grid gap-4 rounded-2xl bg-white p-6" method="post" action="/api/admin/locations/neighborhoods"><h2 class="text-xl font-black">Novo bairro</h2><label>Nome<input class="mt-1 w-full rounded-lg border p-3" name="name" required/></label><label>Slug<input class="mt-1 w-full rounded-lg border p-3" name="slug" required/></label><label>Cidade<select class="mt-1 w-full rounded-lg border p-3" name="cityId">{cityRows.map((city)=><option value={city.id}>{city.name}/{city.state}</option>)}</select></label><button class="rounded-lg bg-red-700 p-3 font-bold text-white">Cadastrar bairro</button></form></div><div class="mt-8 grid gap-6 lg:grid-cols-2"><section class="rounded-2xl bg-white p-5"><h2 class="text-xl font-black">Cidades</h2><ul class="mt-4 divide-y">{cityRows.map((city)=><li class="flex justify-between py-3"><span>{city.name}/{city.state}</span><a class="text-red-700" href={`/vagas/cidade/${city.slug}`} target="_blank">Preview</a></li>)}</ul></section><section class="rounded-2xl bg-white p-5"><h2 class="text-xl font-black">Bairros</h2><ul class="mt-4 divide-y">{neighborhoodRows.map((item)=><li class="py-3">{item.name} · {item.city}</li>)}</ul></section></div></AdminLayout>
