---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { can } from "../../lib/auth";
import { authors, createDatabase, users } from "@es/db";

const auth = Astro.locals.auth!;
if (!can(auth, "content.manage")) return Astro.redirect("/admin?error=sem-permissao");

let authorRows: typeof authors.$inferSelect[] = [];
let reviewerRows: Array<{ id: string; email: string }> = [];
if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    [authorRows, reviewerRows] = await Promise.all([
      connection.db.select().from(authors).orderBy(authors.name),
      connection.db.select({ id: users.id, email: users.email }).from(users).orderBy(users.email)
    ]);
  } finally {
    await connection.close();
  }
}
---
<AdminLayout title="Autores e revisores">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-red-700">Conteúdo</p>
      <h1 class="mt-2 text-3xl font-black">Autores e revisores</h1>
      <p class="mt-2 text-sm text-[var(--text-secondary)]">Gestão de autoria editorial. Revisores são usuários internos com permissão de conteúdo.</p>
    </div>
    <a class="rounded-lg border px-4 py-2 font-bold" href="/admin/conteudo">Lista de conteúdos</a>
  </div>
  <section class="mt-8 rounded-2xl bg-white p-6">
    <h2 class="text-xl font-black">Novo autor</h2>
    <form class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-5" method="post" action="/api/admin/authors">
      <input type="hidden" name="returnTo" value="authors" />
      <input class="rounded-lg border p-3" name="name" placeholder="Nome" minlength="2" required />
      <input class="rounded-lg border p-3" name="slug" placeholder="slug opcional" />
      <input class="rounded-lg border p-3" name="bio" placeholder="Biografia curta" />
      <input class="rounded-lg border p-3" name="avatarUrl" type="url" placeholder="URL do avatar" />
      <button class="rounded-lg border font-bold">Cadastrar autor</button>
    </form>
  </section>
  <section class="mt-8 grid gap-4 lg:grid-cols-2">
    {authorRows.map((author) => (
      <article class="rounded-2xl bg-white p-5">
        <form class="grid gap-3" method="post" action={`/api/admin/authors/${author.id}`}>
          <input type="hidden" name="action" value="UPDATE" />
          <input type="hidden" name="returnTo" value="authors" />
          <label class="text-xs font-bold">Nome<input class="mt-1 w-full rounded-lg border p-2" name="name" value={author.name} required /></label>
          <label class="text-xs font-bold">Slug<input class="mt-1 w-full rounded-lg border p-2" name="slug" value={author.slug} required /></label>
          <label class="text-xs font-bold">Biografia<input class="mt-1 w-full rounded-lg border p-2" name="bio" value={author.bio ?? ""} /></label>
          <button class="rounded-lg border px-3 py-2 text-sm font-bold">Salvar</button>
        </form>
      </article>
    ))}
  </section>
  <section class="mt-8 rounded-2xl bg-white p-6">
    <h2 class="text-xl font-black">Revisores (usuários)</h2>
    <ul class="mt-4 space-y-2 text-sm">
      {reviewerRows.map((user) => <li class="rounded-lg border px-3 py-2">{user.email}</li>)}
      {reviewerRows.length === 0 && <li class="text-slate-500">Nenhum usuário listado.</li>}
    </ul>
  </section>
</AdminLayout>
