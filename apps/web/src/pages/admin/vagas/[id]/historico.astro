---
import AdminLayout from "../../../../layouts/AdminLayout.astro"; import { createDatabase, jobRevisions, jobs } from "@es/db"; import { desc, eq } from "drizzle-orm"; import { can } from "../../../../lib/auth";
const auth=Astro.locals.auth!; if(!can(auth,"jobs.read")) return new Response("Proibido",{status:403}); if(!Astro.params.id||!process.env.DATABASE_URL)return new Response("Não encontrado",{status:404}); const connection=createDatabase(process.env.DATABASE_URL); let job; let revisions; try{[job]=await connection.db.select().from(jobs).where(eq(jobs.id,Astro.params.id)).limit(1); revisions=await connection.db.select().from(jobRevisions).where(eq(jobRevisions.jobId,Astro.params.id)).orderBy(desc(jobRevisions.version));}finally{await connection.close();} if(!job)return new Response("Não encontrado",{status:404});
---
<AdminLayout title={`Histórico ${job.publicCode}`}><h1 class="text-3xl font-black">Histórico de {job.publicCode}</h1><a class="mt-3 inline-block text-red-700" href={`/admin/vagas/${job.id}/editar`}>Voltar à edição</a><div class="mt-6 grid gap-4">{revisions.length?revisions.map((revision)=><article class="rounded-2xl bg-white p-5"><strong>Versão {revision.version}</strong><p class="text-sm text-slate-600">{revision.createdAt.toLocaleString("pt-BR")}</p><details class="mt-3"><summary>Ver snapshot</summary><pre class="mt-3 overflow-auto rounded bg-slate-950 p-4 text-xs text-white">{JSON.stringify(revision.snapshot,null,2)}</pre></details></article>):<p class="rounded-2xl bg-white p-6">Nenhuma revisão anterior.</p>}</div></AdminLayout>
