---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { can } from "../../../lib/auth";

const auth = Astro.locals.auth!;
if (!can(auth, "imports.manage")) return Astro.redirect("/admin?error=sem-permissao");
const preview = Astro.url.searchParams.get("preview");
const error = Astro.url.searchParams.get("error");
---
<AdminLayout title="Importar por links ou contatos">
  <div class="max-w-3xl">
    <p class="text-sm font-bold uppercase tracking-wide text-red-700">Vagas</p>
    <h1 class="mt-2 text-3xl font-black">Importar vagas por links ou contatos</h1>
    <p class="mt-3 text-sm text-[var(--text-secondary)]">
      Uma entrada por linha: URL, WhatsApp, e-mail ou combinações. Sempre gera prévia em rascunho.
      Não contorna CAPTCHA, login nem bloqueios de terceiros. Nunca publica automaticamente.
      Bairro não é exigido nesta entrada — complete na revisão se souber.
    </p>
    {error && <p class="mt-4 rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-900" role="alert">{error}</p>}
    {preview && <p class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-900">Prévia criada. Abra o lote na importação para revisar.</p>}
    <form class="mt-8 grid gap-4 rounded-2xl bg-white p-6" method="post" action="/api/admin/imports/contacts">
      <label class="block text-sm font-bold">Entradas
        <textarea class="mt-2 min-h-56 w-full rounded-lg border p-3 font-mono text-sm" name="entries" required placeholder={"https://example.invalid/vaga\n5598987654321\nrh@example.invalid\nhttps://example.invalid/vaga 5598987654321"}></textarea>
      </label>
      <p class="text-xs text-slate-600">Máximo 200 linhas. Telefones e e-mails fictícios em homologação.</p>
      <button class="rounded-xl bg-red-700 px-5 py-3 font-bold text-white" type="submit">Analisar e gerar prévia</button>
    </form>
    <p class="mt-6 text-sm"><a class="font-bold text-red-700 underline" href="/admin/vagas/importar">Voltar à importação por planilha</a></p>
  </div>
</AdminLayout>
