---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { can } from "../../../lib/auth";
import { createDatabase, jobs, companies, cities } from "@es/db";
import { and, desc, eq, inArray } from "drizzle-orm";

const auth = Astro.locals.auth!;
if (!can(auth, "jobs.publish")) return Astro.redirect("/admin?error=sem-permissao");

type Row = {
  id: string;
  publicCode: string;
  title: string;
  company: string | null;
  city: string | null;
  publicationStatus: string;
  verificationStatus: string;
  updatedAt: Date;
};

let rows: Row[] = [];
if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    const data = await connection.db
      .select({
        id: jobs.id,
        publicCode: jobs.publicCode,
        title: jobs.normalizedTitle,
        company: companies.name,
        city: cities.name,
        publicationStatus: jobs.publicationStatus,
        verificationStatus: jobs.verificationStatus,
        updatedAt: jobs.updatedAt
      })
      .from(jobs)
      .leftJoin(companies, eq(companies.id, jobs.companyId))
      .leftJoin(cities, eq(cities.id, jobs.cityId))
      .where(
        and(
          inArray(jobs.publicationStatus, ["PENDING_REVIEW", "DRAFT", "APPROVED"]),
          inArray(jobs.verificationStatus, ["NEEDS_REVIEW", "UNVERIFIED", "SOURCE_CONFIRMED"])
        )
      )
      .orderBy(desc(jobs.updatedAt))
      .limit(100);
    rows = data.filter(
      (item) =>
        item.publicationStatus === "PENDING_REVIEW" ||
        item.verificationStatus === "NEEDS_REVIEW" ||
        item.publicationStatus === "DRAFT"
    );
  } finally {
    await connection.close();
  }
}
---
<AdminLayout title="Revisão e aprovação de vagas">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-red-700">Vagas</p>
      <h1 class="mt-2 text-3xl font-black">Revisão e aprovação</h1>
      <p class="mt-2 text-sm text-[var(--text-secondary)]">
        Fluxo: rascunho → revisão → aprovado → agendado → publicado. Proibido publicar com verificação NEEDS_REVIEW.
        Candidato sempre gratuito — esta fila não gera cobrança.
      </p>
    </div>
    <a class="rounded-lg border px-4 py-2 font-bold" href="/admin/vagas">Todas as vagas</a>
  </div>
  <section class="mt-8 overflow-x-auto rounded-2xl bg-white p-6">
    {rows.length === 0 ? (
      <p class="text-sm text-slate-600">Nenhuma vaga pendente de revisão no momento.</p>
    ) : (
      <table class="min-w-full text-sm">
        <thead>
          <tr class="border-b text-left">
            <th class="p-3">Código</th>
            <th class="p-3">Título</th>
            <th class="p-3">Empresa</th>
            <th class="p-3">Publicação</th>
            <th class="p-3">Verificação</th>
            <th class="p-3">Ação</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b">
              <td class="p-3 font-mono text-xs">{row.publicCode}</td>
              <td class="p-3 font-bold">{row.title}</td>
              <td class="p-3">{row.company ?? "—"}</td>
              <td class="p-3">{row.publicationStatus}</td>
              <td class="p-3">{row.verificationStatus}</td>
              <td class="p-3"><a class="font-bold text-red-700 underline" href={`/admin/vagas/${row.id}/editar`}>Revisar</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>
</AdminLayout>
