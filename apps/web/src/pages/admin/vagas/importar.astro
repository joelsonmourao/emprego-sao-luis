---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { can } from "../../../lib/auth";
import { getImportStorageInfo } from "../../../lib/import-storage";
import { createDatabase, importBatches, importMappingTemplates, importRows } from "@es/db";
import { asc, desc, eq } from "drizzle-orm";

const auth = Astro.locals.auth!;
if (!can(auth, "imports.manage")) {
  return Astro.redirect("/admin?error=sem-permissao");
}

const batchId = Astro.url.searchParams.get("batch");
const step = Astro.url.searchParams.get("step") ?? (batchId ? "mapear" : "arquivo");
const reused = Astro.url.searchParams.get("reused") === "1";

let batch: (typeof importBatches.$inferSelect) | null = null;
let templates: Array<{ id: string; name: string }> = [];
let history: Array<{ id: string; fileName: string; status: string; createdAt: Date | null; totalRows: number; validRows: number; rejectedRows: number; settings: unknown }> = [];
let loadError: string | null = null;
let previewRows: typeof importRows.$inferSelect[] = [];

if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    if (batchId) {
      const rows = await connection.db.select().from(importBatches).where(eq(importBatches.id, batchId)).limit(1);
      batch = rows[0] ?? null;
      if (batch) previewRows = await connection.db.select().from(importRows).where(eq(importRows.batchId, batch.id)).orderBy(asc(importRows.rowNumber)).limit(100);
    }
    templates = await connection.db
      .select({ id: importMappingTemplates.id, name: importMappingTemplates.name })
      .from(importMappingTemplates);
    history = await connection.db
      .select({
        id: importBatches.id,
        fileName: importBatches.fileName,
        status: importBatches.status,
        createdAt: importBatches.createdAt,
        totalRows: importBatches.totalRows,
        validRows: importBatches.validRows,
        rejectedRows: importBatches.rejectedRows,
        settings: importBatches.settings
      })
      .from(importBatches)
      .orderBy(desc(importBatches.createdAt))
      .limit(12);
  } catch (error) {
    loadError = "Não foi possível carregar esta área.";
    console.error("[admin-import]", error);
  } finally {
    await connection.close();
  }
} else {
  loadError = "Banco de dados indisponível.";
}

const config = batch?.settings as
  | {
      stage?: string;
      mode?: string;
      sheets?: Array<{ name: string; headers: string[]; preview: Array<Record<string, unknown>> }>;
      sheetName?: string;
      mapping?: Record<string, string>;
      error?: string;
      failureRequestId?: string | null;
      analysisValid?: boolean;
      analysis?: { consolidation?: { sectionsMerged?: string[]; duplicateItemsRemoved?: number } };
    }
  | undefined;

const fields: Array<[string, string]> = [
  ["originalTitle", "Título original"], ["title", "Título público"], ["company", "Empresa"], ["category", "Categoria"],
  ["locality", "Localidade"], ["city", "Cidade"], ["state", "UF"], ["neighborhood", "Bairro"], ["workplaceType", "Modalidade"],
  ["employmentType", "Tipo de contratação"], ["description", "Descrição"], ["summary", "Resumo"], ["activities", "Atividades"],
  ["requirements", "Requisitos"], ["benefits", "Benefícios"], ["numberOfOpenings", "Quantidade de vagas"], ["salary", "Salário/faixa"], ["salaryMin", "Salário mínimo"], ["salaryMax", "Salário máximo"],
  ["applicationUrl", "URL de candidatura"], ["applicationEmail", "E-mail de candidatura"], ["applicationWhatsapp", "WhatsApp de candidatura"], ["whatsappMessage", "Mensagem WhatsApp"], ["emailSubject", "Assunto do e-mail"], ["applicationInstructions", "Instruções de candidatura"],
  ["sourceName", "Fonte"], ["sourceUrl", "URL da fonte"], ["publishedAt", "Data de publicação"],
  ["expiresAt", "Validade"], ["sourceStatus", "Status de origem"], ["featured", "Destaque"], ["externalId", "Código externo"]
];
const requiredFields = ["title", "company", "description", "sourceName"];
const headers = [...new Set(config?.sheets?.flatMap((sheet) => sheet.headers) ?? [])];
const storage = getImportStorageInfo();
const steps = [
  { id: "arquivo", label: "1. Arquivo" },
  { id: "mapear", label: "2. Mapear" },
  { id: "validar", label: "3. Validar" },
  { id: "confirmar", label: "4. Confirmar" },
  { id: "acompanhar", label: "5. Processar" },
  { id: "resultado", label: "6. Resultado" }
];
---

<AdminLayout title="Importar vagas">
  <nav class="text-sm text-[var(--text-secondary)]" aria-label="Breadcrumb">
    <a class="font-semibold text-[var(--brand-primary)]" href="/admin">Painel</a>
    <span aria-hidden="true"> / </span>
    <a class="font-semibold text-[var(--brand-primary)]" href="/admin/vagas">Vagas</a>
    <span aria-hidden="true"> / </span>
    <span>Importar</span>
  </nav>

  <h1 class="mt-3 text-3xl font-black">Importar vagas</h1>
  <p class="mt-2 max-w-3xl text-[var(--text-secondary)]">
    Envie a planilha, revise o mapeamento, valide os dados e só então confirme a importação.
    Armazenamento: <strong>{storage.mode === "s3" ? "R2/S3" : "volume local"}</strong>.
  </p>
  <div class="mt-5 flex flex-wrap gap-3">
    <a class="rounded-lg bg-emerald-700 px-4 py-2 font-bold text-white" href="/modelos/modelo-importacao-vagas.xlsx" download>Baixar modelo Excel</a>
    <a class="rounded-lg border border-emerald-700 px-4 py-2 font-bold text-emerald-800" href="/api/admin/import-template.csv" data-admin-download data-filename="modelo-importacao-vagas.csv">Baixar modelo CSV</a>
    <a class="rounded-lg border px-4 py-2 font-bold" href="/admin/vagas/importar-contatos">Importar vagas por links ou contatos</a>
  </div>
  <p class="mt-3 max-w-4xl text-sm text-[var(--text-secondary)]">Preencha a aba “Vagas”. Título, empresa, descrição, fonte, localidade e ao menos um canal de candidatura são necessários. Categoria, bairro, salário e quantidade são opcionais. A linha de exemplo é ignorada automaticamente.</p>

  {loadError && (
    <p class="mt-6 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-900" role="alert">
      {loadError} Tente novamente ou consulte os logs da operação.
    </p>
  )}

  {storage.mode === "volume" && (
    <p class="mt-4 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900" role="status">
      Arquivos serão guardados no volume persistente{storage.path ? ` (${storage.path})` : ""}. Configure R2/S3 para produção em escala.
    </p>
  )}

  {reused && (
    <p class="mt-4 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900" role="status">
      Este arquivo já havia sido enviado. Reutilizamos o lote existente.
    </p>
  )}

  <ol class="mt-6 flex flex-wrap gap-2 text-xs font-bold uppercase tracking-wide">
    {steps.map((item) => (
      <li
        class={`rounded-full px-3 py-1 ${step === item.id ? "bg-red-700 text-white" : "bg-white text-[var(--text-secondary)] ring-1 ring-[var(--brand-border)]"}`}
      >
        {item.label}
      </li>
    ))}
  </ol>

  {batch && config?.stage === "CONFIGURE" && (
    <section class="mt-8 rounded-2xl border border-[var(--brand-border)] bg-white p-6">
      <h2 class="text-xl font-black">Mapear colunas — {batch.fileName}</h2>
      <p class="mt-2 text-sm text-[var(--text-secondary)]">Revise a aba, o destino e o mapeamento antes de validar.</p>
      <form class="mt-5 grid gap-4" method="post" action={`/api/admin/imports/${batch.id}/configure`}>
        <div class="grid gap-4 md:grid-cols-3">
          <label>
            Aba
            <select class="mt-1 w-full rounded-lg border p-3" name="sheetName">
              {config.sheets?.map((sheet) => (
                <option value={sheet.name} selected={sheet.name === config.sheetName}>{sheet.name}</option>
              ))}
            </select>
          </label>
          <label>
            Destino
            <select class="mt-1 w-full rounded-lg border p-3" name="mode">
              <option value="DRY_RUN">Somente validar</option>
              <option value="DRAFT">Rascunho</option>
              <option value="PENDING_REVIEW">Revisão</option>
            </select>
          </label>
          <label>
            Duplicidades
            <select class="mt-1 w-full rounded-lg border p-3" name="duplicateStrategy">
              <option value="IGNORE">Ignorar</option>
              <option value="UPDATE">Atualizar existente</option>
              <option value="CREATE_NEW">Importar como nova</option>
            </select>
          </label>
        </div>
        <div class="grid gap-3 md:grid-cols-2">
          {fields.map(([field, label]) => (
            <label>
              {label}{requiredFields.includes(field) && " *"}
              <select class="mt-1 w-full rounded-lg border p-3" name={`map_${field}`} required={requiredFields.includes(field)}>
                <option value="">Não mapear</option>
                {headers.map((header) => (
                  <option value={header} selected={config.mapping?.[field] === header}>{header}</option>
                ))}
              </select>
            </label>
          ))}
        </div>
        <label>
          Salvar modelo reutilizável
          <input class="mt-1 w-full rounded-lg border p-3" name="templateName" list="mapping-templates" />
          <datalist id="mapping-templates">
            {templates.map((item) => <option value={item.name} />)}
          </datalist>
        </label>
        <button class="rounded-xl bg-red-700 p-4 font-bold text-white" type="submit">Validar e enfileirar</button>
      </form>
      <details class="mt-6">
        <summary class="cursor-pointer font-bold">Prévia das primeiras linhas</summary>
        <pre class="mt-3 overflow-auto rounded-xl bg-slate-950 p-4 text-xs text-white">{JSON.stringify(config.sheets?.find((sheet) => sheet.name === config.sheetName)?.preview ?? [], null, 2)}</pre>
      </details>
    </section>
  )}

  {batch && config?.stage !== "CONFIGURE" && (
    <section class="mt-8 rounded-2xl border border-[var(--brand-border)] bg-white p-6">
      <h2 class="text-xl font-black">Lote {batch.fileName}</h2>
      <p class="mt-2 text-sm">Status: <strong>{batch.status}</strong></p>
      {config?.stage === "FAILED" && (
        <div class="mt-4 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-950" role="alert">
          <p><strong>Falha:</strong> {config.error || "A causa não foi registrada."}</p>
          {config.failureRequestId && <p class="mt-1 font-mono text-xs">Referência: {config.failureRequestId}</p>}
          <form class="mt-3" method="post" action={`/api/admin/imports/${batch.id}/retry`}>
            <button class="rounded-lg bg-rose-800 px-4 py-2 font-bold text-white" type="submit">Criar nova tentativa</button>
          </form>
        </div>
      )}
      <dl class="mt-4 grid grid-cols-3 gap-4">
        <div><dt class="text-sm text-[var(--text-secondary)]">Total</dt><dd class="text-2xl font-bold">{batch.totalRows}</dd></div>
        <div><dt class="text-sm text-[var(--text-secondary)]">Válidas</dt><dd class="text-2xl font-bold text-green-700">{batch.validRows}</dd></div>
        <div><dt class="text-sm text-[var(--text-secondary)]">Rejeitadas</dt><dd class="text-2xl font-bold text-red-700">{batch.rejectedRows}</dd></div>
      </dl>
      <div class="mt-5 flex flex-wrap gap-3">
        {batch.status === "COMPLETED" && batch.rejectedRows > 0 && <a
          class="rounded-lg border px-4 py-2 font-bold"
          href={`/api/admin/imports/${batch.id}/rejected.csv`}
          data-admin-download
          data-filename={`rejeitadas-${batch.id}.csv`}
        >
          Baixar rejeitadas
        </a>}
        {batch.status === "COMPLETED" && config?.stage === "VALIDATED" && config.analysisValid && batch.validRows > 0 && <form method="post" action={`/api/admin/imports/${batch.id}/execute`}>
          <select class="rounded-l-lg border p-2" name="mode">
            <option value="DRAFT">Importar rascunhos</option>
            <option value="PENDING_REVIEW">Enviar para revisão</option>
          </select>
          <button class="rounded-r-lg bg-slate-950 p-2 text-white" type="submit">Executar lote validado</button>
        </form>}
        {batch.status === "COMPLETED" && config?.stage === "IMPORTED" && !batch.undoneAt && (
          <form method="post" action={`/api/admin/imports/${batch.id}/undo`}>
            <button class="rounded-lg border border-red-300 px-4 py-2 text-red-700" type="submit">Desfazer lote</button>
          </form>
        )}
        {batch.status === "COMPLETED" && config?.stage === "IMPORTED" && previewRows.some((row) => row.reviewStatus === "READY_FOR_REVIEW" && row.jobId) && (
          <form method="post" action={`/api/admin/imports/${batch.id}/approve-ready`}>
            <button class="rounded-lg bg-emerald-700 px-4 py-2 font-bold text-white" type="submit">Aprovar e publicar vagas de alta confiança</button>
          </form>
        )}
      </div>
      {config?.analysis?.consolidation && (
        <p class="mt-4 rounded-lg bg-slate-50 p-3 text-xs text-slate-700">
          Conteúdo consolidado: {(config.analysis.consolidation.sectionsMerged ?? []).join(", ") || "descrição"}; duplicações removidas: {config.analysis.consolidation.duplicateItemsRemoved ?? 0}.
        </p>
      )}
      {previewRows.length > 0 && (
        <div class="mt-6 overflow-x-auto">
          <h3 class="font-black">Prévia normalizada e validação</h3>
          {config?.stage === "IMPORTED" && previewRows.some((row) => row.jobId) && (
            <form class="my-4 grid gap-3 rounded-xl border bg-slate-50 p-4 md:grid-cols-[minmax(12rem,1fr)_minmax(12rem,1fr)_minmax(12rem,2fr)_auto]" method="post" action={`/api/admin/imports/${batch.id}/bulk-correct`}>
              <label class="text-xs font-bold">Linhas (Ctrl/Cmd para várias)
                <select class="mt-1 h-28 w-full rounded-lg border p-2 font-normal" name="rowId" multiple required>
                  {previewRows.filter((row) => row.jobId).map((row) => <option value={row.id}>Linha {row.rowNumber} · {row.reviewStatus}</option>)}
                </select>
              </label>
              <label class="text-xs font-bold">Campo
                <select class="mt-1 w-full rounded-lg border p-2 font-normal" name="field" required>
                  <option value="applicationUrl">URL de candidatura</option><option value="applicationEmail">E-mail de candidatura</option><option value="applicationWhatsapp">WhatsApp</option><option value="whatsappMessage">Mensagem WhatsApp</option><option value="applicationInstructions">Instruções</option><option value="expiresAt">Data de encerramento</option><option value="sourceName">Fonte</option><option value="workplaceType">Modalidade</option>
                </select>
              </label>
              <label class="text-xs font-bold">Novo valor
                <input class="mt-1 w-full rounded-lg border p-2 font-normal" name="value" required />
              </label>
              <button class="self-end rounded-lg bg-slate-900 px-4 py-2 font-bold text-white">Aplicar correção em lote</button>
            </form>
          )}
          <table class="mt-3 min-w-full text-xs">
            <thead><tr class="border-b text-left"><th class="p-2">Linha</th><th class="p-2">Original</th><th class="p-2">Normalizado</th><th class="p-2">Sugestões/confiança</th><th class="p-2">Avisos e erros</th><th class="p-2">Situação</th></tr></thead>
            <tbody>{previewRows.map((row) => <tr class="border-b align-top"><td class="p-2">{row.rowNumber}</td><td class="max-w-xs p-2"><pre class="whitespace-pre-wrap">{JSON.stringify(row.raw, null, 2)}</pre></td><td class="max-w-xs p-2"><pre class="whitespace-pre-wrap">{JSON.stringify(row.normalized, null, 2)}</pre></td><td class="max-w-xs p-2"><pre class="whitespace-pre-wrap">{JSON.stringify(row.suggestions, null, 2)}</pre><strong>{row.confidence ?? "—"}</strong></td><td class="max-w-xs p-2"><pre class="whitespace-pre-wrap text-amber-800">{JSON.stringify(row.warnings, null, 2)}</pre><pre class="whitespace-pre-wrap text-red-700">{JSON.stringify(row.errors, null, 2)}</pre></td><td class="p-2 font-bold">{row.reviewStatus}</td></tr>)}</tbody>
          </table>
        </div>
      )}
    </section>
  )}

  {!batch && (
    <section class="mt-8 max-w-2xl rounded-2xl border border-[var(--brand-border)] bg-white p-6">
      <h2 class="text-xl font-black">Selecionar arquivo</h2>
      <p class="mt-2 text-sm text-[var(--text-secondary)]">O envio apenas analisa o arquivo. A importação só começa após confirmação.</p>
      <form id="import-upload-form" class="mt-5 grid gap-5" method="post" action="/api/admin/imports" enctype="multipart/form-data">
        <label>
          Arquivo XLSX ou CSV
          <input class="mt-2 block w-full rounded-lg border p-3" type="file" name="file" accept=".xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv" required />
        </label>
        <label>
          Destino inicial
          <select class="mt-2 block w-full rounded-lg border p-3" name="mode">
            <option value="DRY_RUN">Somente validar</option>
            <option value="DRAFT">Rascunho</option>
            <option value="PENDING_REVIEW">Revisão</option>
          </select>
        </label>
        <button class="rounded-xl bg-red-700 p-4 font-bold text-white" type="submit">
          Analisar arquivo
        </button>
      </form>
    </section>
  )}

  <section id="links-contatos" class="mt-10 max-w-4xl rounded-2xl border border-[var(--brand-border)] bg-white p-6">
    <h2 class="text-xl font-black">Importar vagas por links ou contatos</h2>
    <p class="mt-2 text-sm text-[var(--text-secondary)]">Cole uma entrada por linha: URL, e-mail, WhatsApp ou uma combinação. O sistema cria somente uma prévia; não contorna login, CAPTCHA ou proteção de terceiros.</p>
    <form class="mt-4 grid gap-4" method="post" action="/api/admin/imports/contacts">
      <textarea class="min-h-40 rounded-lg border p-3 font-mono text-sm" name="entries" required placeholder="https://empresa.com/vaga recrutamento@empresa.com.br&#10;+55 98 99999-9999"></textarea>
      <button class="rounded-xl bg-slate-950 p-4 font-bold text-white">Gerar prévia de links e contatos</button>
    </form>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-black">Histórico de importações</h2>
    {history.length === 0 ? (
      <p class="mt-3 rounded-xl border border-dashed border-[var(--brand-border)] bg-white px-4 py-6 text-sm text-[var(--text-secondary)]">
        Nenhuma importação registrada ainda.
      </p>
    ) : (
      <div class="mt-4 overflow-x-auto rounded-2xl border border-[var(--brand-border)] bg-white">
        <table class="min-w-full text-sm">
          <thead class="bg-[var(--brand-background)] text-left text-xs uppercase tracking-wide text-[var(--text-secondary)]">
            <tr>
              <th class="px-4 py-3">Arquivo</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Linhas</th>
              <th class="px-4 py-3">Data</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            {history.map((item) => (
              <tr class="border-t border-[var(--brand-border)]">
                <td class="px-4 py-3 font-semibold">{item.fileName}</td>
                <td class="px-4 py-3">{item.status}{typeof item.settings === "object" && item.settings && "stage" in item.settings ? ` · ${String(item.settings.stage)}` : ""}</td>
                <td class="px-4 py-3">{item.validRows}/{item.totalRows} válidas · {item.rejectedRows} rejeitadas</td>
                <td class="px-4 py-3">{item.createdAt ? item.createdAt.toLocaleString("pt-BR") : "—"}</td>
                <td class="px-4 py-3"><a class="font-bold text-red-700" href={`/admin/vagas/importar?batch=${item.id}&step=acompanhar`}>Abrir</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
</AdminLayout>
