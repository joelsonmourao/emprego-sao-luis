---
import AdminLayout from "../../layouts/AdminLayout.astro"; import { createDatabase,jobs,publicationSchedules } from "@es/db"; import { asc,desc,inArray } from "drizzle-orm"; import { can } from "../../lib/auth";
const auth=Astro.locals.auth!;if(!can(auth,"jobs.publish"))return new Response("Proibido",{status:403});let candidates:Array<{id:string;code:string;title:string}>=[];let schedules:Array<{id:string;name:string;status:string;preview:unknown;createdAt:Date}>=[];if(process.env.DATABASE_URL){const connection=createDatabase(process.env.DATABASE_URL);try{candidates=await connection.db.select({id:jobs.id,code:jobs.publicCode,title:jobs.normalizedTitle}).from(jobs).where(inArray(jobs.publicationStatus,["DRAFT","APPROVED","PAUSED"])).orderBy(asc(jobs.createdAt)).limit(500);schedules=await connection.db.select({id:publicationSchedules.id,name:publicationSchedules.name,status:publicationSchedules.status,preview:publicationSchedules.preview,createdAt:publicationSchedules.createdAt}).from(publicationSchedules).orderBy(desc(publicationSchedules.createdAt)).limit(30);}finally{await connection.close();}}
---
<AdminLayout title="Programação"><h1 class="text-3xl font-black">Programação de publicações</h1><p class="mt-2 text-slate-600">Distribua qualquer quantidade de vagas em blocos e valide toda a janela antes de salvar.</p><form class="mt-6 grid gap-4 rounded-2xl bg-white p-6" method="post" action="/api/admin/schedules"><div class="grid gap-4 md:grid-cols-3"><label>Nome<input class="mt-1 w-full rounded-lg border p-3" name="name" required/></label><label>Início<input class="mt-1 w-full rounded-lg border p-3" type="datetime-local" name="startAt" required/></label><label>Fim<input class="mt-1 w-full rounded-lg border p-3" type="datetime-local" name="endAt" required/></label><label>Vagas por bloco<input class="mt-1 w-full rounded-lg border p-3" type="number" name="blockSize" value="25" min="1" required/></label><label>Minutos entre vagas<input class="mt-1 w-full rounded-lg border p-3" type="number" name="itemIntervalMinutes" value="2" min="1" required/></label><label>Minutos entre blocos<input class="mt-1 w-full rounded-lg border p-3" type="number" name="blockIntervalMinutes" value="30" min="0" required/></label></div><fieldset><legend class="font-bold">Vagas e ordem</legend><div class="mt-3 grid max-h-72 gap-2 overflow-auto rounded-xl border p-3 md:grid-cols-2">{candidates.map((job)=><label class="rounded-lg border p-3"><input class="mr-2" type="checkbox" name="jobId" value={job.id}/><span class="font-mono text-xs">{job.code}</span> {job.title}</label>)}</div></fieldset><button class="rounded-xl bg-red-700 p-4 font-bold text-white">Calcular e salvar programação</button></form><section class="mt-8"><h2 class="text-2xl font-black">Programações recentes</h2><div class="mt-4 grid gap-4">{schedules.map((schedule)=><article class="rounded-2xl bg-white p-5"><div class="flex flex-wrap items-center justify-between gap-3"><div><strong>{schedule.name}</strong><p class="text-sm text-slate-600">{schedule.status} · {schedule.createdAt.toLocaleString("pt-BR")}</p></div><div class="flex gap-2">{schedule.status==="ACTIVE"&&<form method="post" action={`/api/admin/schedules/${schedule.id}/action`}><input type="hidden" name="action" value="PAUSE"/><button class="rounded border px-3 py-2">Pausar</button></form>}{schedule.status==="PAUSED"&&<form method="post" action={`/api/admin/schedules/${schedule.id}/action`}><input type="hidden" name="action" value="RESUME"/><button class="rounded border px-3 py-2">Continuar</button></form>} {!['CANCELLED','COMPLETED'].includes(schedule.status)&&<form method="post" action={`/api/admin/schedules/${schedule.id}/action`}><input type="hidden" name="action" value="CANCEL"/><button class="rounded border border-red-300 px-3 py-2 text-red-700">Cancelar</button></form>}</div></div><details class="mt-3"><summary>Ver horários</summary><pre class="mt-2 overflow-auto rounded bg-slate-950 p-4 text-xs text-white">{JSON.stringify(schedule.preview,null,2)}</pre></details></article>)}</div></section></AdminLayout>
