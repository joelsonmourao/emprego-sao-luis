---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { can } from "../../../lib/auth";

const auth = Astro.locals.auth!;
if (!can(auth, "commercial.manage")) return new Response("Proibido", { status: 403 });

const STATUS_LABELS: Record<string, string> = {
  CREATED: "Criado",
  PENDING: "Pendente",
  PROCESSING: "Processando",
  PAID: "Pago",
  FAILED: "Falhou",
  CANCELLED: "Cancelado",
  EXPIRED: "Expirado",
  REFUNDED: "Reembolsado",
  PARTIALLY_REFUNDED: "Reembolso parcial",
  MANUAL_REVIEW: "Revisão manual"
};
---
<AdminLayout title="Pagamentos">
  <h1 class="font-display text-3xl font-black">Pagamentos</h1>
  <p class="mt-2 text-[var(--text-secondary)]">Status do gateway ou aprovação manual. Créditos só são liberados após confirmação.</p>

  <div class="mt-6 flex flex-wrap gap-3">
    <input id="filter-q" type="search" placeholder="Pedido ou empresa…" class="min-w-[14rem] flex-1 rounded-xl border border-[var(--brand-border)] bg-white px-4 py-2 text-sm" />
    <select id="filter-status" class="rounded-xl border border-[var(--brand-border)] bg-white px-4 py-2 text-sm">
      <option value="">Todos os status</option>
      <option value="MANUAL_REVIEW">Revisão manual</option>
      {Object.entries(STATUS_LABELS).filter(([k]) => k !== "MANUAL_REVIEW").map(([value, label]) => (
        <option value={value}>{label}</option>
      ))}
    </select>
    <button type="button" id="btn-reload" class="es-btn es-btn-secondary">Buscar</button>
  </div>

  <div class="mt-6 overflow-x-auto rounded-2xl border border-[var(--brand-border)] bg-white">
    <table class="min-w-full text-sm">
      <thead class="border-b bg-[var(--brand-background)] text-left">
        <tr>
          <th class="p-3">Pedido</th>
          <th class="p-3">Empresa</th>
          <th class="p-3">Provedor</th>
          <th class="p-3">Método</th>
          <th class="p-3">Valor</th>
          <th class="p-3">Status</th>
          <th class="p-3">Ações</th>
        </tr>
      </thead>
      <tbody id="payments-body">
        <tr><td class="p-6 text-[var(--text-secondary)]" colspan="7">Carregando…</td></tr>
      </tbody>
    </table>
  </div>

  <dialog id="approve-modal" class="w-full max-w-md rounded-2xl border border-[var(--brand-border)] p-6 shadow-xl backdrop:bg-black/40">
    <h2 class="font-display text-lg font-bold">Aprovar pagamento manual</h2>
    <p class="mt-2 text-sm text-[var(--text-secondary)]">Confirme que o valor foi recebido antes de liberar créditos.</p>
    <input type="hidden" id="approve-id" />
    <input type="hidden" id="approve-amount" />
    <label class="mt-4 block text-sm">Valor confirmado (R$)<input id="confirm-amount" type="number" step="0.01" class="mt-1 w-full rounded-lg border border-[var(--brand-border)] p-2" required /></label>
    <label class="mt-3 block text-sm">Método<select id="confirm-method" class="mt-1 w-full rounded-lg border border-[var(--brand-border)] p-2">
      <option value="pix_manual">PIX manual</option>
      <option value="transferencia">Transferência</option>
      <option value="boleto">Boleto</option>
      <option value="outro">Outro</option>
    </select></label>
    <label class="mt-3 block text-sm">Motivo / observação<textarea id="confirm-reason" class="mt-1 w-full rounded-lg border border-[var(--brand-border)] p-2" rows="2" required></textarea></label>
    <label class="mt-3 flex items-start gap-2 text-sm"><input type="checkbox" id="confirm-check" class="mt-1" /><span>Confirmo que verifiquei o comprovante e o valor está correto.</span></label>
    <div class="mt-4 flex gap-3">
      <button type="button" id="btn-approve" class="es-btn es-btn-primary">Aprovar pagamento</button>
      <button type="button" id="btn-reject" class="es-btn es-btn-secondary text-red-700">Reprovar</button>
      <button type="button" id="close-approve" class="es-btn es-btn-secondary">Cancelar</button>
    </div>
  </dialog>

  <script define:vars={{ STATUS_LABELS }}>
    const fmt = (v) => Number(v ?? 0).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
    const body = document.getElementById("payments-body");
    const modal = document.getElementById("approve-modal");

    async function loadPayments() {
      const q = document.getElementById("filter-q").value;
      const status = document.getElementById("filter-status").value;
      const params = new URLSearchParams({ page: "1" });
      if (q) params.set("q", q);
      if (status) params.set("status", status);
      const res = await fetch(`/api/admin/commercial/payments?${params}`);
      const data = await res.json();
      const items = data.items ?? [];
      if (!items.length) {
        body.innerHTML = '<tr><td class="p-6 text-[var(--text-secondary)]" colspan="7">Nenhum pagamento encontrado.</td></tr>';
        return;
      }
      body.innerHTML = items.map(({ payment, order }) => `
        <tr class="border-b hover:bg-[var(--brand-background)]">
          <td class="p-3"><a class="font-mono text-xs text-[var(--brand-primary)] hover:underline" href="/admin/comercial/pedidos/${order?.orderCode ?? ""}">${order?.orderCode ?? "—"}</a></td>
          <td class="p-3">${order?.companyName ?? "—"}</td>
          <td class="p-3">${payment.provider}</td>
          <td class="p-3">${payment.method}</td>
          <td class="p-3">${fmt(payment.amount)}</td>
          <td class="p-3">${STATUS_LABELS[payment.status] ?? payment.status}</td>
          <td class="p-3">${payment.status === "MANUAL_REVIEW" ? `<button type="button" class="btn-review rounded border px-2 py-1 text-xs" data-id="${payment.id}" data-amount="${payment.amount}">Revisar</button>` : "—"}</td>
        </tr>`).join("");
    }

    body.addEventListener("click", (e) => {
      if (!e.target.classList.contains("btn-review")) return;
      document.getElementById("approve-id").value = e.target.dataset.id;
      document.getElementById("approve-amount").value = e.target.dataset.amount;
      document.getElementById("confirm-amount").value = e.target.dataset.amount;
      document.getElementById("confirm-reason").value = "";
      document.getElementById("confirm-check").checked = false;
      modal.showModal();
    });

    document.getElementById("close-approve").addEventListener("click", () => modal.close());

    document.getElementById("btn-approve").addEventListener("click", async () => {
      const id = document.getElementById("approve-id").value;
      if (!document.getElementById("confirm-check").checked) { alert("Marque a confirmação antes de aprovar."); return; }
      const reason = document.getElementById("confirm-reason").value.trim();
      if (!reason) { alert("Informe o motivo."); return; }
      const res = await fetch(`/api/admin/commercial/payments/${id}/action`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "approve",
          confirm: true,
          reason,
          confirmedAmount: document.getElementById("confirm-amount").value,
          method: document.getElementById("confirm-method").value
        })
      });
      const data = await res.json();
      if (!res.ok) { alert(data.error ?? "Erro ao aprovar."); return; }
      modal.close();
      await loadPayments();
    });

    document.getElementById("btn-reject").addEventListener("click", async () => {
      const id = document.getElementById("approve-id").value;
      const reason = document.getElementById("confirm-reason").value.trim() || "Comprovante inválido";
      const res = await fetch(`/api/admin/commercial/payments/${id}/action`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "reject", reason })
      });
      if (!res.ok) { alert("Erro ao reprovar."); return; }
      modal.close();
      await loadPayments();
    });

    document.getElementById("btn-reload").addEventListener("click", loadPayments);
    document.getElementById("filter-q").addEventListener("keydown", (e) => { if (e.key === "Enter") loadPayments(); });
    document.getElementById("filter-status").addEventListener("change", loadPayments);

    const urlId = new URLSearchParams(location.search).get("id");
    loadPayments().then(() => {
      if (urlId) {
        const btn = document.querySelector(`.btn-review[data-id="${urlId}"]`);
        if (btn) btn.click();
      }
    });
  </script>
</AdminLayout>
