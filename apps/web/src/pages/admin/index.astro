---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAdminDashboardMetrics } from "../../lib/admin-dashboard";
import { countOpenSeoIssues } from "../../lib/seo-audit";

const metrics = await getAdminDashboardMetrics();
const seoIssues = await countOpenSeoIssues();
metrics.seoIssues = seoIssues;

const fmtCurrency = (v: number) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });

const jobCards = [
  ["Vagas publicadas", metrics.published],
  ["Aguardando revisão", metrics.review],
  ["Vagas agendadas", metrics.scheduled],
  ["Vagas expiradas", metrics.expired]
];

const commercialCards = [
  ["Pedidos pendentes", metrics.pendingOrders],
  ["Pagamentos em revisão", metrics.manualReviewPayments],
  ["Receita confirmada", fmtCurrency(metrics.paidRevenue)],
  ["Planos ativos", metrics.activePlans],
  ["Créditos emitidos", metrics.creditsIssued],
  ["Créditos utilizados", metrics.creditsUsed],
  ["Empresas com crédito", metrics.companiesWithCredit],
  ["Contatos abertos", metrics.openContacts]
];

const opsCards = [
  ["Falhas de webhook", metrics.webhookFailures],
  ["Problemas SEO abertos", metrics.seoIssues]
];
---
<AdminLayout title="Visão geral">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-3xl font-black">Visão geral</h1>
      <p class="mt-3 text-[var(--text-secondary)]">Métricas operacionais e comerciais consultadas no PostgreSQL.</p>
    </div>
    <a class="es-btn es-btn-secondary" href="/admin/saude">Ver saúde da infraestrutura</a>
  </div>

  <h2 class="mt-8 text-sm font-bold uppercase tracking-wide text-[var(--text-secondary)]">Vagas</h2>
  <div class="mt-3 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {jobCards.map(([label, value]) => (
      <section class="rounded-2xl border border-[var(--brand-border)] bg-white p-5">
        <p class="text-sm text-[var(--text-secondary)]">{label}</p>
        <strong class="mt-2 block font-display text-3xl">{value}</strong>
      </section>
    ))}
  </div>

  <h2 class="mt-8 text-sm font-bold uppercase tracking-wide text-[var(--text-secondary)]">Comercial</h2>
  <div class="mt-3 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {commercialCards.map(([label, value]) => (
      <section class="rounded-2xl border border-[var(--brand-border)] bg-white p-5">
        <p class="text-sm text-[var(--text-secondary)]">{label}</p>
        <strong class="mt-2 block font-display text-3xl">{value}</strong>
      </section>
    ))}
  </div>

  <h2 class="mt-8 text-sm font-bold uppercase tracking-wide text-[var(--text-secondary)]">Operação</h2>
  <div class="mt-3 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {opsCards.map(([label, value]) => (
      <section class="rounded-2xl border border-[var(--brand-border)] bg-white p-5">
        <p class="text-sm text-[var(--text-secondary)]">{label}</p>
        <strong class="mt-2 block font-display text-3xl">{value}</strong>
      </section>
    ))}
  </div>

  <div class="mt-8 flex flex-wrap gap-3">
    <a class="es-btn es-btn-primary" href="/admin/vagas/nova">Cadastrar vaga</a>
    <a class="es-btn es-btn-secondary" href="/admin/comercial/planos">Planos comerciais</a>
    <a class="es-btn es-btn-secondary" href="/admin/comercial/pedidos">Pedidos</a>
    <a class="es-btn es-btn-secondary" href="/admin/comercial/pagamentos">Pagamentos</a>
    <a class="es-btn es-btn-secondary" href="/admin/seo/auditoria">Auditoria SEO</a>
  </div>
</AdminLayout>
