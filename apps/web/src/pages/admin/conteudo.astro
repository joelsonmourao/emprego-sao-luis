---
import { desc } from "drizzle-orm";
import { articles, authors, createDatabase } from "@es/db";
import AdminLayout from "../../layouts/AdminLayout.astro";
let items: typeof articles.$inferSelect[] = []; let authorRows: typeof authors.$inferSelect[] = [];
if (process.env.DATABASE_URL) { const connection = createDatabase(process.env.DATABASE_URL); try { [items, authorRows] = await Promise.all([connection.db.select().from(articles).orderBy(desc(articles.updatedAt)).limit(100), connection.db.select().from(authors).orderBy(authors.name)]); } finally { await connection.close(); } }
---
<AdminLayout title="Conteúdo"><div class="flex flex-wrap items-center justify-between gap-3"><div><h1 class="text-3xl font-black">Conteúdo editorial</h1><p class="mt-2 text-slate-600">Notícias, guias, relatórios, autoria e histórico.</p></div><a class="rounded-xl bg-red-700 px-5 py-3 font-bold text-white" href="/admin/conteudo/novo">Novo conteúdo</a></div><section class="mt-8 rounded-2xl bg-white p-6"><h2 class="text-xl font-black">Autores</h2><form class="mt-4 grid gap-3 md:grid-cols-4" method="post" action="/api/admin/authors"><input class="rounded-lg border p-3" name="name" placeholder="Nome" required/><input class="rounded-lg border p-3" name="slug" placeholder="slug opcional"/><input class="rounded-lg border p-3" name="bio" placeholder="Biografia curta"/><button class="rounded-lg border font-bold">Cadastrar autor</button></form><p class="mt-3 text-sm text-slate-600">{authorRows.map((author) => author.name).join(" · ") || "Cadastre o primeiro autor antes de criar conteúdo."}</p></section><div class="mt-8 overflow-auto rounded-2xl bg-white"><table class="w-full text-left"><thead><tr class="border-b"><th class="p-4">Título</th><th>Tipo</th><th>Status</th><th>Atualizado</th><th></th></tr></thead><tbody>{items.map((article) => <tr class="border-b"><td class="p-4 font-bold">{article.title}<div class="font-normal text-xs text-slate-500">/{article.slug} · v{article.version}</div></td><td>{article.type}</td><td>{article.status}</td><td>{article.updatedAt.toLocaleString("pt-BR")}</td><td class="p-4"><a class="text-red-700" href={`/admin/conteudo/${article.id}/editar`}>Editar</a></td></tr>)}</tbody></table>{items.length === 0 && <p class="p-6">Nenhum conteúdo cadastrado.</p>}</div></AdminLayout>
