---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { can } from "../../lib/auth";
import { companies, createDatabase } from "@es/db";
import { desc, eq } from "drizzle-orm";

const auth = Astro.locals.auth!;
if (!can(auth, "commercial.manage")) return Astro.redirect("/admin?error=sem-permissao");

let rows: typeof companies.$inferSelect[] = [];
if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    rows = await connection.db
      .select()
      .from(companies)
      .where(eq(companies.sponsored, true))
      .orderBy(desc(companies.updatedAt))
      .limit(100);
  } finally {
    await connection.close();
  }
}
---
<AdminLayout title="Perfis empresariais">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-red-700">Monetização B2B</p>
      <h1 class="mt-2 text-3xl font-black">Perfis empresariais patrocinados</h1>
      <p class="mt-2 text-sm text-[var(--text-secondary)]">Empresas com flag de patrocínio. Produto B2B — nunca paywall para candidatos.</p>
    </div>
    <a class="rounded-lg border px-4 py-2 font-bold" href="/admin/empresas">Todas as empresas</a>
  </div>
  <div class="mt-8 overflow-auto rounded-2xl bg-white">
    <table class="w-full text-left text-sm">
      <thead><tr class="border-b"><th class="p-4">Empresa</th><th>Slug</th><th>Ativa</th><th></th></tr></thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-b">
            <td class="p-4 font-bold">{row.name}</td>
            <td>/{row.slug}</td>
            <td>{row.active ? "sim" : "não"}</td>
            <td class="p-4"><a class="text-red-700" href="/admin/empresas">Gerir</a></td>
          </tr>
        ))}
      </tbody>
    </table>
    {rows.length === 0 && <p class="p-6 text-sm text-slate-600">Nenhum perfil patrocinado cadastrado.</p>}
  </div>
</AdminLayout>
