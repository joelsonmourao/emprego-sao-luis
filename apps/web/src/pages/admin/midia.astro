---
import { desc } from "drizzle-orm"; import { createDatabase, mediaAssets } from "@es/db"; import AdminLayout from "../../layouts/AdminLayout.astro";
let assets: typeof mediaAssets.$inferSelect[]=[]; if(process.env.DATABASE_URL){const connection=createDatabase(process.env.DATABASE_URL);try{assets=await connection.db.select().from(mediaAssets).orderBy(desc(mediaAssets.createdAt)).limit(200);}finally{await connection.close();}}
---
<AdminLayout title="Mídia"><div class="flex flex-wrap justify-between gap-3"><div><h1 class="text-3xl font-black">Biblioteca de mídia</h1><p class="mt-2 text-slate-600">Imagens com texto alternativo e armazenamento R2/S3.</p></div><a class="rounded-lg border px-4 py-2" href="/admin/aparencia">Aparência do portal</a></div><form class="mt-6 grid gap-4 rounded-2xl bg-white p-6" method="post" action="/api/admin/media" enctype="multipart/form-data"><label>Imagem (JPEG, PNG, WebP ou GIF; até 10 MB)<input class="mt-1 block w-full rounded-lg border p-3" type="file" name="file" accept="image/jpeg,image/png,image/webp,image/gif" required/></label><label>Texto alternativo<input class="mt-1 w-full rounded-lg border p-3" name="altText" required maxlength="240"/></label><button class="rounded-xl bg-red-700 p-4 font-bold text-white">Enviar para o armazenamento</button></form><section class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">{assets.map((asset)=><article class="overflow-hidden rounded-2xl bg-white"><img class="aspect-video w-full object-cover" src={asset.url} alt={asset.altText ?? ""}/><div class="p-4"><strong class="break-all text-sm">{asset.originalName}</strong><p class="mt-1 text-xs text-slate-600">{asset.mimeType} · {(asset.size/1024).toFixed(1)} KB</p><p class="mt-2 text-sm">{asset.altText}</p><button class="mt-3 text-sm font-bold text-red-700" type="button" data-copy={asset.url}>Copiar URL</button></div></article>)}</section>{assets.length===0&&<p class="mt-8 rounded-xl border bg-white p-6">Nenhuma mídia cadastrada.</p>}<script>document.querySelectorAll<HTMLElement>("[data-copy]").forEach((button)=>button.addEventListener("click",()=>navigator.clipboard.writeText(button.dataset.copy??"")));</script></AdminLayout>
