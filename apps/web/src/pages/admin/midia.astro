---
import { adCreatives, articles, brandAssets, companies, createDatabase, mediaAssets } from "@es/db";
import { desc, isNotNull } from "drizzle-orm";
import AdminLayout from "../../layouts/AdminLayout.astro";

let assets: typeof mediaAssets.$inferSelect[] = [];
const usage = new Map<string, number>();
if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    assets = await connection.db.select().from(mediaAssets).orderBy(desc(mediaAssets.createdAt)).limit(200);
    const [articleUrls, companyUrls, creativeUrls, brandMedia] = await Promise.all([
      connection.db.select({ url: articles.coverImageUrl }).from(articles).where(isNotNull(articles.coverImageUrl)),
      connection.db.select({ url: companies.logoUrl }).from(companies).where(isNotNull(companies.logoUrl)),
      connection.db.select({ url: adCreatives.imageUrl }).from(adCreatives),
      connection.db.select({ id: brandAssets.mediaId }).from(brandAssets).where(isNotNull(brandAssets.mediaId))
    ]);
    for (const row of [...articleUrls, ...companyUrls, ...creativeUrls]) {
      if (row.url) usage.set(row.url, (usage.get(row.url) ?? 0) + 1);
    }
    for (const row of brandMedia) {
      if (row.id) usage.set(row.id, (usage.get(row.id) ?? 0) + 1);
    }
  } finally {
    await connection.close();
  }
}
---

<AdminLayout title="Mídia">
  <div class="flex flex-wrap justify-between gap-3">
    <div>
      <h1 class="text-3xl font-black">Biblioteca de mídia</h1>
      <p class="mt-2 text-slate-600">Imagens persistidas em R2/S3 ou no volume local compartilhado.</p>
    </div>
    <a class="rounded-lg border px-4 py-2" href="/admin/aparencia">Aparência do portal</a>
  </div>

  <form class="mt-6 grid gap-4 rounded-2xl bg-white p-6" method="post" action="/api/admin/media" enctype="multipart/form-data">
    <label>
      Imagem (JPEG, PNG, WebP ou GIF; até 10 MB)
      <input class="mt-1 block w-full rounded-lg border p-3" type="file" name="file" accept="image/jpeg,image/png,image/webp,image/gif" required />
    </label>
    <label>
      Texto alternativo
      <input class="mt-1 w-full rounded-lg border p-3" name="altText" required maxlength="240" />
    </label>
    <button class="rounded-xl bg-red-700 p-4 font-bold text-white">Enviar para o armazenamento</button>
  </form>

  <section class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    {assets.map((asset) => {
      const used = (usage.get(asset.url) ?? 0) + (usage.get(asset.id) ?? 0);
      return (
        <article class="overflow-hidden rounded-2xl bg-white">
          <img class="aspect-video w-full object-cover" src={asset.url} alt={asset.altText ?? ""} />
          <div class="grid gap-3 p-4">
            <strong class="break-all text-sm">{asset.originalName}</strong>
            <p class="text-xs text-slate-600">{asset.mimeType} · {(asset.size / 1024).toFixed(1)} KB</p>
            <p class="text-xs font-semibold text-slate-600">{used > 0 ? `Em uso em ${used} local(is)` : "Sem uso ativo detectado"}</p>
            <form class="grid gap-2" method="post" action={`/api/admin/media/${asset.id}`}>
              <input type="hidden" name="action" value="UPDATE_ALT" />
              <label class="text-xs font-bold">Texto alternativo
                <input class="mt-1 w-full rounded-lg border p-2 text-sm" name="altText" value={asset.altText ?? ""} required maxlength="240" />
              </label>
              <button class="rounded-lg border px-3 py-2 text-sm font-bold">Atualizar ALT</button>
            </form>
            <button class="text-sm font-bold text-red-700" type="button" data-copy={asset.url}>Copiar URL</button>
            <form method="post" action={`/api/admin/media/${asset.id}`}>
              <input type="hidden" name="action" value="DELETE" />
              <button class="w-full rounded-lg border border-red-200 px-3 py-2 text-sm font-bold text-red-700 disabled:opacity-50" disabled={used > 0}>
                {used > 0 ? "Em uso: exclusão bloqueada" : "Excluir com segurança"}
              </button>
            </form>
          </div>
        </article>
      );
    })}
  </section>
  {assets.length === 0 && <p class="mt-8 rounded-xl border bg-white p-6">Nenhuma mídia cadastrada.</p>}
  <script>
    document.querySelectorAll<HTMLElement>("[data-copy]").forEach((button) =>
      button.addEventListener("click", () => navigator.clipboard.writeText(button.dataset.copy ?? ""))
    );
  </script>
</AdminLayout>
