---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createDatabase, webStories } from "@es/db";
import { desc } from "drizzle-orm";

let rows: typeof webStories.$inferSelect[] = [];
if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    rows = await connection.db.select().from(webStories).orderBy(desc(webStories.updatedAt)).limit(100);
  } finally {
    await connection.close();
  }
}
---
<AdminLayout title="Web Stories">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-black">Web Stories</h1>
      <p class="mt-2 text-sm text-[var(--text-secondary)]">
        Somente a partir de conteúdos elegíveis e aprovados. Nunca publicar automaticamente nem transformar toda notícia em Story.
      </p>
    </div>
    <a class="rounded-lg bg-red-700 px-4 py-2 font-bold text-white" href="/admin/web-stories/nova">Nova Web Story</a>
  </div>
  <section class="mt-8 overflow-x-auto rounded-2xl bg-white p-6">
    {rows.length === 0 ? (
      <p class="text-sm text-slate-600">Nenhuma Web Story cadastrada. Crie apenas a partir de artigos fortes marcados como elegíveis.</p>
    ) : (
      <table class="min-w-full text-sm">
        <thead>
          <tr class="border-b text-left">
            <th class="p-3">Título</th>
            <th class="p-3">Status</th>
            <th class="p-3">Atualização</th>
            <th class="p-3">Ação</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((story) => (
            <tr class="border-b">
              <td class="p-3 font-bold">{story.title}</td>
              <td class="p-3">{story.status}</td>
              <td class="p-3">{story.updatedAt.toLocaleString("pt-BR")}</td>
              <td class="p-3"><a class="font-bold text-red-700 underline" href={`/admin/web-stories/${story.id}`}>Abrir</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>
</AdminLayout>
