---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createDatabase, webStories } from "@es/db";
import { eq } from "drizzle-orm";

const id = Astro.params.id ?? "";
let story: typeof webStories.$inferSelect | null = null;
if (process.env.DATABASE_URL && id) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    const [row] = await connection.db.select().from(webStories).where(eq(webStories.id, id)).limit(1);
    story = row ?? null;
  } finally {
    await connection.close();
  }
}
if (!story) return Astro.redirect("/admin/web-stories");
const pages = Array.isArray(story.pages) ? story.pages : [];
---
<AdminLayout title={`Web Story: ${story.title}`}>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-black">{story.title}</h1>
      <p class="mt-2 text-sm">Status: <strong>{story.status}</strong> · Slug: {story.slug}</p>
    </div>
    <a class="rounded-lg border px-4 py-2 font-bold" href="/admin/web-stories">Voltar</a>
  </div>
  <section class="mt-6 grid gap-6 lg:grid-cols-[1fr_320px]">
    <article class="rounded-2xl bg-white p-6">
      <h2 class="font-black">Páginas</h2>
      <ol class="mt-4 grid gap-3">
        {pages.map((page: any) => (
          <li class="rounded-xl border p-4">
            <p class="text-xs font-bold uppercase text-slate-500">Página {page.order}</p>
            <strong class="mt-1 block">{page.headline}</strong>
            {page.body && <p class="mt-2 text-sm text-slate-600">{page.body}</p>}
          </li>
        ))}
      </ol>
    </article>
    <aside class="rounded-2xl bg-white p-6">
      <h2 class="font-black">Preview mobile</h2>
      <div class="mx-auto mt-4 h-[520px] w-[260px] overflow-hidden rounded-[2rem] border-8 border-slate-900 bg-slate-950 text-white shadow-xl">
        <div class="h-full overflow-y-auto p-4">
          {story.posterUrl && <img src={story.posterUrl} alt={story.posterAlt ?? ""} class="mb-3 h-40 w-full rounded-xl object-cover" />}
          {pages.map((page: any) => (
            <div class="mb-4 rounded-xl bg-white/10 p-3">
              <strong class="block text-sm">{page.headline}</strong>
              {page.body && <p class="mt-1 text-xs text-white/80">{page.body}</p>}
            </div>
          ))}
        </div>
      </div>
      <p class="mt-4 text-xs text-slate-600">Publicação permanece manual. Duplicar só como rascunho.</p>
      {story.status === "PUBLISHED" && <a class="mt-3 inline-flex font-bold text-red-700 underline" href={`/web-stories/${story.slug}`}>Ver página pública</a>}
    </aside>
  </section>
</AdminLayout>
