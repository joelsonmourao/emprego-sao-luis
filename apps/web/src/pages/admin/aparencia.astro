---
import { eq } from "drizzle-orm"; import { createDatabase, settings } from "@es/db"; import AdminLayout from "../../layouts/AdminLayout.astro";
let visual:Record<string,string>={};if(process.env.DATABASE_URL){const connection=createDatabase(process.env.DATABASE_URL);try{const [row]=await connection.db.select().from(settings).where(eq(settings.key,"visual_identity"));visual=(row?.value??{}) as Record<string,string>;}finally{await connection.close();}}
---
<AdminLayout title="Aparência"><h1 class="text-3xl font-black">Aparência do portal</h1><p class="mt-2 text-slate-600">Identidade visual pública versionada no banco.</p><form class="mt-6 grid gap-4 rounded-2xl bg-white p-6 md:grid-cols-2" method="post" action="/api/admin/appearance"><label>Nome do portal<input class="mt-1 w-full rounded-lg border p-3" name="siteName" value={visual.siteName??"Empregos São Luís"} required/></label><label>Cor principal<input class="mt-1 h-12 w-full rounded-lg border p-1" type="color" name="primaryColor" value={visual.primaryColor??"#b91c1c"}/></label><label>URL do logotipo<input class="mt-1 w-full rounded-lg border p-3" type="url" name="logoUrl" value={visual.logoUrl??""}/></label><label>URL do ícone<input class="mt-1 w-full rounded-lg border p-3" type="url" name="iconUrl" value={visual.iconUrl??""}/></label><label class="md:col-span-2">Descrição institucional<textarea class="mt-1 w-full rounded-lg border p-3" name="tagline">{visual.tagline??"Vagas e oportunidades em São Luís e no Maranhão."}</textarea></label><button class="rounded-xl bg-red-700 p-4 font-bold text-white md:col-span-2">Salvar aparência</button></form></AdminLayout>
