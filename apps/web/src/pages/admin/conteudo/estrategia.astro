---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { articles, contentClusters, contentPillars, createDatabase } from "@es/db";
import { asc } from "drizzle-orm";
import { auditEditorialContent } from "../../../lib/editorial-audit";

let articleRows: typeof articles.$inferSelect[] = [];
let pillars: typeof contentPillars.$inferSelect[] = [];
let clusters: typeof contentClusters.$inferSelect[] = [];
if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    [articleRows, pillars, clusters] = await Promise.all([
      connection.db.select().from(articles).orderBy(asc(articles.title)),
      connection.db.select().from(contentPillars).orderBy(asc(contentPillars.name)),
      connection.db.select().from(contentClusters).orderBy(asc(contentClusters.name))
    ]);
  } finally { await connection.close(); }
}
const audit = auditEditorialContent(articleRows);
---
<AdminLayout title="Estratégia editorial">
  <div class="flex flex-wrap items-start justify-between gap-4"><div><h1 class="text-3xl font-black">Estratégia editorial</h1><p class="mt-2 text-sm text-[var(--text-secondary)]">Redação interna com revisão humana. IA pode auxiliar pauta e rascunho, mas nunca publica automaticamente.</p></div><a class="rounded-lg bg-red-700 px-4 py-2 font-bold text-white" href="/admin/conteudo/novo">Novo conteúdo</a></div>
  <section class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <article class="rounded-xl bg-white p-5"><p class="text-sm">Conteúdo raso</p><strong class="text-3xl">{audit.thin.length}</strong></article>
    <article class="rounded-xl bg-white p-5"><p class="text-sm">Artigos órfãos</p><strong class="text-3xl">{audit.orphan.length}</strong></article>
    <article class="rounded-xl bg-white p-5"><p class="text-sm">Links internos quebrados</p><strong class="text-3xl">{audit.brokenLinks.length}</strong></article>
    <article class="rounded-xl bg-white p-5"><p class="text-sm">Canibalizações</p><strong class="text-3xl">{audit.cannibalization.length}</strong></article>
  </section>
  <section class="mt-8 rounded-2xl bg-white p-6"><h2 class="text-xl font-black">Pilares e clusters</h2><div class="mt-4 grid gap-4 md:grid-cols-2">{pillars.map((pillar) => <article class="rounded-xl border p-4"><h3 class="font-black">{pillar.name}</h3><p class="text-sm text-slate-600">{pillar.description}</p><ul class="mt-3 list-disc pl-5 text-sm">{clusters.filter((cluster) => cluster.pillarId === pillar.id).map((cluster) => <li>{cluster.name}</li>)}</ul>{pillar.audience === "COMPANY" && <a class="mt-3 inline-flex text-sm font-bold text-red-700" href="/publicar-vaga">Destino comercial: /publicar-vaga</a>}</article>)}</div></section>
  <section class="mt-8 grid gap-6 lg:grid-cols-2">
    <article class="rounded-2xl bg-white p-6"><h2 class="font-black">Pendências de governança</h2><ul class="mt-3 grid gap-2 text-sm">{audit.missingGovernance.map((item) => <li><a class="underline" href={`/admin/conteudo/${item.id}/editar`}>{item.title}</a> — pilar, cluster, fonte, revisor ou revisão factual pendente.</li>)}</ul></article>
    <article class="rounded-2xl bg-white p-6"><h2 class="font-black">Conteúdo desatualizado</h2><ul class="mt-3 grid gap-2 text-sm">{audit.stale.map((item) => <li><a class="underline" href={`/admin/conteudo/${item.id}/editar`}>{item.title}</a> — atualizado em {item.updatedAt.toLocaleDateString("pt-BR")}</li>)}</ul></article>
    <article class="rounded-2xl bg-white p-6"><h2 class="font-black">Links quebrados</h2><ul class="mt-3 grid gap-2 text-sm">{audit.brokenLinks.map((item) => <li><a class="underline" href={`/admin/conteudo/${item.articleId}/editar`}>{item.title}</a>: {item.href}</li>)}</ul></article>
    <article class="rounded-2xl bg-white p-6"><h2 class="font-black">Canibalização</h2><ul class="mt-3 grid gap-3 text-sm">{audit.cannibalization.map((item) => <li><strong>{item.keyword}</strong>: {item.articles.map((article) => article.title).join("; ")}</li>)}</ul></article>
    <article class="rounded-2xl bg-white p-6 lg:col-span-2"><h2 class="font-black">Sugestões automáticas de links internos</h2><ul class="mt-3 grid gap-3 text-sm">{audit.suggestions.map((item) => <li><a class="font-bold underline" href={`/admin/conteudo/${item.articleId}/editar`}>{item.title}</a><span class="ml-2">{item.suggestions.join(" · ")}</span></li>)}</ul></article>
  </section>
</AdminLayout>

