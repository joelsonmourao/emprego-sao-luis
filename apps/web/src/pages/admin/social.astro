---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { can } from "../../lib/auth";
import { createDatabase, jobs, socialPosts, socialPublications } from "@es/db";
import { desc, eq } from "drizzle-orm";

const auth = Astro.locals.auth!;
if (!can(auth, "social.manage")) return new Response("Proibido", { status: 403 });

const created = Astro.url.searchParams.get("created") === "1";
const publicBase = process.env.S3_PUBLIC_URL ?? "";

let items: Array<{ id: string; title: string; code: string }> = [];
let posts: Array<{ post: typeof socialPosts.$inferSelect; publication: typeof socialPublications.$inferSelect | null; title: string; code: string }> = [];

if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    items = await connection.db.select({ id: jobs.id, title: jobs.normalizedTitle, code: jobs.publicCode }).from(jobs).where(eq(jobs.publicationStatus, "PUBLISHED")).orderBy(desc(jobs.publishedAt)).limit(100);
    const rows = await connection.db.select({ post: socialPosts, job: jobs, publication: socialPublications }).from(socialPosts).innerJoin(jobs, eq(socialPosts.entityId, jobs.id)).leftJoin(socialPublications, eq(socialPublications.postId, socialPosts.id)).orderBy(desc(socialPosts.createdAt)).limit(20);
    posts = rows.map((row) => ({ post: row.post, publication: row.publication, title: row.job.normalizedTitle, code: row.job.publicCode }));
  } finally {
    await connection.close();
  }
}
---
<AdminLayout title="Estúdio social">
  <h1 class="text-3xl font-black">Estúdio social</h1>
  <p class="mt-3 text-slate-600">Gere PNG, legenda, alt text e publicação oficial para Instagram.</p>
  {created && <p class="mt-4 rounded-xl border border-green-200 bg-green-50 p-4 text-green-800">Publicação enfileirada. O status aparecerá no histórico abaixo.</p>}

  <form class="mt-8 grid max-w-2xl gap-5 rounded-2xl bg-white p-6" method="post" action="/api/admin/social">
    <label>Vaga<select class="mt-1 w-full rounded-lg border p-3" name="jobId" required><option value="">Selecione</option>{items.map((item) => <option value={item.id}>{item.code} — {item.title}</option>)}</select></label>
    <label>Formato<select class="mt-1 w-full rounded-lg border p-3" name="format"><option value="feed">Feed 1080×1350</option><option value="story">Story 1080×1920</option><option value="square">Quadrado 1080×1080</option><option value="carousel">Carrossel 1080×1350</option></select></label>
    <label class="flex gap-3"><input type="checkbox" name="autoPublish" value="yes" /><span>Publicar automaticamente após gerar (requer Meta configurada)</span></label>
    <button class="rounded-xl bg-red-700 p-4 font-bold text-white">Gerar publicação</button>
  </form>

  <section class="mt-10 rounded-2xl bg-white p-6">
    <h2 class="text-2xl font-black">Histórico</h2>
    <div class="mt-4 overflow-auto">
      <table class="min-w-full text-sm">
        <thead><tr class="text-left text-slate-500"><th class="py-2">Data</th><th>Vaga</th><th>Formato</th><th>Status</th><th>Publicação</th><th>Preview</th></tr></thead>
        <tbody>
          {posts.map(({ post, publication, title, code }) => (
            <tr class="border-t">
              <td class="py-2 pr-3 whitespace-nowrap">{post.createdAt?.toLocaleString("pt-BR")}</td>
              <td class="pr-3">{code} — {title}</td>
              <td class="pr-3">{post.format}</td>
              <td class="pr-3">{post.status}</td>
              <td class="pr-3">{publication ? `${publication.status}${publication.error ? ` (${publication.error})` : ""}` : post.autoPublish ? "Aguardando Meta" : "Manual"}</td>
              <td>{post.imageKey && publicBase ? <a class="text-red-700 underline" href={`${publicBase.replace(/\/$/, "")}/${post.imageKey}`} target="_blank" rel="noopener noreferrer">Abrir PNG</a> : "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>
