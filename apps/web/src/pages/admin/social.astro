---
import AdminLayout from "../../layouts/AdminLayout.astro"; import { can } from "../../lib/auth"; import { createDatabase, jobs } from "@es/db"; import { desc, eq } from "drizzle-orm";
const auth = Astro.locals.auth!; if (!can(auth, "social.manage")) return new Response("Proibido", { status: 403 }); let items: Array<{id:string; title:string; code:string}> = []; if (process.env.DATABASE_URL) { const connection = createDatabase(process.env.DATABASE_URL); try { items = await connection.db.select({ id: jobs.id, title: jobs.normalizedTitle, code: jobs.publicCode }).from(jobs).where(eq(jobs.publicationStatus, "PUBLISHED")).orderBy(desc(jobs.publishedAt)).limit(100); } finally { await connection.close(); } }
---
<AdminLayout title="Estúdio social"><h1 class="text-3xl font-black">Estúdio Instagram</h1><p class="mt-3 text-slate-600">Gere PNG, legenda, alt text e publicação oficial.</p><form class="mt-8 grid max-w-2xl gap-5 rounded-2xl bg-white p-6" method="post" action="/api/admin/social"><label>Vaga<select class="mt-1 w-full rounded-lg border p-3" name="jobId" required><option value="">Selecione</option>{items.map((item) => <option value={item.id}>{item.code} — {item.title}</option>)}</select></label><label>Formato<select class="mt-1 w-full rounded-lg border p-3" name="format"><option value="feed">Feed 1080×1350</option><option value="story">Story 1080×1920</option><option value="square">Quadrado 1080×1080</option><option value="carousel">Carrossel 1080×1350</option></select></label><label class="flex gap-3"><input type="checkbox" name="autoPublish" value="yes"/><span>Publicar automaticamente após gerar (requer Meta configurada)</span></label><button class="rounded-xl bg-red-700 p-4 font-bold text-white">Gerar publicação</button></form></AdminLayout>
