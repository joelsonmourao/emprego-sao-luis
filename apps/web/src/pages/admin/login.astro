---
import "../../styles/global.css";
import { ADMIN_PASSWORD_MIN_LENGTH, ADMIN_PASSWORD_MIN_MESSAGE } from "@es/shared";
if (Astro.locals.auth) return Astro.redirect("/admin");
const next = Astro.url.searchParams.get("next") ?? "/admin";
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>Painel administrativo</title></head><body class="grid min-h-screen place-items-center bg-slate-950 p-4"><main class="es-light-form-panel w-full max-w-md rounded-2xl bg-white p-8"><h1 class="text-3xl font-black">Painel administrativo</h1><p class="mt-2 text-sm text-[var(--text-secondary)]">Acesso da equipe do portal. Empresas anunciantes usam a <a class="font-semibold text-[var(--brand-primary)] underline" href="/empresa/login">área da empresa</a>.</p><form class="mt-8 grid gap-5" method="post" action="/api/admin/login"><input type="hidden" name="next" value={next}/><label>E-mail<input class="mt-1 w-full rounded-xl border p-3" type="email" name="email" autocomplete="username" required/></label><label>Senha<input class="mt-1 w-full rounded-xl border p-3" type="password" name="password" autocomplete="current-password" minlength={ADMIN_PASSWORD_MIN_LENGTH} aria-describedby="admin-password-help" data-password-input data-min-message={ADMIN_PASSWORD_MIN_MESSAGE} required/><span id="admin-password-help" class="es-form-hint block">{ADMIN_PASSWORD_MIN_MESSAGE}</span></label><label>Código de autenticação <span class="text-sm text-slate-500">(se ativado)</span><input class="mt-1 w-full rounded-xl border p-3" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" name="otp" autocomplete="one-time-code"/></label><button class="rounded-xl bg-red-700 p-3 font-bold text-white">Entrar</button></form><a class="mt-5 inline-block font-bold text-red-700" href="/recuperar-admin">Esqueci minha senha</a></main><script>const input = document.querySelector('[data-password-input]'); if (input instanceof HTMLInputElement) { input.addEventListener('invalid', () => input.setCustomValidity(input.dataset.minMessage ?? '')); input.addEventListener('input', () => input.setCustomValidity('')); }</script></body></html>
