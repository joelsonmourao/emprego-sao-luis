---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { can } from "../../lib/auth";
import { companies, createDatabase, jobs } from "@es/db";
import { desc, eq } from "drizzle-orm";

const auth = Astro.locals.auth!;
if (!can(auth, "commercial.manage")) return Astro.redirect("/admin?error=sem-permissao");

let rows: Array<{ id: string; title: string; company: string | null; publicationStatus: string; featured: boolean; sponsored: boolean }> = [];
if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    rows = await connection.db
      .select({
        id: jobs.id,
        title: jobs.normalizedTitle,
        company: companies.name,
        publicationStatus: jobs.publicationStatus,
        featured: jobs.featured,
        sponsored: jobs.sponsored
      })
      .from(jobs)
      .leftJoin(companies, eq(companies.id, jobs.companyId))
      .where(eq(jobs.featured, true))
      .orderBy(desc(jobs.updatedAt))
      .limit(100);
  } finally {
    await connection.close();
  }
}
---
<AdminLayout title="Vagas patrocinadas">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-red-700">Monetização B2B</p>
      <h1 class="mt-2 text-3xl font-black">Vagas patrocinadas / destacadas</h1>
      <p class="mt-2 text-sm text-[var(--text-secondary)]">
        Destaque é produto pago para empresas. Candidatos acessam e se candidatam gratuitamente. Destaque ≠ verificação.
      </p>
    </div>
    <a class="rounded-lg border px-4 py-2 font-bold" href="/admin/comercial/planos">Planos</a>
  </div>
  <div class="mt-8 overflow-auto rounded-2xl bg-white">
    <table class="w-full text-left text-sm">
      <thead><tr class="border-b"><th class="p-4">Vaga</th><th>Empresa</th><th>Status</th><th>Flags</th><th></th></tr></thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-b">
            <td class="p-4 font-bold">{row.title}</td>
            <td>{row.company ?? "—"}</td>
            <td>{row.publicationStatus}</td>
            <td>{[row.featured ? "destaque" : null, row.sponsored ? "patrocinada" : null].filter(Boolean).join(" · ") || "—"}</td>
            <td class="p-4"><a class="text-red-700" href={`/admin/vagas/${row.id}/editar`}>Editar</a></td>
          </tr>
        ))}
      </tbody>
    </table>
    {rows.length === 0 && <p class="p-6 text-sm text-slate-600">Nenhuma vaga destacada no momento.</p>}
  </div>
</AdminLayout>
