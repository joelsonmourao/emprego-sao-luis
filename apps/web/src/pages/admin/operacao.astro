---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { can } from "../../lib/auth";
import { getOperationalHealth } from "../../lib/operational-health";
import { getQueueSummaries } from "../../lib/operations";
import { createDatabase, indexingEvents } from "@es/db";
import { count, desc, eq } from "drizzle-orm";

const auth = Astro.locals.auth!;
if (!can(auth, "queues.manage")) return new Response("Proibido", { status: 403 });

const [queues, health] = await Promise.all([getQueueSummaries(), getOperationalHealth()]);
const retried = Astro.url.searchParams.get("retry") === "1";

let indexingPending = 0;
let indexingFailed = 0;
let indexingRows: Array<typeof indexingEvents.$inferSelect> = [];
if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    const [pendingRow] = await connection.db.select({ value: count() }).from(indexingEvents).where(eq(indexingEvents.status, "PENDING"));
    const [failedRow] = await connection.db.select({ value: count() }).from(indexingEvents).where(eq(indexingEvents.status, "FAILED"));
    indexingPending = pendingRow?.value ?? 0;
    indexingFailed = failedRow?.value ?? 0;
    indexingRows = await connection.db.select().from(indexingEvents).orderBy(desc(indexingEvents.createdAt)).limit(15);
  } finally {
    await connection.close();
  }
}

const stateLabel: Record<string, string> = { healthy: "Saudável", degraded: "Degradado", not_configured: "Não configurado", unavailable: "Indisponível", unknown: "Desconhecido" };
---
<AdminLayout title="Operação">
  <h1 class="text-3xl font-black">Operação e monitoramento</h1>
  <p class="mt-2 text-slate-600">Filas BullMQ, indexação, integrações e saúde da infraestrutura.</p>
  {retried && <p class="mt-4 rounded-xl border border-blue-200 bg-blue-50 p-4 text-blue-900">Job reenfileirado com auditoria.</p>}

  <section class="mt-8 grid gap-4 md:grid-cols-4">
    {Object.entries(health).map(([key, value]) => (
      <article class="rounded-2xl bg-white p-5">
        <p class="text-sm uppercase text-slate-500">{key}</p>
        <p class="mt-2 text-lg font-bold">{stateLabel[value] ?? value}</p>
      </article>
    ))}
  </section>

  <section class="mt-8 rounded-2xl bg-white p-6">
    <h2 class="text-xl font-black">Filas BullMQ</h2>
    <div class="mt-4 grid gap-4">
      {queues.map((queue) => (
        <article class="rounded-xl border p-4">
          <h3 class="font-bold">{queue.name}</h3>
          <p class="mt-1 text-sm text-slate-600">Aguardando {queue.counts.waiting} · Ativa {queue.counts.active} · Concluída {queue.counts.completed} · Falhou {queue.counts.failed} · Atrasada {queue.counts.delayed}</p>
          {queue.recentFailed.length > 0 && (
            <div class="mt-3 overflow-auto">
              <table class="min-w-full text-sm">
                <thead><tr class="text-left text-slate-500"><th class="py-1">Job</th><th>Tentativas</th><th>Erro</th><th></th></tr></thead>
                <tbody>
                  {queue.recentFailed.map((job) => (
                    <tr class="border-t">
                      <td class="py-1 pr-3">{job.id}</td>
                      <td class="pr-3">{job.attemptsMade}</td>
                      <td class="max-w-sm truncate pr-3" title={job.failedReason ?? ""}>{job.failedReason ?? "—"}</td>
                      <td class="flex gap-2">
                        <form method="post" action={`/api/admin/operations/jobs/${queue.name}/${job.id}/retry`}><button class="rounded border px-2 py-1">Repetir</button></form>
                        <form method="post" action={`/api/admin/operations/jobs/${queue.name}/${job.id}/cancel`}><button class="rounded border px-2 py-1">Remover</button></form>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="mt-8 rounded-2xl bg-white p-6">
    <h2 class="text-xl font-black">Indexação (banco)</h2>
    <p class="mt-2 text-sm text-slate-600">Pendentes {indexingPending} · Falhas {indexingFailed}</p>
    <div class="mt-4 overflow-auto">
      <table class="min-w-full text-sm">
        <thead><tr class="text-left text-slate-500"><th class="py-2">Data</th><th>Provedor</th><th>Status</th><th>URL</th><th></th></tr></thead>
        <tbody>
          {indexingRows.map((event) => (
            <tr class="border-t">
              <td class="py-2 pr-3 whitespace-nowrap">{event.createdAt?.toLocaleString("pt-BR")}</td>
              <td class="pr-3">{event.provider}</td>
              <td class="pr-3">{event.status}</td>
              <td class="max-w-xs truncate pr-3">{event.url}</td>
              <td>{event.status === "FAILED" && <form method="post" action={`/api/admin/indexing/${event.id}/retry`}><button class="rounded border px-2 py-1">Reprocessar</button></form>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>
