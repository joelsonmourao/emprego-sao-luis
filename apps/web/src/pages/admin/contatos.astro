---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { contactSubmissions, createDatabase } from "@es/db";
import { desc } from "drizzle-orm";

let contacts: Array<typeof contactSubmissions.$inferSelect> = [];
if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    contacts = await connection.db.select().from(contactSubmissions).orderBy(desc(contactSubmissions.createdAt)).limit(100);
  } finally {
    await connection.close();
  }
}
---
<AdminLayout title="Contatos">
  <h1 class="font-display text-3xl font-black">Contatos recebidos</h1>
  <div class="mt-8 overflow-x-auto rounded-2xl border border-[var(--brand-border)] bg-white">
    <table class="min-w-full text-sm">
      <thead class="border-b bg-[var(--brand-background)] text-left">
        <tr><th class="p-3">Protocolo</th><th class="p-3">Nome</th><th class="p-3">Categoria</th><th class="p-3">Assunto</th><th class="p-3">Status</th><th class="p-3">Data</th></tr>
      </thead>
      <tbody>
        {contacts.length ? contacts.map((c) => (
          <tr class="border-b">
            <td class="p-3 font-mono text-xs">{c.protocol}</td>
            <td class="p-3">{c.name}</td>
            <td class="p-3">{c.category}</td>
            <td class="p-3">{c.subject}</td>
            <td class="p-3">{c.status}</td>
            <td class="p-3">{new Date(c.createdAt).toLocaleString("pt-BR")}</td>
          </tr>
        )) : <tr><td class="p-6 text-[var(--text-secondary)]" colspan="6">Nenhum contato registrado.</td></tr>}
      </tbody>
    </table>
  </div>
</AdminLayout>
