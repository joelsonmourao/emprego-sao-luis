---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { can } from "../../lib/auth";
import { createDatabase, importBatches } from "@es/db";
import { eq } from "drizzle-orm";
const auth = Astro.locals.auth!; if (!can(auth, "imports.manage")) return new Response("Proibido", { status: 403 });
const batchId = Astro.url.searchParams.get("batch"); let batch = null;
if (batchId && process.env.DATABASE_URL) { const connection = createDatabase(process.env.DATABASE_URL); try { [batch] = await connection.db.select().from(importBatches).where(eq(importBatches.id, batchId)).limit(1); } finally { await connection.close(); } }
---
<AdminLayout title="Importação"><h1 class="text-3xl font-black">Importar vagas</h1><p class="mt-3 text-slate-600">Arquivos são processados em segundo plano, com idempotência pelo conteúdo.</p>{batch && <section class="mt-6 rounded-2xl border bg-white p-6"><h2 class="text-xl font-bold">Lote {batch.fileName}</h2><dl class="mt-4 grid grid-cols-3 gap-4"><div><dt>Total</dt><dd class="text-2xl font-bold">{batch.totalRows}</dd></div><div><dt>Válidas</dt><dd class="text-2xl font-bold text-green-700">{batch.validRows}</dd></div><div><dt>Rejeitadas</dt><dd class="text-2xl font-bold text-red-700">{batch.rejectedRows}</dd></div></dl><div class="mt-5 flex flex-wrap gap-3"><a class="rounded-lg border px-4 py-2" href={`/api/admin/imports/${batch.id}/rejected.csv`}>Baixar rejeitadas</a><form method="post" action={`/api/admin/imports/${batch.id}/execute`}><select class="rounded-l-lg border p-2" name="mode"><option value="DRAFT">Importar rascunhos</option><option value="PENDING_REVIEW">Enviar para revisão</option></select><button class="rounded-r-lg bg-slate-950 p-2 text-white">Executar lote validado</button></form><form method="post" action={`/api/admin/imports/${batch.id}/undo`}><button class="rounded-lg border border-red-300 px-4 py-2 text-red-700">Desfazer lote</button></form></div></section>}<form class="mt-8 grid max-w-2xl gap-5 rounded-2xl bg-white p-6" method="post" action="/api/admin/imports" enctype="multipart/form-data"><label>Arquivo XLSX ou CSV<input class="mt-2 block w-full rounded-lg border p-3" type="file" name="file" accept=".xlsx,.csv" required/></label><label>Destino<select class="mt-2 block w-full rounded-lg border p-3" name="mode"><option value="DRY_RUN">Somente validar (dry run)</option><option value="DRAFT">Rascunho</option><option value="PENDING_REVIEW">Revisão</option><option value="PUBLISHED">Publicar após validação</option></select></label><button class="rounded-xl bg-red-700 p-4 font-bold text-white">Enviar para processamento</button></form></AdminLayout>
