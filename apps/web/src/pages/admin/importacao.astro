---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { can } from "../../lib/auth";
import { createDatabase, importBatches, importMappingTemplates } from "@es/db";
import { eq } from "drizzle-orm";
const auth=Astro.locals.auth!;if(!can(auth,"imports.manage"))return new Response("Proibido",{status:403});
const batchId=Astro.url.searchParams.get("batch");let batch=null;let templates:Array<{id:string;name:string}>=[];
if(process.env.DATABASE_URL){const connection=createDatabase(process.env.DATABASE_URL);try{if(batchId)[batch]=await connection.db.select().from(importBatches).where(eq(importBatches.id,batchId)).limit(1);templates=await connection.db.select({id:importMappingTemplates.id,name:importMappingTemplates.name}).from(importMappingTemplates);}finally{await connection.close();}}
const config=batch?.settings as {stage?:string;mode?:string;sheets?:Array<{name:string;headers:string[];preview:Array<Record<string,unknown>>}>;sheetName?:string;mapping?:Record<string,string>}|undefined;
const fields:Array<[string,string]>=[["title","Título"],["company","Empresa"],["city","Cidade"],["state","UF"],["description","Descrição"],["applyUrl","URL de candidatura"],["source","Fonte"],["expiresAt","Validade"],["externalId","Código externo"],["category","Categoria"],["sourceUrl","URL da fonte"],["employmentType","Contrato"],["workplaceType","Modalidade"],["salaryMin","Salário mínimo"],["salaryMax","Salário máximo"]];const requiredFields=["title","company","city","state","description","applyUrl","source","expiresAt"];const headers=[...new Set(config?.sheets?.flatMap((sheet)=>sheet.headers)??[])];
---
<AdminLayout title="Importação"><h1 class="text-3xl font-black">Importar vagas</h1><p class="mt-3 text-slate-600">Upload, mapeamento, validação e gravação são rastreados por lote.</p>
{batch&&config?.stage==="CONFIGURE"&&<section class="mt-6 rounded-2xl border bg-white p-6"><h2 class="text-xl font-black">Configurar {batch.fileName}</h2><form class="mt-5 grid gap-4" method="post" action={`/api/admin/imports/${batch.id}/configure`}><div class="grid gap-4 md:grid-cols-3"><label>Aba<select class="mt-1 w-full rounded-lg border p-3" name="sheetName">{config.sheets?.map((sheet)=><option value={sheet.name} selected={sheet.name===config.sheetName}>{sheet.name}</option>)}</select></label><label>Destino<select class="mt-1 w-full rounded-lg border p-3" name="mode"><option value="DRY_RUN">Somente validar</option><option value="DRAFT">Rascunho</option><option value="PENDING_REVIEW">Revisão</option><option value="PUBLISHED">Publicar</option></select></label><label>Duplicidades<select class="mt-1 w-full rounded-lg border p-3" name="duplicateStrategy"><option value="IGNORE">Ignorar</option><option value="UPDATE">Atualizar existente</option><option value="CREATE_NEW">Importar como nova</option></select></label></div><div class="grid gap-3 md:grid-cols-2">{fields.map(([field,label])=><label>{label}{requiredFields.includes(field)&&" *"}<select class="mt-1 w-full rounded-lg border p-3" name={`map_${field}`} required={requiredFields.includes(field)}><option value="">Não mapear</option>{headers.map((header)=><option value={header} selected={config.mapping?.[field]===header}>{header}</option>)}</select></label>)}</div><label>Salvar modelo reutilizável<input class="mt-1 w-full rounded-lg border p-3" name="templateName" list="mapping-templates"/><datalist id="mapping-templates">{templates.map((item)=><option value={item.name}/>)}</datalist></label><button class="rounded-xl bg-red-700 p-4 font-bold text-white">Validar e enfileirar</button></form><details class="mt-6"><summary class="font-bold">Prévia das primeiras linhas</summary><pre class="mt-3 overflow-auto rounded-xl bg-slate-950 p-4 text-xs text-white">{JSON.stringify(config.sheets?.find((sheet)=>sheet.name===config.sheetName)?.preview??[],null,2)}</pre></details></section>}
{batch&&config?.stage!=="CONFIGURE"&&<section class="mt-6 rounded-2xl border bg-white p-6"><h2 class="text-xl font-bold">Lote {batch.fileName}</h2><p class="mt-2">Status: <strong>{batch.status}</strong></p><dl class="mt-4 grid grid-cols-3 gap-4"><div><dt>Total</dt><dd class="text-2xl font-bold">{batch.totalRows}</dd></div><div><dt>Válidas</dt><dd class="text-2xl font-bold text-green-700">{batch.validRows}</dd></div><div><dt>Rejeitadas</dt><dd class="text-2xl font-bold text-red-700">{batch.rejectedRows}</dd></div></dl><div class="mt-5 flex flex-wrap gap-3"><a class="rounded-lg border px-4 py-2" href={`/api/admin/imports/${batch.id}/rejected.csv`}>Baixar rejeitadas</a><form method="post" action={`/api/admin/imports/${batch.id}/execute`}><select class="rounded-l-lg border p-2" name="mode"><option value="DRAFT">Importar rascunhos</option><option value="PENDING_REVIEW">Enviar para revisão</option></select><button class="rounded-r-lg bg-slate-950 p-2 text-white">Executar lote validado</button></form><form method="post" action={`/api/admin/imports/${batch.id}/undo`}><button class="rounded-lg border border-red-300 px-4 py-2 text-red-700">Desfazer lote</button></form></div></section>}
<form class="mt-8 grid max-w-2xl gap-5 rounded-2xl bg-white p-6" method="post" action="/api/admin/imports" enctype="multipart/form-data"><label>Arquivo XLSX ou CSV<input class="mt-2 block w-full rounded-lg border p-3" type="file" name="file" accept=".xlsx,.csv" required/></label><label>Destino inicial<select class="mt-2 block w-full rounded-lg border p-3" name="mode"><option value="DRY_RUN">Somente validar</option><option value="DRAFT">Rascunho</option><option value="PENDING_REVIEW">Revisão</option><option value="PUBLISHED">Publicar após validação</option></select></label><button class="rounded-xl bg-red-700 p-4 font-bold text-white">Enviar e configurar</button></form></AdminLayout>
