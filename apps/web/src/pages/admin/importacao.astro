---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { can } from "../../lib/auth";
const auth = Astro.locals.auth!; if (!can(auth, "imports.manage")) return new Response("Proibido", { status: 403 });
---
<AdminLayout title="Importação"><h1 class="text-3xl font-black">Importar vagas</h1><p class="mt-3 text-slate-600">Arquivos são processados em segundo plano, com idempotência pelo conteúdo.</p><form class="mt-8 grid max-w-2xl gap-5 rounded-2xl bg-white p-6" method="post" action="/api/admin/imports" enctype="multipart/form-data"><label>Arquivo XLSX ou CSV<input class="mt-2 block w-full rounded-lg border p-3" type="file" name="file" accept=".xlsx,.csv" required/></label><label>Destino<select class="mt-2 block w-full rounded-lg border p-3" name="mode"><option value="DRAFT">Rascunho</option><option value="PENDING_REVIEW">Revisão</option><option value="PUBLISHED">Publicar após validação</option></select></label><button class="rounded-xl bg-red-700 p-4 font-bold text-white">Enviar para processamento</button></form></AdminLayout>
