---
import EmpresaLayout from "../../layouts/EmpresaLayout.astro";
import { listCompanyTickets } from "../../lib/company-dashboard";

const company = Astro.locals.company!;
const tickets = await listCompanyTickets(company.id);
const created = Astro.url.searchParams.get("created") === "1";

const statusLabels: Record<string, string> = {
  OPEN: "Aberto",
  IN_PROGRESS: "Em andamento",
  RESOLVED: "Resolvido",
  CLOSED: "Fechado"
};
---
<EmpresaLayout title="Suporte">
  <h1 class="font-display text-3xl font-black">Suporte</h1>
  <p class="mt-2 text-[var(--text-secondary)]">Abra um chamado sobre pedidos, pagamentos ou publicação de vagas.</p>
  {created && (
    <p class="mt-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Chamado registrado com sucesso.</p>
  )}
  <div class="mt-8 grid gap-8 lg:grid-cols-2">
    <form class="es-card grid gap-4 p-6" method="post" action="/api/empresa/tickets">
      <h2 class="font-display text-lg font-bold">Novo chamado</h2>
      <label class="grid gap-1 text-sm font-semibold">
        Assunto
        <input class="rounded-xl border border-[var(--brand-border)] px-3 py-2.5" name="subject" required maxlength="120" />
      </label>
      <label class="grid gap-1 text-sm font-semibold">
        Mensagem
        <textarea class="min-h-32 rounded-xl border border-[var(--brand-border)] px-3 py-2.5" name="message" required maxlength="4000"></textarea>
      </label>
      <button class="es-btn es-btn-primary" type="submit">Enviar chamado</button>
    </form>
    <div>
      <h2 class="font-display text-lg font-bold">Seus chamados</h2>
      <div class="mt-4 overflow-x-auto es-card">
        <table class="min-w-full text-sm">
          <thead class="border-b border-[var(--brand-border)] bg-[var(--brand-background)] text-left">
            <tr>
              <th class="p-3">Protocolo</th>
              <th class="p-3">Assunto</th>
              <th class="p-3">Status</th>
              <th class="p-3">Data</th>
            </tr>
          </thead>
          <tbody>
            {tickets.length ? tickets.map((t) => (
              <tr class="border-b border-[var(--brand-border)]">
                <td class="p-3 font-mono text-xs">{t.protocol}</td>
                <td class="p-3">{t.subject}</td>
                <td class="p-3">{statusLabels[t.status] ?? t.status}</td>
                <td class="p-3">{new Date(t.createdAt).toLocaleDateString("pt-BR")}</td>
              </tr>
            )) : (
              <tr><td class="p-6 text-[var(--text-secondary)]" colspan="4">Nenhum chamado ainda.</td></tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</EmpresaLayout>
