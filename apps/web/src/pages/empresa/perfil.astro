---
import EmpresaLayout from "../../layouts/EmpresaLayout.astro";
import { companies, createDatabase } from "@es/db";
import { eq } from "drizzle-orm";

const company = Astro.locals.company!;
let companyProfile: { name: string; slug: string } | null = null;

if (company.companyId && process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    const [row] = await connection.db
      .select({ name: companies.name, slug: companies.slug })
      .from(companies)
      .where(eq(companies.id, company.companyId))
      .limit(1);
    if (row) companyProfile = row;
  } finally {
    await connection.close();
  }
}

const roleLabels: Record<string, string> = {
  OWNER: "Proprietário",
  MANAGER: "Gestor",
  RECRUITER: "Recrutador",
  BILLING: "Financeiro",
  VIEWER: "Visualizador"
};
---
<EmpresaLayout title="Perfil">
  <h1 class="font-display text-3xl font-black">Perfil</h1>
  <p class="mt-2 text-[var(--text-secondary)]">Dados da sua conta na área comercial.</p>
  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <section class="es-card p-6">
      <h2 class="font-display text-lg font-bold">Conta</h2>
      <dl class="mt-4 grid gap-3 text-sm">
        <div><dt class="text-[var(--text-secondary)]">Nome</dt><dd class="font-semibold">{company.name}</dd></div>
        <div><dt class="text-[var(--text-secondary)]">E-mail</dt><dd class="font-semibold">{company.email}</dd></div>
        <div><dt class="text-[var(--text-secondary)]">Perfil</dt><dd class="font-semibold">{roleLabels[company.role] ?? company.role}</dd></div>
      </dl>
    </section>
    <section class="es-card p-6">
      <h2 class="font-display text-lg font-bold">Empresa no portal</h2>
      {companyProfile ? (
        <div class="mt-4">
          <p class="font-semibold">{companyProfile.name}</p>
          <a class="mt-3 inline-flex es-btn es-btn-secondary" href={`/empresas/${companyProfile.slug}`}>Ver página pública</a>
        </div>
      ) : (
        <p class="mt-4 text-sm text-[var(--text-secondary)]">Sua empresa ainda não possui página pública vinculada. Ela será criada após a publicação da primeira vaga.</p>
      )}
    </section>
  </div>
</EmpresaLayout>
