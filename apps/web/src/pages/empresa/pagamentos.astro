---
import EmpresaLayout from "../../layouts/EmpresaLayout.astro";
import { listCompanyPayments } from "../../lib/company-dashboard";

const company = Astro.locals.company!;
const rows = await listCompanyPayments(company.email);
---
<EmpresaLayout title="Pagamentos">
  <h1 class="font-display text-3xl font-black">Pagamentos</h1>
  <p class="mt-2 text-[var(--text-secondary)]">Transações dos seus pedidos comerciais.</p>
  <div class="mt-8 overflow-x-auto es-card">
    <table class="min-w-full text-sm">
      <thead class="border-b border-[var(--brand-border)] bg-[var(--brand-background)] text-left">
        <tr>
          <th class="p-3">Pedido</th>
          <th class="p-3">Provedor</th>
          <th class="p-3">Método</th>
          <th class="p-3">Valor</th>
          <th class="p-3">Status</th>
          <th class="p-3">Data</th>
        </tr>
      </thead>
      <tbody>
        {rows.length ? rows.map(({ payment, orderCode }) => (
          <tr class="border-b border-[var(--brand-border)]">
            <td class="p-3 font-mono text-xs">{orderCode}</td>
            <td class="p-3">{payment.provider}</td>
            <td class="p-3">{payment.method}</td>
            <td class="p-3">R$ {Number(payment.amount).toFixed(2)}</td>
            <td class="p-3">{payment.status}</td>
            <td class="p-3">{new Date(payment.createdAt).toLocaleDateString("pt-BR")}</td>
          </tr>
        )) : (
          <tr><td class="p-6 text-[var(--text-secondary)]" colspan="6">Nenhum pagamento registrado.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</EmpresaLayout>
