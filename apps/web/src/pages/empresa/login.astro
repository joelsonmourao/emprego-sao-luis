---
import "../../styles/global.css";
import { BRAND_ASSETS, brandCssVariables } from "../../lib/brand-assets";

if (Astro.locals.company) return Astro.redirect("/empresa/dashboard");
const next = Astro.url.searchParams.get("next") ?? "/empresa/dashboard";
const activated = Astro.url.searchParams.get("activated") === "1";
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Entrar — Área da empresa</title>
    <link rel="icon" href={BRAND_ASSETS.faviconIco} />
    <style is:inline set:html={brandCssVariables()} />
  </head>
  <body class="grid min-h-screen place-items-center bg-[var(--brand-background)] p-4">
    <main class="es-card w-full max-w-md p-8">
      <a href="/" aria-label={BRAND_ASSETS.logoAlt}>
        <img src={BRAND_ASSETS.logoHorizontalWebp} alt="" class="h-10 w-auto" width="160" height="40" />
      </a>
      <h1 class="mt-6 font-display text-2xl font-black">Área da empresa</h1>
      <p class="mt-2 text-sm text-[var(--text-secondary)]">Acesse pedidos, créditos e vagas da sua empresa.</p>
      {activated && (
        <p class="mt-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Conta ativada. Faça login com sua nova senha.</p>
      )}
      <form class="mt-8 grid gap-5" method="post" action="/api/empresa/login">
        <input type="hidden" name="next" value={next} />
        <label class="grid gap-1 text-sm font-semibold">
          E-mail
          <input class="rounded-xl border border-[var(--brand-border)] px-3 py-2.5" type="email" name="email" autocomplete="username" required />
        </label>
        <label class="grid gap-1 text-sm font-semibold">
          Senha
          <input class="rounded-xl border border-[var(--brand-border)] px-3 py-2.5" type="password" name="password" autocomplete="current-password" minlength="8" required />
        </label>
        <button class="es-btn es-btn-primary w-full" type="submit">Entrar</button>
      </form>
      <p class="mt-6 text-sm text-[var(--text-secondary)]">
        Ainda não tem acesso? <a class="font-semibold text-[var(--brand-primary)]" href="/publicar-vaga">Publicar vaga</a>
      </p>
    </main>
  </body>
</html>
