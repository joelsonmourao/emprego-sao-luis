---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contato — Empregos São Luís"><section class="mx-auto max-w-3xl px-4 py-12"><h1 class="text-4xl font-black">Contato</h1><p class="mt-4">Use este canal para dúvidas, correções e suporte.</p><form class="mt-8 grid gap-4" method="post" action="/api/contato"><label>Nome<input class="mt-1 w-full rounded-xl border p-3" name="name" required /></label><label>E-mail<input class="mt-1 w-full rounded-xl border p-3" type="email" name="email" required /></label><label>Mensagem<textarea class="mt-1 w-full rounded-xl border p-3" name="message" required></textarea></label><button class="rounded-xl bg-red-700 p-3 font-bold text-white">Enviar</button></form></section></BaseLayout>
