---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categories, cities, companies, createDatabase, jobs, states } from "@es/db";
import { and, asc, count, desc, eq, gt, ilike, or, type SQL } from "drizzle-orm";
const q = Astro.url.searchParams.get("q")?.trim() ?? "";
const city = Astro.url.searchParams.get("cidade")?.trim() ?? "";
const company = Astro.url.searchParams.get("empresa")?.trim() ?? "";
const category = Astro.url.searchParams.get("categoria")?.trim() ?? "";
const workplace = Astro.url.searchParams.get("modalidade") ?? "";
const contract = Astro.url.searchParams.get("contrato")?.trim() ?? "";
const order = Astro.url.searchParams.get("ordem") === "titulo" ? "titulo" : "recentes";
const page = Math.max(1, Number(Astro.url.searchParams.get("pagina") ?? 1) || 1);
const pageSize = 18;
const conditions: SQL[] = [eq(jobs.publicationStatus, "PUBLISHED"), gt(jobs.expiresAt, new Date())];
if (q) conditions.push(or(ilike(jobs.normalizedTitle, `%${q}%`), ilike(jobs.summary, `%${q}%`))!);
if (city) conditions.push(ilike(cities.name, `%${city}%`));
if (company) conditions.push(ilike(companies.name, `%${company}%`));
if (category) conditions.push(eq(categories.slug, category));
if (["presencial", "hibrido", "remoto"].includes(workplace)) conditions.push(eq(jobs.workplaceType, workplace));
if (contract) conditions.push(ilike(jobs.employmentType, `%${contract}%`));
let rows: Array<{ id: string; title: string; slug: string; code: string; company: string; city: string; state: string; category: string | null; workplace: string; contract: string; publishedAt: Date | null }> = [];
let total = 0;
let categoryOptions: Array<{ name: string; slug: string }> = [];
if (process.env.DATABASE_URL) { const connection = createDatabase(process.env.DATABASE_URL); try { const where = and(...conditions); const base = connection.db.select({ id: jobs.id, title: jobs.normalizedTitle, slug: jobs.slug, code: jobs.publicCode, company: companies.name, city: cities.name, state: states.code, category: categories.name, workplace: jobs.workplaceType, contract: jobs.employmentType, publishedAt: jobs.publishedAt }).from(jobs).innerJoin(companies, eq(jobs.companyId, companies.id)).innerJoin(cities, eq(jobs.cityId, cities.id)).innerJoin(states, eq(jobs.stateId, states.id)).leftJoin(categories, eq(jobs.categoryId, categories.id)).where(where); const [[summary], result, options] = await Promise.all([connection.db.select({ value: count() }).from(jobs).innerJoin(companies, eq(jobs.companyId, companies.id)).innerJoin(cities, eq(jobs.cityId, cities.id)).leftJoin(categories, eq(jobs.categoryId, categories.id)).where(where), order === "titulo" ? base.orderBy(asc(jobs.normalizedTitle)).limit(pageSize).offset((page - 1) * pageSize) : base.orderBy(desc(jobs.publishedAt)).limit(pageSize).offset((page - 1) * pageSize), connection.db.select({ name: categories.name, slug: categories.slug }).from(categories).orderBy(asc(categories.name))]); total = summary?.value ?? 0; rows = result; categoryOptions = options; } finally { await connection.close(); } }
const pages = Math.max(1, Math.ceil(total / pageSize));
const pageUrl = (target: number) => { const params = new URLSearchParams(Astro.url.searchParams); params.set("pagina", String(target)); return `?${params}`; };
---
<BaseLayout title="Vagas em São Luís e no Maranhão" description="Pesquise vagas abertas em São Luís e cidades do Maranhão por cargo, empresa, categoria e modalidade."><section class="bg-slate-950 text-white"><div class="mx-auto max-w-6xl px-4 py-12"><h1 class="text-4xl font-black">Vagas de emprego</h1><p class="mt-3 text-slate-300">{total} oportunidade(s) aberta(s) e verificadas.</p></div></section><section class="mx-auto max-w-6xl px-4 py-10"><form class="grid gap-3 rounded-2xl border bg-white p-5 md:grid-cols-3" method="get"><input class="rounded-lg border p-3" name="q" value={q} placeholder="Cargo ou palavra-chave"/><input class="rounded-lg border p-3" name="empresa" value={company} placeholder="Empresa"/><input class="rounded-lg border p-3" name="cidade" value={city} placeholder="Cidade"/><select class="rounded-lg border p-3" name="categoria"><option value="">Todas as categorias</option>{categoryOptions.map((item) => <option value={item.slug} selected={category === item.slug}>{item.name}</option>)}</select><select class="rounded-lg border p-3" name="modalidade"><option value="">Todas as modalidades</option><option value="presencial" selected={workplace === "presencial"}>Presencial</option><option value="hibrido" selected={workplace === "hibrido"}>Híbrido</option><option value="remoto" selected={workplace === "remoto"}>Remoto</option></select><input class="rounded-lg border p-3" name="contrato" value={contract} placeholder="Tipo de contrato"/><select class="rounded-lg border p-3" name="ordem"><option value="recentes">Mais recentes</option><option value="titulo" selected={order === "titulo"}>Título A–Z</option></select><button class="rounded-lg bg-red-700 p-3 font-bold text-white md:col-span-2">Aplicar filtros</button></form>{rows.length === 0 ? <div class="mt-8 rounded-2xl border bg-white p-8"><h2 class="text-xl font-bold">Nenhuma vaga encontrada.</h2><p class="mt-2 text-slate-600">Tente remover alguns filtros ou crie um alerta para novas oportunidades.</p><div class="mt-5 flex gap-3"><a class="font-bold text-red-700" href="/vagas">Limpar filtros</a><a class="font-bold text-red-700" href="/alertas">Criar alerta</a></div></div> : <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{rows.map((job) => <li class="rounded-2xl border bg-white p-6"><p class="text-xs font-bold text-red-700">{job.code}</p><a class="mt-2 block text-xl font-black hover:text-red-700" href={`/vagas/${job.slug}`}>{job.title}</a><p class="mt-3 text-slate-700">{job.company}</p><p class="mt-1 text-sm text-slate-600">{job.city}/{job.state} · {job.workplace}</p><p class="mt-1 text-sm text-slate-600">{job.contract}{job.category ? ` · ${job.category}` : ""}</p></li>)}</ul>}<nav class="mt-8 flex items-center justify-between"><span>Página {page} de {pages}</span><div class="flex gap-2">{page > 1 && <a class="rounded-lg border px-4 py-2" href={pageUrl(page - 1)}>Anterior</a>}{page < pages && <a class="rounded-lg border px-4 py-2" href={pageUrl(page + 1)}>Próxima</a>}</div></nav></section></BaseLayout>
