---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listPublishedJobs } from "../../lib/jobs";
const jobs = await listPublishedJobs();
---
<BaseLayout title="Vagas em São Luís e no Maranhão">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-4xl font-black">Vagas de emprego</h1>
    <p class="mt-4 text-slate-700">Oportunidades abertas e verificadas.</p>
    {jobs.length === 0 ? <p class="mt-8 rounded-xl bg-white p-6">Nenhuma vaga publicada neste momento.</p> : (
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {jobs.map((job) => <li class="rounded-2xl border border-slate-200 bg-white p-6"><a class="text-xl font-bold hover:text-red-700" href={`/vagas/${job.slug}`}>{job.normalizedTitle}</a><p class="mt-3 text-sm text-slate-600">Código {job.publicCode}</p></li>)}
      </ul>
    )}
  </section>
</BaseLayout>
