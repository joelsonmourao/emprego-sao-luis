---
import BaseLayout from "../../../layouts/BaseLayout.astro";import{cities,companies,createDatabase,jobs,neighborhoods,states}from"@es/db";import{and,desc,eq,gt}from"drizzle-orm";const slug=Astro.params.slug??"";let area;let rows:Array<{title:string;slug:string;company:string}>=[];if(process.env.DATABASE_URL){const connection=createDatabase(process.env.DATABASE_URL);try{[area]=await connection.db.select({id:neighborhoods.id,name:neighborhoods.name,city:cities.name,state:states.code}).from(neighborhoods).innerJoin(cities,eq(neighborhoods.cityId,cities.id)).innerJoin(states,eq(cities.stateId,states.id)).where(and(eq(neighborhoods.slug,slug),eq(neighborhoods.active,true))).limit(1);if(area)rows=await connection.db.select({title:jobs.normalizedTitle,slug:jobs.slug,company:companies.name}).from(jobs).innerJoin(companies,eq(jobs.companyId,companies.id)).where(and(eq(jobs.neighborhoodId,area.id),eq(jobs.publicationStatus,"PUBLISHED"),gt(jobs.expiresAt,new Date()))).orderBy(desc(jobs.publishedAt)).limit(50);}finally{await connection.close();}}if(!area)return Astro.redirect("/vagas",302);
---
<BaseLayout title={`Vagas no bairro ${area.name} — ${area.city}`}><section class="mx-auto max-w-5xl px-4 py-12"><nav class="text-sm text-slate-600"><a href="/">Início</a> / <a href="/vagas">Vagas</a> / {area.name}</nav><h1 class="mt-4 text-4xl font-black">Vagas no {area.name}, {area.city}/{area.state}</h1><div class="mt-8 grid gap-3">{rows.length?rows.map((job)=><a class="rounded-xl border bg-white p-5" href={`/vagas/${job.slug}`}><strong>{job.title}</strong><span class="mt-1 block text-sm text-slate-600">{job.company}</span></a>):<p class="rounded-xl border bg-white p-5">Nenhuma vaga ativa neste bairro.</p>}</div></section></BaseLayout>
