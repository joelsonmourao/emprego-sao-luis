---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { cities, companies, createDatabase, jobs, states } from "@es/db";
import { and, desc, eq, gt, sql } from "drizzle-orm";

const uf = (Astro.params.uf ?? "").toUpperCase();
let state: typeof states.$inferSelect | undefined;
let rows: Array<{ title: string; slug: string; company: string; city: string }> = [];

if (process.env.DATABASE_URL) {
  const connection = createDatabase(process.env.DATABASE_URL);
  try {
    [state] = await connection.db.select().from(states).where(eq(states.code, uf)).limit(1);
    if (state) {
      rows = await connection.db
        .select({
          title: jobs.normalizedTitle,
          slug: jobs.slug,
          company: sql<string>`case when ${jobs.confidentialCompany} then 'Empresa confidencial' else coalesce(${companies.publicName}, ${companies.name}) end`,
          city: cities.name
        })
        .from(jobs)
        .innerJoin(companies, eq(jobs.companyId, companies.id))
        .innerJoin(cities, eq(jobs.cityId, cities.id))
        .where(and(eq(jobs.stateId, state.id), eq(jobs.publicationStatus, "PUBLISHED"), gt(jobs.expiresAt, new Date())))
        .orderBy(desc(jobs.publishedAt))
        .limit(50);
    }
  } finally {
    await connection.close();
  }
}

if (!state) {
  return new Response("Estado não encontrado", {
    status: 404,
    headers: { "Content-Type": "text/plain; charset=utf-8", "X-Robots-Tag": "noindex, follow" }
  });
}
---
<BaseLayout title={`Vagas no ${state.name} — ${state.code}`} noindex>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <nav class="text-sm text-slate-600"><a href="/">Início</a> / <a href="/vagas">Vagas</a> / {state.code}</nav>
    <h1 class="mt-4 text-4xl font-black">Vagas no {state.name}</h1>
    <div class="mt-8 grid gap-3">
      {rows.length ? rows.map((job) => (
        <a class="rounded-xl border bg-white p-5" href={`/vagas/${job.slug}`}>
          <strong>{job.title}</strong><span class="mt-1 block text-sm text-slate-600">{job.company} · {job.city}</span>
        </a>
      )) : <p class="rounded-xl border bg-white p-5">Nenhuma vaga ativa neste estado.</p>}
    </div>
  </section>
</BaseLayout>
