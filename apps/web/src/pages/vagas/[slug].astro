---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { findPublishedJob } from "../../lib/jobs";
import { buildJobPosting } from "@es/seo";
import AdSlot from "../../components/AdSlot.astro";
const slug = Astro.params.slug ?? "";
const job = await findPublishedJob(slug);
if (!job) return Astro.redirect(`/vagas/indisponivel/${encodeURIComponent(slug)}`, 302);
const record = job.job;
const jsonLd = buildJobPosting({ title: record.normalizedTitle, description: record.description, publishedAt: record.publishedAt, expiresAt: record.expiresAt, employmentType: record.employmentType, workplaceType: record.workplaceType, companyName: job.companyName, companyWebsiteUrl: job.companyWebsiteUrl, cityName: job.cityName, stateCode: job.stateCode, applicationUrl: record.applicationUrl, salaryMin: record.salaryVisible ? record.salaryMin : null, salaryMax: record.salaryVisible ? record.salaryMax : null, salaryCurrency: record.salaryCurrency, salaryPeriod: record.salaryPeriod });
if (!jsonLd) return Astro.redirect(`/vagas/indisponivel/${encodeURIComponent(slug)}`, 302);
---
<BaseLayout title={`${record.normalizedTitle} — Empregos São Luís`} description={record.summary}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-3xl px-4 py-12">
    <p class="font-bold text-red-700">{record.publicCode}</p><h1 class="mt-2 text-4xl font-black">{record.normalizedTitle}</h1>
    <p class="mt-2 text-slate-600">{job.companyName} · {job.cityName}/{job.stateCode}</p>
    <p class="mt-4 text-lg text-slate-700">{record.summary}</p>
    <section class="prose mt-8 max-w-none" set:html={record.description} />
    <a class="mt-10 inline-flex rounded-xl bg-red-700 px-6 py-4 font-bold text-white" href={record.applicationUrl} rel="nofollow noopener noreferrer">Candidatar-se</a>
    <AdSlot slot="job-after-application" />
  </article>
</BaseLayout>
