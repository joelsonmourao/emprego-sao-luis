---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import ApplicationChannels from "../../components/ApplicationChannels.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import JobCard from "../../components/ui/JobCard.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { buildJobPosting } from "@es/seo";
import {
  buildMailtoUrl,
  buildWhatsappUrl,
  defaultEmailSubject,
  defaultWhatsappMessage,
  normalizeApplicationEmail,
  normalizeApplicationUrl,
  normalizeApplicationWhatsapp
} from "@es/shared";
import { formatRelativeDate, formatSalary, formatWorkplace } from "../../lib/job-presenter";
import { findPublishedJob, listRelatedJobs } from "../../lib/jobs";

const slug = Astro.params.slug ?? "";
const job = await findPublishedJob(slug);
if (!job) return Astro.redirect(`/vagas/indisponivel/${encodeURIComponent(slug)}`, 302);

const record = job.job;
const canonicalUrl = record.canonicalUrl || new URL(`/vagas/${record.slug}`, Astro.site).toString();
const applicationUrl = normalizeApplicationUrl(record.applicationUrl);
const applicationEmail = normalizeApplicationEmail(record.applicationEmail);
const applicationWhatsapp = normalizeApplicationWhatsapp(record.applicationWhatsapp);
const whatsappUrl = applicationWhatsapp.normalized
  ? buildWhatsappUrl(applicationWhatsapp.normalized, record.applicationWhatsappMessage || defaultWhatsappMessage(record.normalizedTitle))
  : null;
const emailSubject = record.applicationEmailSubject || defaultEmailSubject(record.normalizedTitle);
const emailUrl = applicationEmail.normalized ? buildMailtoUrl(applicationEmail.normalized, emailSubject) : null;
const hasApplicationChannel = applicationUrl.valid || Boolean(whatsappUrl) || Boolean(emailUrl);
const acceptingApplications =
  record.publicationStatus === "PUBLISHED" &&
  record.applicationUrlStatus !== "CLOSED" &&
  Boolean(record.expiresAt && record.expiresAt > new Date()) &&
  hasApplicationChannel;

const primaryType = record.applicationType?.toUpperCase();
const channels: Array<{
  type: "URL" | "WHATSAPP" | "EMAIL";
  href?: string | null;
  label: string;
  hint: string;
  email?: string | null;
  subject?: string | null;
  primary?: boolean;
}> = [];
if (applicationUrl.valid && applicationUrl.normalized) {
  channels.push({
    type: "URL",
    href: applicationUrl.normalized,
    label: "Candidatura no site da empresa",
    hint: "Você será direcionado ao site ou plataforma externa informada pela empresa.",
    primary: primaryType === "URL"
  });
}
if (whatsappUrl) {
  channels.push({
    type: "WHATSAPP",
    href: whatsappUrl,
    label: "Candidatura pelo WhatsApp",
    hint: "A conversa abre no WhatsApp oficial com mensagem inicial. Revise antes de enviar.",
    primary: primaryType === "WHATSAPP"
  });
}
if (applicationEmail.normalized) {
  channels.push({
    type: "EMAIL",
    href: emailUrl,
    label: "Candidatura por e-mail",
    hint: "O primeiro clique revela o e-mail nesta página. Copiar ou abrir o aplicativo fica opcional.",
    email: applicationEmail.normalized,
    subject: emailSubject,
    primary: primaryType === "EMAIL"
  });
}

const jsonLd = buildJobPosting({
  title: record.normalizedTitle,
  description: record.descriptionHtml,
  publishedAt: record.publishedAt,
  expiresAt: record.expiresAt,
  employmentType: record.employmentType,
  workplaceType: record.workplaceType,
  companyName: job.companyName,
  companyWebsiteUrl: job.companyWebsiteUrl,
  cityName: job.cityName,
  stateCode: job.stateCode,
  applicationUrl: record.applicationUrl,
  applicationType: record.applicationType,
  salaryMin: record.salaryVisible ? record.salaryMin : null,
  salaryMax: record.salaryVisible ? record.salaryMax : null,
  salaryCurrency: record.salaryCurrency,
  salaryPeriod: record.salaryPeriod,
  salaryVisible: record.salaryVisible,
  publicCode: record.publicCode,
  canonicalUrl,
  publicationStatus: record.publicationStatus,
  confidentialCompany: record.confidentialCompany,
  unidentifiedCompany: record.unidentifiedCompany,
  organizationPubliclyIdentifiable: !record.confidentialCompany && !record.unidentifiedCompany
});

const related = await listRelatedJobs({
  jobId: record.id,
  companyId: record.companyId,
  categoryId: record.categoryId,
  cityId: record.cityId,
  limit: 4
});
const salary = formatSalary(record);
const shareUrl = canonicalUrl;
const noindex = record.publicationStatus !== "PUBLISHED" || !acceptingApplications;
---
<BaseLayout
  title={record.seoTitle || `${record.normalizedTitle} — Empregos São Luís`}
  description={record.metaDescription || record.summary}
  canonical={canonicalUrl}
  breadcrumbs={[{ name: "Vagas", url: "/vagas" }, { name: record.normalizedTitle, url: `/vagas/${record.slug}` }]}
  noindex={noindex}
  schemas={jsonLd ? [jsonLd] : []}
>
  <section class="es-section bg-white pt-8">
    <div class="es-container">
      <Breadcrumbs items={[{ name: "Início", url: "/" }, { name: "Vagas", url: "/vagas" }, { name: record.normalizedTitle }]} />

      <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_320px]">
        <article>
          <div class="flex flex-wrap items-start gap-4">
            {job.companyLogoUrl ? (
              <img src={job.companyLogoUrl} alt="" class="h-16 w-16 rounded-2xl border object-contain p-2" width="64" height="64" />
            ) : (
              <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--es-cream-dark)] text-xl font-black text-[var(--brand-primary)]">{job.companyName.slice(0, 1)}</div>
            )}
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap gap-2">
                <span class="chip chip-active">{record.publicCode}</span>
                {record.featured && <span class="chip">Destaque</span>}
                {record.sponsored && <span class="chip">Patrocinada</span>}
              </div>
              <h1 class="font-display mt-2 text-3xl font-black sm:text-4xl">{record.normalizedTitle}</h1>
              <p class="mt-2 text-lg font-semibold">
                {record.confidentialCompany ? job.companyName : <a class="hover:text-[var(--brand-primary)]" href={`/empresas/${job.companySlug}`}>{job.companyName}</a>}
              </p>
              <p class="mt-1 text-[var(--es-muted)]">
                {job.cityName}/{job.stateCode}
                {job.neighborhoodName ? ` · ${job.neighborhoodName}` : record.neighborhood ? ` · ${record.neighborhood}` : ""}
                · {formatWorkplace(record.workplaceType)}
                · {record.employmentType}
              </p>
            </div>
          </div>

          <dl class="mt-6 grid gap-3 rounded-2xl border border-[var(--es-border)] bg-[var(--es-cream)] p-5 sm:grid-cols-2">
            {salary && <div><dt class="text-xs font-bold uppercase text-[var(--es-muted)]">Salário</dt><dd class="font-bold text-[var(--es-green)]">{salary}</dd></div>}
            <div><dt class="text-xs font-bold uppercase text-[var(--es-muted)]">Publicada</dt><dd>{formatRelativeDate(record.publishedAt)}</dd></div>
            {record.expiresAt && <div><dt class="text-xs font-bold uppercase text-[var(--es-muted)]">Expira</dt><dd>{formatRelativeDate(record.expiresAt)}</dd></div>}
            {job.categoryName && <div><dt class="text-xs font-bold uppercase text-[var(--es-muted)]">Categoria</dt><dd><a class="underline" href={`/vagas/categoria/${job.categorySlug}`}>{job.categoryName}</a></dd></div>}
            {record.schedule && <div><dt class="text-xs font-bold uppercase text-[var(--es-muted)]">Jornada</dt><dd>{record.schedule}</dd></div>}
          </dl>

          {!acceptingApplications && (
            <p class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4 font-semibold text-amber-950" role="status">
              Esta vaga está encerrada ou temporariamente pausada. A candidatura não está disponível.
            </p>
          )}

          <ApplicationChannels
            jobId={record.id}
            accepting={acceptingApplications}
            instructions={record.applicationInstructions}
            channels={channels}
            placement="summary"
          />

          <section class="mt-8">
            <h2 class="font-display text-2xl font-black">Descrição da vaga</h2>
            <div class="es-prose mt-4 max-w-none" set:html={record.descriptionHtml} />
          </section>

          <ApplicationChannels
            jobId={record.id}
            accepting={acceptingApplications}
            instructions={record.applicationInstructions}
            channels={channels}
            placement="footer"
          />

          <AdSlot slot="job-content-mid" pageType="job" citySlug={job.citySlug} companySlug={job.companySlug} workplaceType={record.workplaceType} />

          <section class="mt-8 rounded-2xl border border-[var(--es-border)] bg-[var(--es-cream)] p-5">
            <h2 class="font-display text-lg font-black">Fonte da oportunidade</h2>
            <p class="mt-2 text-sm text-[var(--es-muted)]">
              {record.sourceUrl ? <a class="font-semibold underline" href={record.sourceUrl} rel="nofollow noopener noreferrer">{record.sourceName}</a> : record.sourceName}
            </p>
            <p class="mt-2 text-xs text-[var(--es-muted)]">A fonte indica onde a oportunidade foi encontrada. Use os canais de candidatura exibidos separadamente.</p>
          </section>

          <section class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-5">
            <h2 class="font-display text-lg font-black text-amber-950">Aviso de segurança</h2>
            <p class="mt-2 text-sm text-amber-900">Nunca pague para conseguir emprego. Confirme se o canal de candidatura é oficial da empresa. <a class="underline" href="/seguranca-candidatos">Saiba mais</a>.</p>
          </section>

          {related.length > 0 && (
            <section class="mt-10">
              <SectionHeading title="Vagas relacionadas" />
              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                {related.map((item) => <JobCard {...item} compact />)}
              </div>
            </section>
          )}
        </article>

        <aside class="space-y-5">
          {acceptingApplications && (
            <div class="es-card sticky top-24 space-y-4 p-6" id="candidatura">
              <h2 class="font-display text-xl font-black">Candidatura gratuita</h2>
              <p class="text-sm text-[var(--es-muted)]">Os mesmos canais do resumo, sem cadastro obrigatório.</p>
              <a class="es-btn es-btn-primary w-full py-3 text-center" href="#candidatura-summary">Ver canais de candidatura</a>
              <form method="post" action="/api/account/saved-jobs">
                <input type="hidden" name="jobId" value={record.id} />
                <input type="hidden" name="action" value="save" />
                <button class="es-btn es-btn-secondary w-full" type="submit">Salvar vaga</button>
              </form>
              <div class="grid grid-cols-2 gap-2 text-sm">
                <a class="es-btn es-btn-secondary" href={`https://wa.me/?text=${encodeURIComponent(`${record.normalizedTitle} - ${shareUrl}`)}`} rel="noopener noreferrer">Compartilhar</a>
                <button class="es-btn es-btn-secondary" type="button" data-share-url={shareUrl} id="copy-share-link">Copiar link</button>
              </div>
            </div>
          )}
          {!record.confidentialCompany && (
            <article class="es-card p-5">
              <h3 class="font-display font-black">Sobre a empresa</h3>
              <p class="mt-2 font-semibold">{job.companyName}</p>
              <a class="mt-3 inline-flex text-sm font-bold text-[var(--brand-primary)]" href={`/empresas/${job.companySlug}`}>Ver perfil da empresa →</a>
            </article>
          )}
          <div class="pt-8">
            <AdSlot slot="job-sidebar" pageType="job" citySlug={job.citySlug} companySlug={job.companySlug} workplaceType={record.workplaceType} />
          </div>
        </aside>
      </div>
    </div>
  </section>
  <script is:inline>
    document.getElementById("copy-share-link")?.addEventListener("click", () => {
      const url = document.getElementById("copy-share-link")?.getAttribute("data-share-url");
      if (url) navigator.clipboard?.writeText(url);
    });
  </script>
</BaseLayout>
