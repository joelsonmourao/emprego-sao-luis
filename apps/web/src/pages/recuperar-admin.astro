---
import "../styles/global.css";
const sent = Astro.url.searchParams.get("status") === "enviado";
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>Recuperar acesso administrativo</title></head><body class="grid min-h-screen place-items-center bg-slate-950 p-4"><main class="w-full max-w-md rounded-2xl bg-white p-8"><h1 class="text-3xl font-black">Recuperar acesso</h1>{sent ? <p class="mt-5 rounded-lg bg-emerald-50 p-4">Se existir uma conta administrativa ativa, enviaremos um link válido por 15 minutos.</p> : <form class="mt-6 grid gap-4" method="post" action="/api/auth/admin-password/request"><label>E-mail administrativo<input class="mt-1 w-full rounded-lg border p-3" type="email" name="email" required autocomplete="email"/></label><button class="rounded-lg bg-red-700 p-3 font-bold text-white">Enviar link seguro</button></form>}<a class="mt-6 inline-block font-bold text-red-700" href="/admin/login">Voltar ao login</a></main></body></html>
