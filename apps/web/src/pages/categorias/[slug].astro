---
import BaseLayout from "../../layouts/BaseLayout.astro";import{categories,cities,companies,createDatabase,jobs,states}from"@es/db";import{and,desc,eq,gt}from"drizzle-orm";const slug=Astro.params.slug??"";let category;let rows:Array<{title:string;slug:string;company:string;city:string;state:string}>=[];if(process.env.DATABASE_URL){const connection=createDatabase(process.env.DATABASE_URL);try{[category]=await connection.db.select().from(categories).where(and(eq(categories.slug,slug),eq(categories.active,true))).limit(1);if(category)rows=await connection.db.select({title:jobs.normalizedTitle,slug:jobs.slug,company:companies.name,city:cities.name,state:states.code}).from(jobs).innerJoin(companies,eq(jobs.companyId,companies.id)).innerJoin(cities,eq(jobs.cityId,cities.id)).innerJoin(states,eq(jobs.stateId,states.id)).where(and(eq(jobs.categoryId,category.id),eq(jobs.publicationStatus,"PUBLISHED"),gt(jobs.expiresAt,new Date()))).orderBy(desc(jobs.publishedAt)).limit(50);}finally{await connection.close();}}if(!category)return Astro.redirect("/categorias",302);
---
<BaseLayout title={category.seoTitle??`${category.name} — vagas de emprego`} description={category.metaDescription??`Vagas na categoria ${category.name}.`}><section class="mx-auto max-w-5xl px-4 py-12"><nav class="text-sm text-slate-600"><a href="/">Início</a> / <a href="/categorias">Categorias</a> / {category.name}</nav><h1 class="mt-4 text-4xl font-black">Vagas em {category.name}</h1>{category.description&&<p class="mt-4 text-lg text-slate-700">{category.description}</p>}<div class="mt-8 grid gap-3">{rows.length?rows.map((job)=><a class="rounded-xl border bg-white p-5" href={`/vagas/${job.slug}`}><strong>{job.title}</strong><span class="mt-1 block text-sm text-slate-600">{job.company} · {job.city}/{job.state}</span></a>):<p class="rounded-xl border bg-white p-5">Nenhuma vaga ativa nesta categoria.</p>}</div></section></BaseLayout>
