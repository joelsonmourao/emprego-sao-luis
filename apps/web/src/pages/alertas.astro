---
import BaseLayout from "../layouts/BaseLayout.astro";
const whatsapp = import.meta.env.PUBLIC_WHATSAPP_CHANNEL_URL as string | undefined;
---
<BaseLayout title="Alertas de vagas — Empregos São Luís"><section class="mx-auto max-w-2xl px-4 py-12"><h1 class="text-4xl font-black">Receba alertas de vagas</h1><p class="mt-4 text-slate-700">A inscrição é opcional e não limita o acesso às vagas. Confirme seu e-mail para ativar os alertas.</p><form class="mt-8 grid gap-5 rounded-2xl border bg-white p-6" method="post" action="/api/subscriptions"><label>E-mail<input class="mt-1 w-full rounded-xl border p-3" type="email" name="email" required/></label><label>Cidade<input class="mt-1 w-full rounded-xl border p-3" name="city" maxlength="120"/></label><label>Área profissional<input class="mt-1 w-full rounded-xl border p-3" name="category" maxlength="120"/></label><label class="flex gap-3"><input type="checkbox" name="consent" value="yes" required/><span>Concordo em receber alertas e li a política de privacidade.</span></label><button class="rounded-xl bg-red-700 p-4 font-bold text-white">Criar alerta</button></form>{whatsapp && <a class="mt-6 block rounded-xl border bg-white p-4 text-center font-bold" href={whatsapp} rel="noopener noreferrer">Entrar no canal oficial do WhatsApp</a>}</section></BaseLayout>
