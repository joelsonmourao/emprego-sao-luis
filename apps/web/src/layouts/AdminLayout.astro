---
import "../styles/global.css";
import BrandLogo from "../components/BrandLogo.astro";
import { cssVariablesFromIdentity } from "../lib/design-tokens";
import { BRAND_ASSET_KEYS } from "../lib/brand/constants";
import { getBrandIdentity } from "../lib/brand/identity-service";
import { filterAdminNav } from "../lib/admin-nav";
import { ADMIN_FORM_BRIDGE_SCRIPT } from "../lib/admin-form-bridge";
import { getEditorialPortalMode, getAdsenseReviewMode } from "../lib/portal-modes";
import { getVisualIdentity } from "../lib/visual-identity";

const auth = Astro.locals.auth;
interface Props { title: string; description?: string }
const { title, description = "Gerencie esta área com dados verificáveis e trilha de auditoria." } = Astro.props;
const identity = await getVisualIdentity();
const brand = await getBrandIdentity();
const permissions = auth?.permissions ?? [];
const navGroups = filterAdminNav(permissions);
const current = Astro.url.pathname;
const [portalMode, reviewMode] = await Promise.all([getEditorialPortalMode(), getAdsenseReviewMode()]);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} — Painel</title>
    <link rel="icon" href={identity.faviconUrl ?? "/favicon.ico"} />
    <link rel="apple-touch-icon" href={identity.appleTouchIconUrl ?? "/apple-touch-icon.png"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700&family=Fraunces:wght@700;800&display=swap" rel="stylesheet" />
    <style is:inline set:html={cssVariablesFromIdentity(identity, brand.palette)} />
  </head>
  <body class="bg-[var(--brand-background)] text-[var(--text-primary)]">
    <div class="min-h-screen lg:grid lg:grid-cols-[280px_1fr]">
      <aside class="border-r border-[var(--brand-border)] bg-[var(--brand-secondary)] p-5 text-white">
        <a class="block" href="/admin" aria-label={identity.siteName}>
          <BrandLogo assetKey={BRAND_ASSET_KEYS.ADMIN_LOGO} class="h-10 w-auto max-w-[10rem] object-contain brightness-0 invert" width={160} height={40} />
        </a>
        <p class="mt-2 text-xs text-white/60">Painel administrativo</p>
        <nav class="mt-6 grid max-h-[calc(100vh-9rem)] gap-4 overflow-auto pr-1 text-sm" aria-label="Painel">
          {navGroups.map((group) => (
            <div>
              <p class="px-2 text-[0.65rem] font-bold uppercase tracking-wider text-white/45">{group.title}</p>
              <div class="mt-1 grid gap-0.5">
                {group.items.map((item) => (
                  <a
                    class={`rounded-xl px-3 py-2 transition-colors ${current === item.href || current.startsWith(`${item.href}/`) ? "bg-white/15 font-bold" : "hover:bg-white/10"}`}
                    href={item.href}
                  >
                    {item.label}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </nav>
      </aside>
      <div>
        <header class="flex flex-wrap items-center justify-between gap-4 border-b border-[var(--brand-border)] bg-[var(--brand-surface)] px-6 py-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-[var(--text-secondary)]">Painel</p>
            <strong class="font-display text-lg">{title}</strong>
            <p class="mt-0.5 max-w-3xl text-xs text-[var(--text-secondary)]">{description}</p>
            <p class="text-sm text-[var(--text-secondary)]">{auth?.email}</p>
          </div>
          <div class="flex flex-1 flex-wrap items-center justify-end gap-4">
            <div class="relative w-full max-w-xs">
              <input
                id="admin-search"
                type="search"
                placeholder="Busca global…"
                autocomplete="off"
                class="es-input w-full max-w-xs"
                aria-label="Busca global no painel"
              />
              <div id="search-results" class="absolute right-0 top-full z-50 mt-1 hidden w-full min-w-[18rem] rounded-xl border border-[var(--brand-border)] bg-white py-2 shadow-lg"></div>
            </div>
            <form method="post" action="/api/admin/logout"><button class="es-btn es-btn-secondary">Sair</button></form>
          </div>
        </header>
        <main class="p-6">
          {portalMode.enabled && (
            <aside class="mb-4 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950" role="status">
              <strong>MODO PORTAL EDITORIAL ATIVO</strong>
              <p class="mt-1">A área pública de vagas está temporariamente oculta. Importações e o admin continuam normais.</p>
            </aside>
          )}
          {reviewMode.enabled && (
            <aside class="mb-4 rounded-xl border border-sky-300 bg-sky-50 p-4 text-sm text-sky-950" role="status">
              <strong>MODO DE REVISÃO ADSENSE ATIVO</strong>
              <p class="mt-1">Prioriza superfície editorial e restringe indexação de páginas de baixo valor. Não é cloaking.</p>
            </aside>
          )}
          <slot />
        </main>
      </div>
    </div>
    <script is:inline>
      (function () {
        const searchInput = document.getElementById("admin-search");
        const searchResults = document.getElementById("search-results");
        if (!searchInput || !searchResults) return;
        let searchTimer;

        async function runSearch(q) {
          if (!q.trim()) {
            searchResults.classList.add("hidden");
            searchResults.innerHTML = "";
            return;
          }
          const res = await fetch("/api/admin/search?q=" + encodeURIComponent(q.trim()));
          const data = await res.json();
          const results = data.results || [];
          if (!results.length) {
            searchResults.innerHTML = '<p class="px-4 py-2 text-sm text-[var(--text-secondary)]">Nenhum resultado.</p>';
          } else {
            searchResults.innerHTML = results.map(function (r) {
              return '<a class="block px-4 py-2 text-sm hover:bg-[var(--brand-background)]" href="' + r.href + '"><span class="text-xs font-bold uppercase text-[var(--text-secondary)]">' + r.type + '</span><br/>' + r.label + '</a>';
            }).join("");
          }
          searchResults.classList.remove("hidden");
        }

        searchInput.addEventListener("input", function () {
          clearTimeout(searchTimer);
          searchTimer = setTimeout(function () { runSearch(searchInput.value); }, 250);
        });
        searchInput.addEventListener("keydown", function (e) {
          if (e.key === "Enter") { clearTimeout(searchTimer); runSearch(searchInput.value); }
          if (e.key === "Escape") { searchResults.classList.add("hidden"); searchInput.blur(); }
        });
        document.addEventListener("click", function (e) {
          if (!searchResults.contains(e.target) && e.target !== searchInput) searchResults.classList.add("hidden");
        });
      })();
    </script>
    <script is:inline set:html={ADMIN_FORM_BRIDGE_SCRIPT} />
  </body>
</html>
