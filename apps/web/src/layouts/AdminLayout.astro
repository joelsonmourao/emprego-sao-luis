---
import "../styles/global.css";
const auth = Astro.locals.auth;
interface Props { title: string }
const { title } = Astro.props;
const links = [["Visão geral", "/admin"], ["Vagas", "/admin/vagas"], ["Importação", "/admin/importacao"], ["Empresas", "/admin/empresas"], ["Categorias", "/admin/categorias"], ["Conteúdo", "/admin/conteudo"], ["Mídia", "/admin/midia"], ["Social", "/admin/social"], ["Audiência", "/admin/audiencia"], ["Publicidade", "/admin/publicidade"], ["SEO", "/admin/seo"], ["Usuários", "/admin/usuarios"], ["Filas", "/admin/filas"], ["Saúde", "/admin/saude"], ["Segurança", "/admin/seguranca"]];
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>{title} — Painel</title></head><body><div class="min-h-screen bg-slate-100 lg:grid lg:grid-cols-[260px_1fr]"><aside class="bg-slate-950 p-5 text-white"><a class="text-lg font-black" href="/admin">EMPREGOS SÃO LUÍS</a><nav class="mt-8 grid gap-1" aria-label="Painel">{links.map(([label, href]) => <a class="rounded-lg px-3 py-2 hover:bg-white/10" href={href}>{label}</a>)}</nav></aside><div><header class="flex items-center justify-between border-b bg-white px-6 py-4"><div><strong>{auth?.name}</strong><p class="text-sm text-slate-600">{auth?.email}</p></div><form method="post" action="/api/admin/logout"><button class="rounded-lg border px-4 py-2">Sair</button></form></header><main class="p-6"><slot /></main></div></div></body></html>
