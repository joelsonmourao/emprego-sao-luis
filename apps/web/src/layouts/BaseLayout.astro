---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { buildBreadcrumbSchema, buildOpenGraphTags, buildOrganizationSchema, buildTwitterTags, buildWebSiteSchema } from "@es/seo";
import { cssVariablesFromIdentity } from "../lib/design-tokens";
import { BRAND_ASSETS } from "../lib/brand-assets";
import { getBrandIdentity } from "../lib/brand/identity-service";
import { getSeoSettings } from "../lib/seo-settings";
import { getSiteIntegrations, normalizeAdsenseClientId, normalizeSearchConsoleToken } from "../lib/site-integrations";
import { getVisualIdentity } from "../lib/visual-identity";
import { isStagingLikeEnvironment, stagingRobotsDirective } from "../lib/runtime-env";
import { getAdsenseReviewDirective, getAdsenseReviewMode } from "../lib/adsense-review-mode";
import { getRuntimeSiteUrl, resolveCanonicalUrl, resolvePublicHttpUrl } from "../lib/canonical-url";

interface Props {
  title: string;
  description?: string;
  robots?: string;
  canonical?: string;
  ogImage?: string | undefined;
  breadcrumbs?: Array<{ name: string; url: string }>;
  noindex?: boolean;
  pageSchemaType?: "WebPage" | "CollectionPage" | "SearchResultsPage" | "AboutPage" | "ContactPage";
  schemas?: Array<Record<string, unknown>>;
  disableSeoGraph?: boolean;
  adsenseReviewQualityOverride?: boolean;
}

const identity = await getVisualIdentity();
const brand = await getBrandIdentity();
const seo = await getSeoSettings();
const integrations = await getSiteIntegrations();
const adsenseReviewMode = await getAdsenseReviewMode();
const stagingLike = isStagingLikeEnvironment();
const { title, description = seo.defaultDescription, robots = seo.robotsDefault, canonical, ogImage = identity.ogImageUrl ?? seo.og.image, breadcrumbs, noindex = false, pageSchemaType = "WebPage", schemas = [], disableSeoGraph = false, adsenseReviewQualityOverride = false } = Astro.props;
const pageTitle = title.includes(seo.titleSuffix) ? title : `${title} — ${seo.titleSuffix}`;
const runtimeSite = getRuntimeSiteUrl(Astro.site);
const canonicalUrl = resolveCanonicalUrl(canonical, Astro.url.pathname, runtimeSite);
const publicOgImage = resolvePublicHttpUrl(ogImage, runtimeSite);
const consentChoice = Astro.cookies.get("es_consent_ads")?.value;
const consentOk = !integrations.consentModeEnabled || consentChoice === "yes";

const googleVerification = normalizeSearchConsoleToken(
  integrations.searchConsoleVerification.trim() || seo.verifications.google
);
const bingVerification = (integrations.bingVerification.trim() || seo.verifications.bing).trim();

const adsenseClientId =
  normalizeAdsenseClientId(integrations.adsensePublisherId) ||
  normalizeAdsenseClientId(
    String(process.env.PUBLIC_ADSENSE_CLIENT_ID ?? import.meta.env.PUBLIC_ADSENSE_CLIENT_ID ?? "")
  );
const adsWanted = integrations.persisted
  ? integrations.adsenseEnabled
  : integrations.adsenseEnabled ||
    String(process.env.PUBLIC_ADSENSE_ENABLED ?? import.meta.env.PUBLIC_ADSENSE_ENABLED ?? "").toLowerCase() === "true";
const adsEnabled = !stagingLike && adsWanted && Boolean(adsenseClientId) && consentOk;

const ga4Id = integrations.ga4MeasurementId.trim();
const gtmId = integrations.gtmContainerId.trim().toUpperCase();
const ga4Ok = /^G-[A-Z0-9]+$/i.test(ga4Id) || /^GT-[A-Z0-9]+$/i.test(ga4Id);
const gtmOk = /^GTM-[A-Z0-9]+$/i.test(gtmId);
const analyticsEnabled =
  !stagingLike && integrations.analyticsEnabled && consentOk && (gtmOk || ga4Ok);

const metaPixelId = integrations.metaPixelId.trim();
const metaPixelOk = /^\d{5,20}$/.test(metaPixelId);
const metaEnabled = !stagingLike && metaPixelOk && consentOk;

const siteUrl = runtimeSite.toString();
const og = buildOpenGraphTags({ title: pageTitle, description, url: canonicalUrl, type: seo.og.type, siteName: seo.og.siteName, locale: seo.og.locale, ...(publicOgImage ? { image: publicOgImage } : {}) });
const twitter = buildTwitterTags({ title: pageTitle, description, card: seo.twitter.card, ...(seo.twitter.site ? { site: seo.twitter.site } : {}), ...(seo.twitter.creator ? { creator: seo.twitter.creator } : {}), ...(publicOgImage ? { image: publicOgImage } : {}) });
const organizationSchema = buildOrganizationSchema(seo, siteUrl);
const websiteSchema = buildWebSiteSchema(seo, siteUrl);
const breadcrumbSchema = breadcrumbs?.length ? buildBreadcrumbSchema(breadcrumbs.map((item) => ({ ...item, url: new URL(item.url, siteUrl).toString() }))) : null;
const withoutContext = (schema: Record<string, unknown>) => Object.fromEntries(Object.entries(schema).filter(([key]) => key !== "@context"));
const organizationNode = { ...withoutContext(organizationSchema), "@id": `${siteUrl.replace(/\/$/, "")}#organization` };
const websiteNode = {
  ...withoutContext(websiteSchema),
  "@id": `${siteUrl.replace(/\/$/, "")}#website`,
  publisher: { "@id": `${siteUrl.replace(/\/$/, "")}#organization` },
  potentialAction: {
    "@type": "SearchAction",
    target: `${siteUrl.replace(/\/$/, "")}/busca?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
const pageNode = {
  "@type": pageSchemaType,
  "@id": `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: pageTitle,
  description,
  isPartOf: { "@id": `${siteUrl.replace(/\/$/, "")}#website` }
};
const seoGraph = disableSeoGraph || stagingLike ? null : {
  "@context": "https://schema.org",
  "@graph": [organizationNode, websiteNode, pageNode, ...(breadcrumbSchema ? [withoutContext(breadcrumbSchema)] : []), ...schemas.map(withoutContext)]
};
const currentPath = Astro.url.pathname;
const reviewDirective = getAdsenseReviewDirective(Astro.url, adsenseReviewMode.enabled, adsenseReviewQualityOverride);
const effectiveNoindex = noindex || reviewDirective.noindex;
const robotsValue = stagingLike
  ? stagingRobotsDirective()
  : effectiveNoindex
    ? "noindex,follow"
    : robots.includes("max-image-preview")
      ? robots
      : `${robots},max-image-preview:large`;

const gtmBootstrap = gtmOk
  ? `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`
  : "";
const ga4Bootstrap = ga4Ok && !gtmOk
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4Id}');`
  : "";
const metaBootstrap = metaEnabled
  ? `!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${metaPixelId}');fbq('track','PageView');`
  : "";
---
<!doctype html>
<html lang={seo.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsValue} />
    <meta name="generator" content={Astro.generator} />
    {!stagingLike && googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {!stagingLike && bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <link rel="icon" type="image/svg+xml" href={BRAND_ASSETS.faviconSvg} />
    <link rel="icon" type="image/png" sizes="32x32" href={BRAND_ASSETS.favicon32} />
    <link rel="icon" type="image/png" sizes="16x16" href={BRAND_ASSETS.favicon16} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="shortcut icon" href={identity.faviconUrl ?? BRAND_ASSETS.faviconIco} />
    <link rel="apple-touch-icon" href={identity.appleTouchIconUrl ?? BRAND_ASSETS.appleTouchIcon} />
    <link rel="manifest" href="/api/brand-manifest.webmanifest" />
    <meta name="theme-color" content={identity.themeColor ?? seo.themeColor ?? BRAND_ASSETS.themeColor} />
    {!disableSeoGraph && !stagingLike && <link rel="canonical" href={canonicalUrl} />}
    <title>{pageTitle}</title>
    <style is:inline set:html={cssVariablesFromIdentity(identity, brand.palette)} />
    {Object.entries(og).map(([key, value]) => <meta property={key} content={value} />)}
    {publicOgImage && <meta property="og:image:alt" content={seo.defaultOgImageAlt} />}
    {Object.entries(twitter).map(([key, value]) => <meta name={key} content={value} />)}
    {seoGraph && <script is:inline type="application/ld+json" set:html={JSON.stringify(seoGraph)} />}
    {analyticsEnabled && gtmOk && <script is:inline set:html={gtmBootstrap} />}
    {analyticsEnabled && ga4Ok && !gtmOk && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />}
    {analyticsEnabled && ga4Ok && !gtmOk && <script is:inline set:html={ga4Bootstrap} />}
    {metaEnabled && <script is:inline set:html={metaBootstrap} />}
    {adsEnabled && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClientId}`} crossorigin="anonymous"></script>}
    {adsEnabled && integrations.adsenseAutoAds && (
      <script is:inline set:html={`(adsbygoogle=window.adsbygoogle||[]).push({google_ad_client:"${adsenseClientId}",enable_page_level_ads:true});`} />
    )}
  </head>
  <body>
    {analyticsEnabled && gtmOk && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        ></iframe>
      </noscript>
    )}
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2" href="#conteudo">Ir para o conteúdo</a>
    <SiteHeader identity={identity} currentPath={currentPath} />
    <main id="conteudo"><slot /></main>
    <SiteFooter identity={identity} />
    <CookieConsent initiallyHidden={!integrations.consentModeEnabled || Boolean(consentChoice)} />
  </body>
</html>
