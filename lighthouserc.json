{
  "ci": {
    "collect": { "startServerCommand": "npm run build --workspace=@es/web && node scripts/start-lhci.mjs", "startServerReadyPattern": "LHCI_READY", "startServerReadyTimeout": 60000, "url": ["http://127.0.0.1:4321/", "http://127.0.0.1:4321/vagas"], "numberOfRuns": 1 },
    "assert": { "assertions": { "categories:performance": ["warn", { "minScore": 0.85 }], "categories:accessibility": ["error", { "minScore": 0.9 }], "categories:best-practices": ["error", { "minScore": 0.9 }], "categories:seo": ["error", { "minScore": 0.9 }], "errors-in-console": "error", "unminified-css": "error", "unminified-javascript": "error", "uses-text-compression": "warn" } },
    "upload": { "target": "temporary-public-storage" }
  }
}
