# syntax=docker/dockerfile:1
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/seo/package.json packages/seo/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/social/package.json packages/social/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN npm ci --legacy-peer-deps --no-audit --no-fund

FROM deps AS build
COPY tsconfig.base.json ./
COPY apps/web apps/web
RUN npm run build --workspace=@es/web

FROM node:22-alpine AS runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4321
WORKDIR /app
RUN addgroup -S app -g 1001 && adduser -S app -u 1001 -G app
COPY --from=build --chown=app:app /app/apps/web/dist ./dist
COPY --from=deps --chown=app:app /app/node_modules ./node_modules
USER app
EXPOSE 4321
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD wget -qO- http://127.0.0.1:4321/api/health || exit 1
CMD ["node", "dist/server/entry.mjs"]
