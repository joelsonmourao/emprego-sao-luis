# syntax=docker/dockerfile:1
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/seo/package.json packages/seo/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/social/package.json packages/social/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN npm ci --legacy-peer-deps --no-audit --no-fund

FROM deps AS build
COPY tsconfig.base.json ./
COPY apps/web apps/web
COPY packages packages
RUN npm run build --workspace=@es/web

# Runtime deps only — shrinks the exported image vs full install+dev tree.
FROM deps AS prod-deps
RUN npm prune --omit=dev --legacy-peer-deps

FROM node:22-alpine AS runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4321 UPLOADS_DIR=/app/data TZ=America/Sao_Paulo APP_TIME_ZONE=America/Sao_Paulo
WORKDIR /app
RUN apk add --no-cache tzdata \
 && addgroup -S app -g 1001 && adduser -S app -u 1001 -G app
RUN mkdir -p /app/data/imports /app/data/media /app/data/brand /app/data/reports /app/data/temp /app/data/receipts \
 && chown -R app:app /app/data

# CRITICAL: do NOT COPY --chown on node_modules/packages/dist.
# Coolify often fails at "exporting layers" (exit 255) when BuildKit rewrites
# ownership across ~1–2GB of node_modules during image export.
COPY --from=build /app/apps/web/dist ./dist
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY package.json package.json

# Coolify Terminal editorial scripts (small; chown OK)
COPY --chown=app:app scripts/activate-sl-local-editorial.mjs \
  scripts/rewrite-sl-local-editorial-bodies.mjs \
  scripts/rewrite-job-board-links-in-articles.mjs \
  scripts/persist-adsense-quality-guides.mjs \
  scripts/
COPY --chown=app:app scripts/data/sl-local-editorial-catalog.mjs \
  scripts/data/sl-local-article-html.mjs \
  scripts/data/sl-local-tip-followups-46-105.mjs \
  scripts/data/adsense-quality-guides.mjs \
  scripts/data/adsense-quality-bodies.mjs \
  scripts/data/
COPY --chown=app:app apps/web/public/covers/sl-local/credits.json apps/web/public/covers/sl-local/credits.json
COPY --chown=app:app apps/web/public/covers/adsense-quality apps/web/public/covers/adsense-quality

# Readable by non-root; writable only where the app needs it.
RUN chmod -R a+rX /app/dist /app/node_modules /app/packages /app/scripts \
 && chown -R app:app /app/dist

USER app
EXPOSE 4321
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD wget -qO- http://127.0.0.1:4321/api/health || exit 1
CMD ["node", "dist/server/entry.mjs"]
