# syntax=docker/dockerfile:1
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/seo/package.json packages/seo/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/social/package.json packages/social/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN npm ci --legacy-peer-deps --no-audit --no-fund

FROM deps AS build
COPY tsconfig.base.json ./
COPY apps/web apps/web
COPY packages packages
RUN npm run build --workspace=@es/web

FROM node:22-alpine AS runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4321 UPLOADS_DIR=/app/data TZ=America/Sao_Paulo APP_TIME_ZONE=America/Sao_Paulo
WORKDIR /app
RUN apk add --no-cache tzdata \
 && addgroup -S app -g 1001 && adduser -S app -u 1001 -G app
RUN mkdir -p /app/data/imports /app/data/media /app/data/brand /app/data/reports /app/data/temp /app/data/receipts \
 && chown -R app:app /app/data
COPY --from=build --chown=app:app /app/apps/web/dist ./dist
COPY --from=deps --chown=app:app /app/node_modules ./node_modules
COPY --from=build --chown=app:app /app/packages ./packages
# Minimal package.json so Coolify Terminal can run named npm scripts (not a full monorepo install).
COPY --chown=app:app package.json package.json
# One-shot editorial activate (Coolify Terminal do web)
COPY --chown=app:app scripts/activate-sl-local-editorial.mjs scripts/activate-sl-local-editorial.mjs
COPY --chown=app:app scripts/rewrite-sl-local-editorial-bodies.mjs scripts/rewrite-sl-local-editorial-bodies.mjs
COPY --chown=app:app scripts/rewrite-job-board-links-in-articles.mjs scripts/rewrite-job-board-links-in-articles.mjs
COPY --chown=app:app scripts/persist-adsense-quality-guides.mjs scripts/persist-adsense-quality-guides.mjs
COPY --chown=app:app scripts/data/sl-local-editorial-catalog.mjs scripts/data/sl-local-editorial-catalog.mjs
COPY --chown=app:app scripts/data/sl-local-article-html.mjs scripts/data/sl-local-article-html.mjs
COPY --chown=app:app scripts/data/sl-local-tip-followups-46-105.mjs scripts/data/sl-local-tip-followups-46-105.mjs
COPY --chown=app:app scripts/data/adsense-quality-guides.mjs scripts/data/adsense-quality-guides.mjs
COPY --chown=app:app scripts/data/adsense-quality-bodies.mjs scripts/data/adsense-quality-bodies.mjs
COPY --chown=app:app apps/web/public/covers/sl-local/credits.json apps/web/public/covers/sl-local/credits.json
COPY --chown=app:app apps/web/public/covers/adsense-quality apps/web/public/covers/adsense-quality
USER app
EXPOSE 4321
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD wget -qO- http://127.0.0.1:4321/api/health || exit 1
CMD ["node", "dist/server/entry.mjs"]
