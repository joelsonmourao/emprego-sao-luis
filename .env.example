# Banco deste projeto no PostgreSQL compartilhado do servidor (banco: emprego_sao_luis)
DATABASE_URL=""
# Em dev local pode ser igual ao DATABASE_URL. Em produção com pooler, use URL direta aqui.
DATABASE_URL_DIRECT=""

# URL canônica de produção
SITE_URL="https://empregossaoluis.com.br"
COMMERCIAL_CONTACT_URL=""
NEXT_PUBLIC_SITE_URL="https://empregossaoluis.com.br"
NEXT_PUBLIC_SITE_NAME="Emprego São Luís"

# Autenticação do painel /admin
AUTH_SECRET="troque-esta-chave-por-uma-segura-com-pelo-menos-32-caracteres"
ADMIN_LOGIN_USER="seu-email-admin@empregossaoluis.com.br"
# Gere com: node -e "const b=require('bcryptjs'); console.log(b.hashSync('SUA_SENHA_FORTE',10))"
ADMIN_SECRET_KEY="defina-uma-senha-admin-forte"

# AdSense — configure somente após aprovação
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
PUBLIC_ADSENSE_ENABLED="false"
PUBLIC_ADSENSE_CLIENT_ID=""
PUBLIC_ADSENSE_PUBLISHER_ID=""

# Opcional
APP_TIME_ZONE="America/Sao_Paulo"
CRON_SECRET="defina-um-token-secreto-para-cron"

# Nova arquitetura Astro/worker
REDIS_URL="redis://localhost:6379"
WORKER_IMPORT_CONCURRENCY="2"
WORKER_NOTIFICATION_CONCURRENCY="5"
WORKER_SOCIAL_CONCURRENCY="2"
WEB_PORT="4321"
LOG_LEVEL="info"
APP_ENV="development"
SENTRY_TRACES_SAMPLE_RATE="0.1"

# Armazenamento S3/R2
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="false"

# E-mail, observabilidade e proteção
RESEND_API_KEY=""
EMAIL_FROM=""
PUBLIC_WHATSAPP_CHANNEL_URL=""
SENTRY_DSN=""
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Integrações oficiais
GOOGLE_INDEXING_ENABLED="false"
GOOGLE_INDEXING_PROJECT_ID=""
GOOGLE_INDEXING_CLIENT_EMAIL=""
GOOGLE_INDEXING_PRIVATE_KEY=""
GOOGLE_PLACES_API_KEY=""
INDEXNOW_KEY=""
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""
META_INSTAGRAM_ACCOUNT_ID=""

# Bootstrap único do painel Astro; remova a senha do Coolify após executar o seed
