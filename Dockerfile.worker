# syntax=docker/dockerfile:1
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/seo/package.json packages/seo/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/social/package.json packages/social/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN npm ci --legacy-peer-deps --no-audit --no-fund

FROM deps AS build
COPY tsconfig.base.json ./
COPY apps/worker apps/worker
COPY packages packages
RUN npx tsc -p packages/db/tsconfig.json --outDir packages/db/dist \
 && npx tsc -p packages/shared/tsconfig.json --outDir packages/shared/dist \
 && npx tsc -p packages/social/tsconfig.json --outDir packages/social/dist \
 && npx tsc -p packages/storage/tsconfig.json --outDir packages/storage/dist \
 && npm run build --workspace=@es/worker \
 && node apps/worker/scripts/prepare-runtime.mjs \
 && WORKER_SMOKE_TEST=true node apps/worker/dist/index.js

FROM node:22-alpine AS runtime
ENV NODE_ENV=production UPLOADS_DIR=/app/data
WORKDIR /app
RUN addgroup -S app -g 1001 && adduser -S app -u 1001 -G app
RUN mkdir -p /app/data/imports /app/data/media /app/data/brand /app/data/reports /app/data/temp /app/data/receipts \
 && chown -R app:app /app/data
COPY --from=build --chown=app:app /app/apps/worker/dist ./dist
COPY --from=deps --chown=app:app /app/node_modules ./node_modules
COPY --from=build --chown=app:app /app/packages ./packages
USER app
CMD ["node", "dist/index.js"]
